<Project Sdk="Microsoft.NET.Sdk">

  <!--
    更新器（批次 UG-2）：唯一一件它存在理由的活，是把一棵"逐颗对过账的新树"换进正在运行的程序脚下那块地。
    它必须在<b>安装目录之外</b>跑（启动它那一侧负责把它复制出去，见 <c>UpdaterLauncher</c>），
    否则它一动手就要挪走自己站着的那棵树——那种坏不是失败得难看，是做成一半。

    OutputType 用 WinExe 而不是 Exe：它不该在用户屏幕上闪出一个黑框。
    它的输出只有两处：日志（<c>%LOCALAPPDATA%\StarMark\logs</c>）与退出码（<c>UpdaterContract.ExitCodeFor</c>）。

    为什么工程里几乎不放逻辑：真正要判的东西全部在 <c>StarMark.Core</c> 的 <c>UpdaterEngine</c> 里，
    因为只有那一层能被单元测试跑到（测试工程不引用可执行工程）。这颗 exe 是它的一个壳。
    <c>TheUpdaterStaysAThinShell</c> 那条闸门钉的就是"壳里不许长逻辑"。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>StarMark.Updater</RootNamespace>
    <AssemblyName>StarMark.Updater</AssemblyName>
    <StartupObject>StarMark.Updater.Program</StartupObject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarMark.Core\StarMark.Core.csproj" />
    <ProjectReference Include="..\StarMark.Abstractions\StarMark.Abstractions.csproj" />
  </ItemGroup>

</Project>
