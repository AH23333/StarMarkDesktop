<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- WinAppSDK 不支持 AnyCPU。第一行那种"归一化"在**平台被 VS/命令行当全局属性传进来时是失效的**
         （MSBuild 里项目体改不动全局属性），所以光有它，VS 选到 Any CPU 仍只会得到一句天书般的
         "WindowsAppSDKSelfContained requires a supported Windows architecture."。
         第二行走的是那道闸门认的另一个入口（AnyCPU 时它改看 RuntimeIdentifier），于是 Any CPU 也照样出
         x64 的可运行产物，不用用户去切配置管理器。正常 x64 构建不受影响（条件根本不成立）。
         这条兜底由 BuildConfigGateTests 钉着（删掉它，-p:Platform=AnyCPU 就复现那句天书错误）。 -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <RuntimeIdentifier Condition="('$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU') and '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>StarMark.UI</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageSchemaVersion>8.0</WindowsPackageSchemaVersion>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- §21 性能提取（2026-09-26 修订落地）：R2R 在 **publish** 时预编译本机代码（启动 JIT 时间 -30~50%），
         日常 dotnet build 开发环不受它拖累（只有发布那一发变慢）。
         同批三条刻意不做/缓做，理由见《组件功能扩展实现详解》§21：
         TieredPGO——.NET 8+ 默认开启，写了是 no-op；
         ServerGC——2026-09-29 已按 A/B 真机实测定案：不开（四份样本，工作集差异 <1%、CPU 测不出差异、
                    唯一可复现的代价是私有承诺量 +5MB 与线程数 +12~14，而收益那一维 GC 停顿本机测不到；
                    数据与"理由不是内存付不起"这条更正见《组件功能扩展实现详解》§21.3，P-127 已结案）。
         InvariantGlobalization——待 XAML 本地化日期/数字格式专项验证，通过后再开。 -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarMark.Core\StarMark.Core.csproj" />
    <ProjectReference Include="..\StarMark.Integrations\StarMark.Integrations.csproj" />
    <ProjectReference Include="..\StarMark.Data\StarMark.Data.csproj" />
    <ProjectReference Include="..\StarMark.Abstractions\StarMark.Abstractions.csproj" />
  </ItemGroup>

</Project>
