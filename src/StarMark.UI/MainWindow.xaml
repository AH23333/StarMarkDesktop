<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarMark.UI"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:i18n="using:StarMark.UI.Helpers"
    Title="StarMark">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="16,8,150,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="★" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="StarMark" Style="{StaticResource TitleText}" FontSize="16"/>
                </StackPanel>

                <!-- 状态指示器 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" i18n:LocText.Key="top.indexReady"/>
                </StackPanel>

                <StackPanel x:Name="TopBarButtons" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="SyncButton" Style="{StaticResource SecondaryButton}" Click="SyncButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="SyncProgress" Width="12" Height="12" IsActive="False" Visibility="Collapsed"/>
                            <TextBlock i18n:LocText.Key="top.sync"/>
                        </StackPanel>
                    </Button>
                    <!-- 同步中途原先唯一的出路是"等它跑完或杀进程"（入口硬传 CancellationToken.None，
                         大账号/慢网下要几十秒到几分钟）。只在同步中出现的取消键（P-55）。 -->
                    <Button x:Name="SyncCancelButton" Style="{StaticResource SecondaryButton}" i18n:LocText.Key="top.syncCancel"
                            Click="SyncCancelButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="ThemeButton" Style="{StaticResource SecondaryButton}" Click="ThemeButton_Click">
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE895;" FontSize="14"/>
                    </Button>
                    <Button x:Name="WidgetsButton" Style="{StaticResource SecondaryButton}"
                            i18n:LocText.ToolTipKey="top.widgetsTip" Click="WidgetsButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    </Button>
                    <!-- 「？」说的是**当前这一页**（批次 VC-3）。刻意做成顶栏一颗而不是每页塞一颗：
                         页面切换只有一处状态（ViewModel.CurrentPageTag），九页各塞一颗就是九处接线，
                         漏一页的表现是"那一页没有说明"——而浮层内容在打开那一刻现取，永远不会说错页。
                         文字版全貌在设置「使用说明」栏，那颗按钮也在这里。 -->
                    <Button x:Name="GuideButton" Style="{StaticResource SecondaryButton}" Content="？"
                            i18n:LocText.ToolTipKey="top.guideTip">
                        <Button.Flyout>
                            <Flyout x:Name="GuideFlyout" Opening="GuideFlyout_Opening">
                                <StackPanel x:Name="GuidePanel" Width="380" Spacing="6"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SecondaryButton}" Content="⚙" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索框 -->
        <Border Grid.Row="1" Padding="16,10,16,4">
            <TextBox x:Name="SearchBox"
                     i18n:LocText.PlaceholderKey="search.placeholder"
                     CornerRadius="8"
                     Padding="12,9"
                     FontSize="14"
                     TextChanging="SearchBox_TextChanging"
                     KeyDown="SearchBox_KeyDown"/>
        </Border>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,6,16,2" Spacing="8" VerticalAlignment="Center">
            <!-- 排序档位：措辞住在表里，身份（recent／starred／…）住在 SortOptions 那一份清单里。
                 ⛔ 不在这里列 <ComboBoxItem>：闭着的那一格显示的是选中那一刻从 Content 抄走的快照，
                 换语言时它不会跟着改口（批次 WI-2c 治的就是这一处）。 -->
            <ComboBox x:Name="SortCombo" MinWidth="90" SelectedIndex="0"
                      SelectionChanged="SortCombo_SelectionChanged"
                      ItemsSource="{x:Bind SortOptions, Mode=OneTime}"
                      ItemTemplate="{StaticResource LocOptionTemplate}"/>

            <!-- 来源分段控件（唯一一处，全局生效） -->
            <Border x:Name="SourceGroup"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SourceAll" i18n:LocText.Key="source.all" Click="SourceFilter_Click" Tag="all"
                            i18n:LocText.ToolTipKey="source.allTip"
                            Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button x:Name="SourceStar" Content="⭐" Click="SourceFilter_Click" Tag="star"
                            i18n:LocText.ToolTipKey="source.starTip"
                            Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button x:Name="SourceBookmark" Content="🔖" Click="SourceFilter_Click" Tag="bookmark"
                            i18n:LocText.ToolTipKey="source.bookmarkTip"
                            Background="Transparent" BorderThickness="0" Padding="10,4"/>
                    <Button x:Name="SourceFile" Content="📁" Click="SourceFilter_Click" Tag="file"
                            i18n:LocText.ToolTipKey="source.fileTip"
                            Background="Transparent" BorderThickness="0" Padding="10,4"/>
                </StackPanel>
            </Border>

            <!-- 类型多选：只给本地文件用，翻成 Everything 检索式（不进搜索框，见 FileKindQuery） -->
            <!-- 这颗按钮的字面<b>只有 MainWindow.Search.cs 一个主人</b>：它随"选中了几个类型"变
                 （"类型筛选 · N"），标记上挂静态键＝换语言那一刻把带值的句子盖回光杆那句（#295）。 -->
            <Button x:Name="FileKindButton" FontSize="12" Padding="8,4"
                    i18n:LocText.ToolTipKey="kind.buttonTip">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="4" MinWidth="176">
                            <TextBlock i18n:LocText.Key="kind.fileTypes" FontWeight="SemiBold"/>
                            <StackPanel x:Name="FileKindPanel" Spacing="0">
                                <CheckBox i18n:LocText.Key="kind.folder" Tag="Folder" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                                <CheckBox i18n:LocText.Key="kind.document" Tag="Document" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                                <CheckBox i18n:LocText.Key="kind.picture" Tag="Picture" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                                <CheckBox i18n:LocText.Key="kind.music" Tag="Music" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                                <CheckBox i18n:LocText.Key="kind.video" Tag="Video" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                                <CheckBox i18n:LocText.Key="kind.archive" Tag="Archive" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                            </StackPanel>
                            <TextBlock i18n:LocText.Key="kind.conditions" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <StackPanel x:Name="FileCondPanel" Spacing="0">
                                <CheckBox i18n:LocText.Key="kind.large" Tag="Large" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                                <CheckBox i18n:LocText.Key="kind.recent" Tag="Recent" FontSize="13"
                                          Checked="FileKind_Changed" Unchecked="FileKind_Changed"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                       i18n:LocText.Key="kind.noteScope"
                                       TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                       i18n:LocText.Key="kind.noteSyntax"
                                       TextWrapping="Wrap"/>
                            <Button i18n:LocText.Key="kind.clear" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Click="FileKind_Clear_Click"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- 语言筛选：常态显示（对齐扩展工具栏），选项由搜索页结果聚合；全部 = 不过滤。
                 「数据项＋模板」（批次 WI-38）：闭着的那一格显示的是选中那一刻抄走的快照，
                 只有格子里那颗 TextBlock 自己带键，换语言才轮得到它重贴（坑表 #272／#275）。 -->
            <ComboBox x:Name="LanguageCombo" MinWidth="116" FontSize="12"
                      i18n:LocText.PlaceholderKey="searchLang.placeholder"
                      i18n:LocText.ToolTipKey="searchLang.tip"
                      ItemTemplate="{StaticResource LocOptionTemplate}"
                      SelectionChanged="LanguageCombo_SelectionChanged"/>

            <CheckBox x:Name="ShowHiddenCheck" i18n:LocText.Key="top.showHidden" Click="ShowHidden_Click" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 全局通知栏 -->
        <InfoBar x:Name="SyncInfoBar" Grid.Row="3"
                 IsOpen="False" IsClosable="True"
                 Margin="16,4,16,4"
                 CornerRadius="8"
                 CloseButtonClick="InfoBar_Close"/>

        <!-- 页面导航。ContentFrame 已移出 NavigationView：
             搜索态需要整条折叠（Visibility=Collapsed），若 Frame 仍是 NavView 的 Content，
             折叠后顶部会空出一截。现在 NavView 独占一行（Auto），折叠时该行塌缩为 0，
             内容区自然上移填满 —— 对应浏览器扩展「搜索时用 toolbar 整行替换 tabs」。 -->
        <NavigationView x:Name="NavView" Grid.Row="4" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavTreeItem" i18n:LocText.Key="nav.tree" Tag="tree">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE838;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavTagsItem" i18n:LocText.Key="nav.tags" Tag="tags">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavActivityItem" i18n:LocText.Key="nav.activity" Tag="activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHiddenItem" i18n:LocText.Key="nav.hidden" Tag="hidden">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B3;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSnapshotItem" i18n:LocText.Key="nav.snapshot" Tag="snapshot">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 剪贴板历史（默认关；关着时页面自己说明"去设置开启"，不藏入口——藏了等于用户找不到） -->
                <NavigationViewItem x:Name="NavClipboardItem" i18n:LocText.Key="nav.clipboard" Tag="clipboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8CB;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                    GitHub 热榜（默认关）。**关着时这一项整个不显示**——与上面剪贴板"入口常驻"刻意相反：
                    热榜是用户主动开启的可选浏览面，留一个点进去只会说"未开启"的项更像故障。
                    可见性在 MainWindow.ApplyTrendingNavVisibility 里按设置即时开关（不需要重启）。
                -->
                <NavigationViewItem x:Name="NavTrendingItem" i18n:LocText.Key="nav.trending" Tag="trending">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                    RSS 订阅：总开关关着时这一项整个不显示（与热榜同一口径——可选的浏览面留一个点进去
                    只会说"未开启"的项，更像故障）。开关从没表过态时按"有没有启用的源"决定，判据在 RssActivation。
                    图标用 E8A1（一张带文字行的卡片）：这个码位在 Segoe Fluent Icons 与 Segoe MDL2 Assets
                    里都实测存在且形状一致（两套字体分别渲染比对过）——缺字会显示成方块，而方块没有任何断言能抓到。
                -->
                <NavigationViewItem x:Name="NavRssItem" i18n:LocText.Key="nav.rss" Tag="rss">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <Frame x:Name="ContentFrame" Grid.Row="5"/>
    </Grid>
</Window>