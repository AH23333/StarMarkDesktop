<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="StarMark.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarMark.UI"
    xmlns:helpers="using:StarMark.UI.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/StarMarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <helpers:InverseBoolConverter x:Key="InverseBool"/>
            <helpers:ContainedTagColorConverter x:Key="ContainedTagColor"/>
            <helpers:TagSelectedBrushConverter x:Key="TagSelected"/>

            <!-- 右键菜单 / 下拉浮 alte一层：统一采用半透明 acrylic 背景，
                 让 MenuFlyout 弹层与窗口材质（亚克力 / 云母）观感一致，而不是一块不透明实色。
                 注意 MenuFlyout 由独立弹出层承载，拿不到主窗口的 SystemBackdrop，
                 故这里用同一套亚克力画笔模拟而非真正的窗口材质。 -->
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
