<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="StarMark.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarMark.UI"
    xmlns:helpers="using:StarMark.UI.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/StarMarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <helpers:InverseBoolConverter x:Key="InverseBool"/>
            <helpers:ContainedTagColorConverter x:Key="ContainedTagColor"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
