<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        全局样式（中性）：只保留结构化样式（字号 / 间距 / 圆角 / 卡片），
        所有颜色一律使用 WinUI 3 默认主题资源（TextFillColorPrimaryBrush、
        CardBackgroundFillColorDefaultBrush 等），随系统深浅色自动切换，
        与成熟的 Windows 桌面应用观感一致。
    -->

    <!-- 字体栈 -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, PingFang SC, Microsoft YaHei</FontFamily>

    <!-- 文本样式 -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- 卡片：WinUI 默认卡片色 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 普通按钮：仅调整尺寸，颜色由默认模板提供 -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- 图标小按钮（卡片操作栏用） -->
    <Style x:Key="MiniIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

</ResourceDictionary>