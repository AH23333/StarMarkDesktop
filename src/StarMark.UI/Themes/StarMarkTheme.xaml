<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        全局样式（中性）：只保留结构化样式（字号 / 间距 / 圆角 / 卡片），
        所有颜色一律使用 WinUI 3 默认主题资源（TextFillColorPrimaryBrush、
        CardBackgroundFillColorDefaultBrush 等），随系统深浅色自动切换，
        与成熟的 Windows 桌面应用观感一致。
    -->

    <!--
        代码侧主题画笔调色板：应用级 RequestedTheme 启动后冻结，运行期切主题只改窗口根
        元素，代码里 Application.Current.Resources[key] 会解析出错误的（深色）画笔。
        这里提供显式 Light/Default 双主题画笔，供 Helpers/ThemeBrush 按 ActualTheme 解析，
        XAML 中也可用 {ThemeResource AppXxx} 引用。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1A0067C0"/>
            <SolidColorBrush x:Key="AppMutedBrush" Color="#5C000000"/>
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F7B0F"/>
            <SolidColorBrush x:Key="AppCautionBrush" Color="#9D5D00"/>
            <!-- 桌面组件窗口（WidgetWindow）专用画笔 -->
            <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#D9FAFAFA"/>
            <SolidColorBrush x:Key="WidgetChromeBrush" Color="#0F000000"/>
            <SolidColorBrush x:Key="WidgetBorderBrush" Color="#29000000"/>
            <SolidColorBrush x:Key="WidgetDropHintBrush" Color="#330067C0"/>
            <SolidColorBrush x:Key="WidgetSubtleFillBrush" Color="#0F000000"/>
            <SolidColorBrush x:Key="WidgetDividerBrush" Color="#14000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppAccentBrush" Color="#4CC2FF"/>
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#2E4CC2FF"/>
            <SolidColorBrush x:Key="AppMutedBrush" Color="#FFFFFFC5"/>
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB5F"/>
            <SolidColorBrush x:Key="AppCautionBrush" Color="#FCE100"/>
            <!-- 桌面组件窗口（WidgetWindow）专用画笔 -->
            <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#D92B2B2B"/>
            <SolidColorBrush x:Key="WidgetChromeBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="WidgetBorderBrush" Color="#29FFFFFF"/>
            <SolidColorBrush x:Key="WidgetDropHintBrush" Color="#334CC2FF"/>
            <SolidColorBrush x:Key="WidgetSubtleFillBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="WidgetDividerBrush" Color="#14FFFFFF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 字体栈 -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, PingFang SC, Microsoft YaHei</FontFamily>

    <!-- 桌面组件标题栏按钮 -->
    <Style x:Key="WidgetChromeButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- 文本样式 -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- 卡片：WinUI 默认卡片色 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 普通按钮：仅调整尺寸，颜色由默认模板提供 -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- 图标小按钮（卡片操作栏用） -->
    <Style x:Key="MiniIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

</ResourceDictionary>