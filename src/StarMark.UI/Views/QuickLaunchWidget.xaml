<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.QuickLaunchWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels">

    <StackPanel Padding="12,8,12,12" Spacing="6">
        <!-- 置顶条目（来自 StarMark 数据库 Pinned=1） -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
            <TextBlock Text="置顶条目" FontSize="11" FontWeight="SemiBold"
                       Opacity="0.7" VerticalAlignment="Center"/>
            <Button Content="🔄" FontSize="10" Padding="6,1,6,1"
                    Background="Transparent" BorderThickness="0" Margin="8,0,0,0"
                    Click="RefreshPinned_Click"/>
        </StackPanel>
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pinned, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickLaunchPinned">
                    <!-- 注意：ItemsRepeater 内部必须用 x:Bind（不能用 {Binding}），否则不报错但静默失效 -->
                    <Button Margin="0,1,0,1" HorizontalContentAlignment="Left"
                            Padding="6,4,6,4" Background="{ThemeResource WidgetSubtleFillBrush}"
                            BorderThickness="0" CornerRadius="4"
                            Click="PinnedOpen_Click" Tag="{x:Bind Uri}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Emoji}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Title}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource WidgetDividerBrush}"/>

        <!-- 用户自定义快捷入口 -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
            <TextBlock Text="快捷入口" FontSize="11" FontWeight="SemiBold"
                       Opacity="0.7" VerticalAlignment="Center"/>
            <Button Content="＋" FontSize="10" Padding="6,1,6,1"
                    Background="Transparent" BorderThickness="0" Margin="8,0,0,0"
                    Click="ToggleAddForm_Click"/>
        </StackPanel>
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickLaunchLink">
                    <Grid Margin="0,1,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button HorizontalContentAlignment="Left" Padding="6,4,6,4"
                                Background="{ThemeResource WidgetSubtleFillBrush}"
                                BorderThickness="0" CornerRadius="4"
                                Click="LinkOpen_Click" Tag="{x:Bind Uri}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔗" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Title}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Content="✕" FontSize="9" Padding="5,4,5,4"
                                Background="Transparent" BorderThickness="0"
                                Click="LinkRemove_Click" Tag="{x:Bind Uri}"/>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <StackPanel x:Name="AddForm" Spacing="4" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBox x:Name="AddNameBox" PlaceholderText="名称（可留空）" FontSize="11" Padding="6,4,6,4"/>
            <TextBox x:Name="AddUriBox" PlaceholderText="网址 / 文件路径（粘贴后回车）"
                     FontSize="11" Padding="6,4,6,4" KeyDown="AddUriBox_KeyDown"/>
            <Button Content="添加" HorizontalAlignment="Right" Padding="12,3,12,3"
                    Click="AddLinkSubmit_Click"/>
        </StackPanel>

        <TextBlock Text="提示：可把文件、文件夹或网址直接拖入本组件"
                   FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="2,4,0,0"/>
    </StackPanel>
</UserControl>
