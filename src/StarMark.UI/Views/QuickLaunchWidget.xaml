<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.QuickLaunchWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:vm="using:StarMark.UI.ViewModels"
    xmlns:local="using:StarMark.UI.Helpers">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 置顶 / 快捷入口共用：完整 ItemCard 能力（复用右键菜单/标签/预览/发送到桌面） -->
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:ItemCardViewModel">
            <controls:ItemCard Margin="0,1,0,1" ViewModel="{x:Bind}"
                               OpenRequested="Card_OpenRequested"
                               EditNoteRequested="Card_EditNoteRequested"
                               EditTagsRequested="Card_EditTagsRequested"
                               HideRequested="Card_HideRequested"
                               PinRequested="Card_PinRequested"
                               CopyLinkRequested="Card_CopyLinkRequested"
                               OpenLocationRequested="Card_OpenLocationRequested"
                               TagFilterRequested="Card_TagFilterRequested"
                               TagRemoveRequested="Card_TagRemoveRequested"
                               TagAddRequested="Card_TagAddRequested"/>
        </DataTemplate>
        <!-- 搜索结果：点击才开主窗（不在此打开 URI） -->
        <DataTemplate x:Key="SearchCardTemplate" x:DataType="vm:ItemCardViewModel">
            <controls:ItemCard Margin="0,1,0,1" ViewModel="{x:Bind}"
                               OpenRequested="Card_SearchOpenRequested"
                               EditNoteRequested="Card_EditNoteRequested"
                               EditTagsRequested="Card_EditTagsRequested"
                               HideRequested="Card_HideRequested"
                               PinRequested="Card_PinRequested"
                               CopyLinkRequested="Card_CopyLinkRequested"
                               OpenLocationRequested="Card_OpenLocationRequested"
                               TagFilterRequested="Card_TagFilterRequested"
                               TagRemoveRequested="Card_TagRemoveRequested"
                               TagAddRequested="Card_TagAddRequested"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="12,8,12,12" Spacing="6">
            <!-- 组件内搜索框（A-4：直搜展示前 12 条，点击结果才开主窗） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索全部条目…"
                         FontSize="12" Padding="8,5,8,5"
                         TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="1" Content="✕" FontSize="10" Padding="8,4,8,4"
                        Background="Transparent" BorderThickness="0" Margin="4,0,0,0"
                        ToolTipService.ToolTip="清空搜索" Click="SearchClear_Click"/>
            </Grid>

            <!-- 搜索结果（组件内直搜） -->
            <StackPanel Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="搜索结果（组件内，点击开主窗）" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.7" Margin="0,4,0,2"/>
                <ProgressBar IsIndeterminate="True"
                             Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                             Height="2" Margin="0,0,0,4"/>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                               ItemTemplate="{StaticResource SearchCardTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource WidgetDividerBrush}"
                    Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 置顶条目（来自 StarMark 数据库 Pinned=1，完整 ItemCard 能力） -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                <TextBlock Text="置顶条目" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.7" VerticalAlignment="Center"/>
                <Button Content="🔄" FontSize="10" Padding="6,1,6,1"
                        Background="Transparent" BorderThickness="0" Margin="8,0,0,0"
                        Click="RefreshPinned_Click"/>
            </StackPanel>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pinned, Mode=OneWay}"
                           ItemTemplate="{StaticResource CardTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource WidgetDividerBrush}"/>

            <!-- 用户自定义快捷入口（合成 Item + IsLauncherMode） -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                <TextBlock Text="快捷入口" FontSize="11" FontWeight="SemiBold"
                           Opacity="0.7" VerticalAlignment="Center"/>
                <Button Content="＋" FontSize="10" Padding="6,1,6,1"
                        Background="Transparent" BorderThickness="0" Margin="8,0,0,0"
                        Click="ToggleAddForm_Click"/>
            </StackPanel>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Links, Mode=OneWay}"
                           ItemTemplate="{StaticResource CardTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <StackPanel x:Name="AddForm" Spacing="4" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBox x:Name="AddNameBox" PlaceholderText="名称（可留空）" FontSize="11" Padding="6,4,6,4"/>
                <TextBox x:Name="AddUriBox" PlaceholderText="网址 / 文件路径（粘贴后回车）"
                         FontSize="11" Padding="6,4,6,4" KeyDown="AddUriBox_KeyDown"/>
                <Button Content="添加" HorizontalAlignment="Right" Padding="12,3,12,3"
                        Click="AddLinkSubmit_Click"/>
            </StackPanel>

            <TextBlock Text="提示：可把文件、文件夹或网址直接拖入本组件"
                       FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="2,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
