<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.TrendingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="Transparent" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- 页头：一句话讲清两个按钮的落点差别（远端 Star vs 本机收藏），右侧是周期 / 语言 / 刷新 / 停止 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="12,12,12,4">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="GitHub 热榜" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="点标题 = 在浏览器打开仓库。⭐ 改的是 GitHub 远端的 Star（需 Token），🔖 才是存进本机收藏；没点过这两个按钮的候选不进库、也搜不到。"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
            <ComboBox Grid.Column="1" x:Name="PeriodCombo" MinWidth="86" VerticalAlignment="Center"
                      ToolTipService.ToolTip="榜单周期（同一台机器上每个周期每天只抓一次，切回来不会重抓）"
                      SelectionChanged="Period_Changed">
                <ComboBoxItem Content="今日" Tag="daily"/>
                <ComboBoxItem Content="本周" Tag="weekly"/>
                <ComboBoxItem Content="本月" Tag="monthly"/>
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="LanguageCombo" MinWidth="120" VerticalAlignment="Center"
                      IsEditable="True" SelectionChanged="Language_Changed" LostFocus="Language_Committed"
                      ToolTipService.ToolTip="按语言筛选；下拉里是本机 star 过的语言，也可以直接手输任意语言（失焦即应用）"/>
            <Button Grid.Column="3" Content="刷新" VerticalAlignment="Center" Click="Refresh_Click"
                    ToolTipService.ToolTip="强制重抓本期（跳过“今天已抓过”的短路）"/>
            <Button Grid.Column="4" Content="停止" VerticalAlignment="Center" Click="Cancel_Click"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    ToolTipService.ToolTip="掐掉本次抓取，列表保持原样（取消不会被当成失败去走兜底）"/>
        </Grid>

        <!-- 状态行：来源标注 / stale / 动作结果都写在这一行，旁边给对应的下一步按钮 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="12,4,12,4">
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <Button Grid.Column="1" Content="重试" VerticalAlignment="Center" Click="Refresh_Click"
                    Visibility="{x:Bind ViewModel.Failed, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <!-- 没配 Token 时不藏提示也不禁按钮：给一句原因 + 一个真到设置里的入口（P-54 口径） -->
            <Button Grid.Column="2" Content="去设置里配 Token" VerticalAlignment="Center"
                    Click="GoSettings_Click"
                    Visibility="{x:Bind ViewModel.NeedsTokenHint, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- 页内筛选：这批数据不落库 ⇒ 统一搜索里没有它，所以筛选必须在这一页上给 -->
        <TextBox Grid.Row="2" x:Name="FilterBox" Margin="12,4,12,4"
                 PlaceholderText="在本期候选里筛选：仓库名 / 描述 / 语言（只筛这一页，不动主库）"
                 TextChanged="Filter_Changed"
                 Text="{x:Bind ViewModel.Filter, Mode=OneWay}"/>

        <ScrollViewer Grid.Row="3" Background="Transparent" Padding="12,4,12,8"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                        <controls:ItemCard ViewModel="{x:Bind}"
                                           OpenRequested="Card_OpenRequested"
                                           CopyLinkRequested="Card_CopyRequested"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 加载 / 空 / 失败：三态各给一句下一步，绝不留一屏空白让人猜是不是坏了 -->
        <ProgressRing Grid.Row="4" x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" Margin="0,0,0,12"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="12,0,12,20" Spacing="8"
                    Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"/>
            <Button Content="去设置里开启热榜" HorizontalAlignment="Center" Click="GoSettings_Click"
                    Visibility="{x:Bind ViewModel.Enabled, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
        </StackPanel>
    </Grid>
</Page>
