<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:local="using:StarMark.UI.Views"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:ContainedTagColorConverter x:Key="ContainedTagColor"/>
        <local:TagSelectedBrushConverter x:Key="TagSelBrush"/>
    </Page.Resources>

    <Grid Background="Transparent" Padding="12,12,12,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- 标签选择唯一入口在导航栏「标签」（写入 Main.GlobalTagFilters）。
                 本页不再提供重复的「标签筛选」按钮/选择区，仅以吸顶筛选条常驻展示已选标签。 -->

            <!-- 吸顶标签筛选条：当前生效的标签过滤常驻可见，可单个 ✕ 撤销或一键清空。
                 数据直接来自全局单一真源 Main.GlobalTagFilters（对齐扩展 .tag-banner）。
                 搜索在标签筛选结果之内执行（AND 语义）。 -->
            <Border x:Name="TagBanner"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="10,6" Margin="0,0,0,8"
                    Visibility="{x:Bind ViewModel.Main.HasGlobalTagFilters, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="标签筛选" FontSize="11" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Main.GlobalTagFilters, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TagFilterChip">
                                <Button Click="TagFilterChip_Click" Tag="{x:Bind Name}"
                                        Padding="8,2" CornerRadius="10" BorderThickness="0"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        ToolTipService.ToolTip="移除该标签筛选">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontSize="11"
                                                   Foreground="{x:Bind Name, Converter={StaticResource ContainedTagColor}}"/>
                                        <TextBlock Text="✕" FontSize="8" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button Click="ClearTagFilters_Click" Padding="8,2" FontSize="11"
                            ToolTipService.ToolTip="清除全部标签筛选">清除</Button>
                </StackPanel>
            </Border>
            <!-- 加载状态 -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                         Height="2" Margin="0,0,0,8"/>

            <!-- 语言筛选已上移至主窗口工具栏（常态显示，与 全部/star/书签 同排） -->

            <!-- 结果分段（P2-7）：精确匹配段在前，相关结果段在后，段内保持原排序 -->
            <TextBlock Text="{x:Bind ViewModel.ExactHeader, Mode=OneWay}" FontSize="12"
                       FontWeight="SemiBold" Opacity="0.75" Margin="2,2,0,6"
                       Visibility="{x:Bind ViewModel.HasExact, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <ItemsRepeater x:Name="ExactRepeater" ItemsSource="{x:Bind ViewModel.ExactResults, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                            <Grid>
                                <controls:ItemCard x:Name="Card" ViewModel="{x:Bind}"
                                                   OpenRequested="Card_OpenRequested"
                                                   EditNoteRequested="Card_EditNoteRequested"
                                                   EditTagsRequested="Card_EditTagsRequested"
                                                   HideRequested="Card_HideRequested"
                                                   PinRequested="Card_PinRequested"
                                                   CopyLinkRequested="Card_CopyLinkRequested"
                                                   OpenLocationRequested="Card_OpenLocationRequested"
                                                   TagFilterRequested="Card_TagFilterRequested"
                                                   TagRemoveRequested="Card_TagRemoveRequested"
                                                   TagAddRequested="Card_TagAddRequested"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

            <TextBlock Text="{x:Bind ViewModel.RelatedHeader, Mode=OneWay}" FontSize="12"
                       FontWeight="SemiBold" Opacity="0.75" Margin="2,10,0,6"
                       Visibility="{x:Bind ViewModel.HasRelated, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <ItemsRepeater x:Name="RelatedRepeater" ItemsSource="{x:Bind ViewModel.RelatedResults, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                            <Grid>
                                <controls:ItemCard x:Name="Card" ViewModel="{x:Bind}"
                                                   OpenRequested="Card_OpenRequested"
                                                   EditNoteRequested="Card_EditNoteRequested"
                                                   EditTagsRequested="Card_EditTagsRequested"
                                                   HideRequested="Card_HideRequested"
                                                   PinRequested="Card_PinRequested"
                                                   CopyLinkRequested="Card_CopyLinkRequested"
                                                   OpenLocationRequested="Card_OpenLocationRequested"
                                                   TagFilterRequested="Card_TagFilterRequested"
                                                   TagRemoveRequested="Card_TagRemoveRequested"
                                                   TagAddRequested="Card_TagAddRequested"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,40,0,16"
                           Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>