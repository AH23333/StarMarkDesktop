<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.WorldClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels">

    <StackPanel Padding="12,8,12,12" Spacing="6">
        <ComboBox x:Name="AddBox" PlaceholderText="＋ 添加时区…" FontSize="12"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  DisplayMemberPath="Name"
                  ItemsSource="{x:Bind ViewModel.AddableZones, Mode=OneWay}"
                  SelectionChanged="AddBox_SelectionChanged"/>

        <!-- 空态提示：文本为空时这个块只剩几像素行距，不值得为它再造一枚可见性转换器 -->
        <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" FontSize="11" Opacity="0.6"
                   TextWrapping="Wrap"/>

        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:WorldClockRow">
                    <Grid Padding="6,3,4,3" ColumnSpacing="8" Background="{ThemeResource WidgetSubtleFillBrush}"
                          CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- 时区在本机解析不出来时给原因（精简系统/手改配置）；平时这行是空的 -->
                            <TextBlock Text="{x:Bind Error, Mode=OneWay}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{x:Bind TimeText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind OffsetText, Mode=OneWay}" FontSize="9" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind DayTag, Mode=OneWay}" FontSize="9" Opacity="0.85"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="✕" FontSize="11" Padding="6,0,6,0"
                                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="移除这个点位"
                                Click="RemoveRow_Click" Tag="{x:Bind}"/>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
