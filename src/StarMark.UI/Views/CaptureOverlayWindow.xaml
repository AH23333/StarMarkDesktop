<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarMark.UI.Views">

    <!--
        截图遮罩：每块显示器一个本窗口的实例（每屏 DPI 可能不同，单窗跨屏只有一屏的坐标换算是对的）。
        画面不是"实时桌面"，而是按下热键那一瞬间抓好的那一帧的对应块 —— 所以遮罩盖上去之后
        底下的内容还在动，也不会让选区内容与最终截到的东西不一致（Snipaste 同一做法）。
        Background 用 #01000000 而不是 Transparent：完全透明的背景不参与命中测试，
        那样在还没框选的空白处按下鼠标会穿到桌面去，用户会觉得"第一下点不动"。
    -->
    <!-- 根元素用 CursorLayer（Grid 的子类）而不是 Grid：WinUI 3 只有 protected 的 ProtectedCursor，
         要按"这一按是画还是改框"换光标形状就必须子类化一个口子出来（见 CursorLayer.cs）。 -->
    <local:CursorLayer
        x:Name="Root"
        Background="#01000000"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased"
        RightTapped="Root_RightTapped"
        PointerWheelChanged="Root_PointerWheelChanged"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited"
        KeyDown="Root_KeyDown">

        <Image x:Name="Shot" Stretch="Fill" IsHitTestVisible="False"/>

        <!--
            选区与四周压暗都在这一层 Canvas 里：Canvas 才会按坐标摆子元素，
            且整层不吃命中测试（鼠标事件始终归 Root，拖动不会被中途截走）。
            用"四块压暗"而不是"一层暗幕挖洞"：前者只需四次矩形定位，不需要裁剪几何，
            跨 DPI 与负原点时没什么可算错的。
        -->
        <!--
            标注层：摆在选区那块位置，显示的是 AnnotationPainter 真的画出来的那份像素
            （不是"界面另画一遍近似的样子"）——所见即所存，撤销/重画也只需要拿底图重烤一次。
            拖动中未松手的那一条由 LiveLayer 用简单图元近似显示，松手立刻换成真像素。
        -->
        <Canvas x:Name="AnnotateLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="AnnotateShot" Stretch="Fill"/>
            <Canvas x:Name="LiveLayer"/>
        </Canvas>

        <Canvas x:Name="DimLayer" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#66000000"/>
            <Rectangle x:Name="DimLeft" Fill="#66000000"/>
            <Rectangle x:Name="DimRight" Fill="#66000000"/>
            <Rectangle x:Name="DimBottom" Fill="#66000000"/>
            <Rectangle x:Name="SelRect" Stroke="#FF4CA0FF" StrokeThickness="2" Visibility="Collapsed"/>
        </Canvas>


        <!--
            文字标注就地输入：点一下就打字，Enter 换行（不再当"落笔"），Esc 结束编辑并保住已打的字；
            点已经写好的那行字会带着原文再开一次编辑。写满一行的宽度按屏幕收，不自动折行——
            折行只有编辑框看得见，画出去的成品是一整行，那就是两张图。
            <b>左上角对齐是必须的</b>：Grid 子元素默认 Stretch，只给 Margin 定位的话，
            这块底板会从"点击处"一路铺到屏幕右下角（真机反馈的"点击处到右下角的黄色矩形"），
            输入框本身也会跟着拉成一条巨大无比的东西。
            <b>底板刻意近乎透明、靠描边认边界</b>（真机反馈："点击后不应出现黄色矩形，最好是透明但描边的边框"）：
            一块实色黄底会把要看的那片画面整个盖掉。描边用当前选的字色，在深浅底上都看得出来；
            留一成暗底只是为了字在半透明图上还读得清，不是把这块做成色块。
        -->
        <Border
            x:Name="TextEditorHost"
            Background="#1A000000"
            BorderBrush="#FFFFFFFF"
            BorderThickness="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <TextBox
                x:Name="TextEditor"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Left"
                MinWidth="180"
                AcceptsReturn="True"
                FontFamily="Microsoft YaHei UI"
                KeyDown="TextEditor_KeyDown"/>
        </Border>

        <!--
            文字标注的 ✕（批次 PU，用户口径："编辑框右上角为X号，可以点击删除该文字编辑框"）。
            <b>不放进 AnnotateLayer</b>：那一整层不吃命中（事件全归 Root），放进里面这颗永远点不到。
            单独一层顶层元素，选中文字标注时由 DrawSelectionHandles 摆到包围盒右上角；
            图标用代码同款的矢量线段，不依赖字体字形。
        -->
        <Border
            x:Name="TextDeleteButton"
            Width="20"
            Height="20"
            Background="#DD202020"
            BorderBrush="#88FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Canvas Width="16" Height="16">
                <Line X1="4.8" Y1="4.8" X2="11.2" Y2="11.2" Stroke="#FFFFFFFF" StrokeThickness="1.6"/>
                <Line X1="11.2" Y1="4.8" X2="4.8" Y2="11.2" Stroke="#FFFFFFFF" StrokeThickness="1.6"/>
            </Canvas>
        </Border>

        <Border
            x:Name="SizeChip"
            Background="#DD1F1F1F"
            CornerRadius="4"
            Padding="6,2,6,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <TextBlock x:Name="SizeText" FontSize="11" Foreground="#FFFFFFFF"/>
        </Border>

        <!--
            贴图态的悬停高亮：鼠标进来时给四边一圈亮边，标出"这是一张贴图、当前归它管"；
            不吃命中（事件全归 Root），穿透时随工具条一起收起。
        -->
        <Rectangle
            x:Name="PinBorder"
            Stroke="#FF4CA0FF"
            StrokeThickness="1.5"
            IsHitTestVisible="False"
            Visibility="Collapsed"/>

        <!--
            一条窄窄的**纯图标**工具条（真机反馈：形状/颜色/粗细做成带文字的下拉，整条又高又占地方）。
            <para>
            这里连一个按钮都不写：<b>整条由代码按 <c>AnnotationTool</c> / <c>Annotation.Palette</c> /
            <c>Annotation.ThicknessSteps</c> 生成</b>，尺寸与配色也只在那一处定义。
            写在这里就是第二份事实——而"模型里有、条上没有"这类错只有跑起来才看得见。
            </para>
            <para>
            图标是代码画的矢量图元，<b>不用字体字形</b>：字形缺字会显示成方块，而遮罩一按 Esc 就没了，
            没人能靠眼睛把八个字形逐个确认一遍。名字与说明只挂在每颗按钮的 ToolTip 上。
            颜色与粗细收在"笔"那一颗点开的第二行里，当前用哪支笔、多粗，条上那颗点直接看得出来。
            </para>
            <para>
            <b>为什么条子里不再有"悬停说明"那一行</b>（用户裁决）：那一行原本是绕开
            "WinUI 3 把 ToolTip 钉在宿主窗边界内"（批次 WI）加的，可它一句话就有几百像素宽，
            而<b>条子那扇窗的宽度＝内容实测宽度</b>——悬停哪颗，整条就变宽、左边缘跟着往左跑，
            贴图态那颗"居中于画面"的条子来回跳。<b>宽度稳定比看得到解释重要</b>，所以删掉说明行，
            条子只剩按钮行＋选择栏行（选择栏永远比按钮行窄，撑不宽）。
            </para>
            <para>
            <b>为什么选择栏住在条子里，而不是 Flyout</b>（批次 WI 的真机结论，仍然成立）：贴图态整条
            住一扇自己那顶的小窗，而 WinUI 3 的弹出层被钉在宿主窗的边界内——那扇窗只有 33 像素高，
            "图形选择栏"用 Flyout 出来只剩半截。选择栏必须由条子自己排版、自己长高
            （那扇窗按实测尺寸跟着长，见 <c>ReflowBar</c>）。代价是贴图态悬停看不到 ToolTip——
            这是"宽度稳定"换来的取舍，不是漏了。
            </para>
        -->
        <Border
            x:Name="ActionBar"
            Background="#EE202020"
            CornerRadius="5"
            Padding="4,3,4,3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="BarRow" Grid.Row="0" Orientation="Horizontal" Spacing="2"/>
                <ContentPresenter x:Name="BarPicker" Grid.Row="1" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border
            x:Name="HintChip"
            Background="#CC202020"
            CornerRadius="6"
            Padding="10,5,10,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,24,0,0">
            <TextBlock
                x:Name="HintText"
                FontSize="12"
                Foreground="#FFFFFFFF"
                Text="拖动框选 · 点亮框的窗口＝选中（可继续改框）· 选一支笔就能画，可以画出框外；再点一次收笔、回来改框 · Enter 复制 · Esc 取消 · 右键不截"/>
        </Border>

        <!-- 失败原因就地显示：弹对话框会立刻把遮罩的焦点抢走（抢走就等于取消截图） -->
        <Border
            x:Name="ErrorChip"
            Background="#EE7A1F1F"
            CornerRadius="6"
            Padding="10,5,10,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFFFFFFF" TextWrapping="Wrap" MaxWidth="460"/>
        </Border>

        <!--
            选中某条标注后才现身的一句说明。放在这里而不是 ToolTip：把手怎么用法只有"正握着它的人"需要知道，
            而遮罩窗上悬停到一颗 6 像素的方块才看得到提示，等于没有提示（真机反复反馈"以为功能没做"）。
        -->
        <Border
            x:Name="SelectionTip"
            Background="#CC202020"
            CornerRadius="6"
            Padding="10,5,10,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            Visibility="Collapsed">
            <TextBlock
                FontSize="12"
                Foreground="#FFFFFFFF"
                Text="已选中：拖框内＝移动 · 拖角＝缩放 · 拖顶部圆点＝转方向 · 文字点住它＝接着改（Enter 换行） · Delete＝删除"/>
        </Border>

        <!-- Snipaste 式像素放大镜：放大 15×15 源像素，每像素 10 物理像素，自带像素网格与十字线；
             下方读数＝RGB 与屏幕坐标。位置由代码按光标摆放并自动翻边。 -->
        <Border x:Name="Magnifier" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#CC000000" BorderBrush="#66FFFFFF" BorderThickness="1"
                CornerRadius="4">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MagnifierTransform" X="0" Y="0" />
            </Border.RenderTransform>
            <StackPanel Padding="4">
                <Image x:Name="MagnifierImage" Width="150" Height="150" Stretch="None" />
                <TextBlock x:Name="MagnifierRgb" Foreground="White" FontSize="11"
                           FontFamily="Consolas" Margin="2,2,2,0" Text="RGB: 0,0,0" />
                <TextBlock x:Name="MagnifierPos" Foreground="#FFB347" FontSize="11"
                           FontFamily="Consolas" Margin="2,0,2,2" Text="X: 0 Y: 0" />
            </StackPanel>
        </Border>
    </local:CursorLayer>
</Window>
