<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.Views.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarMark.UI.Views">

    <!--
        截图遮罩：每块显示器一个本窗口的实例（每屏 DPI 可能不同，单窗跨屏只有一屏的坐标换算是对的）。
        画面不是"实时桌面"，而是按下热键那一瞬间抓好的那一帧的对应块 —— 所以遮罩盖上去之后
        底下的内容还在动，也不会让选区内容与最终截到的东西不一致（Snipaste 同一做法）。
        Background 用 #01000000 而不是 Transparent：完全透明的背景不参与命中测试，
        那样在还没框选的空白处按下鼠标会穿到桌面去，用户会觉得"第一下点不动"。
    -->
    <!-- 根元素用 CursorLayer（Grid 的子类）而不是 Grid：WinUI 3 只有 protected 的 ProtectedCursor，
         要按"这一按是画还是改框"换光标形状就必须子类化一个口子出来（见 CursorLayer.cs）。 -->
    <local:CursorLayer
        x:Name="Root"
        Background="#01000000"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased"
        RightTapped="Root_RightTapped"
        KeyDown="Root_KeyDown">

        <!--
            只有"就地编辑贴图"那一态会用这份菜单（右键唤出）：截图时右键是"这一屏不截"，
            而编辑时一次误触不该把用户画了一半的东西丢掉，所以那里右键给的是菜单，
            把"丢"明确写成一句「放弃本次编辑」。贴图自己那份菜单（复制/存图/识字/关闭这张）
            在这里合并进来，用户不必退出编辑再右键。
        -->
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="完成编辑，写回这张贴图（Enter）" Click="EditDone_Click"/>
                <MenuFlyoutItem Text="放弃本次编辑，贴图保持原样（Esc）" Click="EditDiscard_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="复制这张图" Click="Copy_Click"/>
                <MenuFlyoutItem Text="另存为图片" Click="Save_Click"/>
                <MenuFlyoutItem Text="识别文字（复制纯文本）" Click="Ocr_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="关闭这张贴图" Click="ClosePin_Click"/>
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>

        <Image x:Name="Shot" Stretch="Fill" IsHitTestVisible="False"/>

        <!--
            选区与四周压暗都在这一层 Canvas 里：Canvas 才会按坐标摆子元素，
            且整层不吃命中测试（鼠标事件始终归 Root，拖动不会被中途截走）。
            用"四块压暗"而不是"一层暗幕挖洞"：前者只需四次矩形定位，不需要裁剪几何，
            跨 DPI 与负原点时没什么可算错的。
        -->
        <!--
            标注层：摆在选区那块位置，显示的是 AnnotationPainter 真的画出来的那份像素
            （不是"界面另画一遍近似的样子"）——所见即所存，撤销/重画也只需要拿底图重烤一次。
            拖动中未松手的那一条由 LiveLayer 用简单图元近似显示，松手立刻换成真像素。
        -->
        <Canvas x:Name="AnnotateLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Image x:Name="AnnotateShot" Stretch="Fill"/>
            <Canvas x:Name="LiveLayer"/>
        </Canvas>

        <Canvas x:Name="DimLayer" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#66000000"/>
            <Rectangle x:Name="DimLeft" Fill="#66000000"/>
            <Rectangle x:Name="DimRight" Fill="#66000000"/>
            <Rectangle x:Name="DimBottom" Fill="#66000000"/>
            <Rectangle x:Name="SelRect" Stroke="#FF4CA0FF" StrokeThickness="2" Visibility="Collapsed"/>
        </Canvas>


        <!--
            文字标注就地输入：点一下就打字，Enter 换行（不再当"落笔"），Esc 结束编辑并保住已打的字；
            点已经写好的那行字会带着原文再开一次编辑。写满一行的宽度按屏幕收，不自动折行——
            折行只有编辑框看得见，画出去的成品是一整行，那就是两张图。
            <b>左上角对齐是必须的</b>：Grid 子元素默认 Stretch，只给 Margin 定位的话，
            这块底板会从"点击处"一路铺到屏幕右下角（真机反馈的"点击处到右下角的黄色矩形"），
            输入框本身也会跟着拉成一条巨大无比的东西。
            <b>底板刻意近乎透明、靠描边认边界</b>（真机反馈："点击后不应出现黄色矩形，最好是透明但描边的边框"）：
            一块实色黄底会把要看的那片画面整个盖掉。描边用当前选的字色，在深浅底上都看得出来；
            留一成暗底只是为了字在半透明图上还读得清，不是把这块做成色块。
        -->
        <Border
            x:Name="TextEditorHost"
            Background="#1A000000"
            BorderBrush="#FFFFFFFF"
            BorderThickness="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <TextBox
                x:Name="TextEditor"
                Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Left"
                MinWidth="180"
                AcceptsReturn="True"
                FontFamily="Microsoft YaHei UI"
                KeyDown="TextEditor_KeyDown"/>
        </Border>

        <Border
            x:Name="SizeChip"
            Background="#DD1F1F1F"
            CornerRadius="4"
            Padding="6,2,6,2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <TextBlock x:Name="SizeText" FontSize="11" Foreground="#FFFFFFFF"/>
        </Border>

        <!--
            一条窄窄的**纯图标**工具条（真机反馈：形状/颜色/粗细做成带文字的下拉，整条又高又占地方）。
            <para>
            这里连一个按钮都不写：<b>整条由代码按 <c>AnnotationTool</c> / <c>Annotation.Palette</c> /
            <c>Annotation.ThicknessSteps</c> 生成</b>，尺寸与配色也只在那一处定义。
            写在这里就是第二份事实——而"模型里有、条上没有"这类错只有跑起来才看得见。
            </para>
            <para>
            图标是代码画的矢量图元，<b>不用字体字形</b>：字形缺字会显示成方块，而遮罩一按 Esc 就没了，
            没人能靠眼睛把八个字形逐个确认一遍。名字与说明全部收进 ToolTip（悬停读得到，按钮上不占地方）。
            颜色与粗细收在"笔"那一颗点开的浮层里，当前用哪支笔、多粗，条上那颗点直接看得出来。
            </para>
        -->
        <Border
            x:Name="ActionBar"
            Background="#EE202020"
            CornerRadius="5"
            Padding="4,3,4,3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed">
            <StackPanel x:Name="BarRow" Orientation="Horizontal" Spacing="2"/>
        </Border>

        <Border
            x:Name="HintChip"
            Background="#CC202020"
            CornerRadius="6"
            Padding="10,5,10,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,24,0,0">
            <TextBlock
                x:Name="HintText"
                FontSize="12"
                Foreground="#FFFFFFFF"
                Text="按住拖动框选区域 · 条上点「图形」换矩形 / 椭圆 / 直线 / 折线 / 箭头，再点当前工具换颜色和粗细 · 折线点几下钉顶点，Enter 或双击收口 · Enter 复制 · Esc 取消 · 右键不截"/>
        </Border>

        <!-- 失败原因就地显示：弹对话框会立刻把遮罩的焦点抢走（抢走就等于取消截图） -->
        <Border
            x:Name="ErrorChip"
            Background="#EE7A1F1F"
            CornerRadius="6"
            Padding="10,5,10,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFFFFFFF" TextWrapping="Wrap" MaxWidth="460"/>
        </Border>

        <!--
            选中某条标注后才现身的一句说明。放在这里而不是 ToolTip：把手怎么用法只有"正握着它的人"需要知道，
            而遮罩窗上悬停到一颗 6 像素的方块才看得到提示，等于没有提示（真机反复反馈"以为功能没做"）。
        -->
        <Border
            x:Name="SelectionTip"
            Background="#CC202020"
            CornerRadius="6"
            Padding="10,5,10,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            Visibility="Collapsed">
            <TextBlock
                FontSize="12"
                Foreground="#FFFFFFFF"
                Text="已选中：拖框内＝移动 · 拖角＝缩放 · 拖顶部圆点＝转方向 · 文字点住它＝接着改（Enter 换行） · Delete＝删除"/>
        </Border>
    </local:CursorLayer>
</Window>
