<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.SystemMonitorWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels">

    <StackPanel Padding="12,8,12,10" Spacing="4">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitorRow">
                    <StackPanel Spacing="2" Padding="0,4,0,4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontSize="12" Opacity="0.75"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 只有"占用率"这一类的行画进度条；网速没有稳定的"满不满"语义，硬画会让人误读 -->
                        <ProgressBar Height="4" MinHeight="4" Minimum="0" Maximum="1"
                                     Value="{x:Bind Ratio, Mode=OneWay}"
                                     Visibility="{x:Bind ShowsBar, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="10" Opacity="0.6"/>
                        <!-- 读不到就把原因写在行内：只留一个短横会让人以为数值真是 0 -->
                        <TextBlock Text="{x:Bind Error, Mode=OneWay}" FontSize="10" TextWrapping="Wrap"
                                   Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- 三个框都取消后只剩一个标题栏，容易被误当成组件坏了 ⇒ 就地说明该怎么做 -->
        <TextBlock Text="未选择任何指标，点下面按钮勾回来" FontSize="11" Opacity="0.6"
                   Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <TextBlock Text="{x:Bind ViewModel.Note, Mode=OneWay}" FontSize="10" Opacity="0.6"
                   TextWrapping="Wrap"/>

        <Button Content="选择指标" FontSize="11" Padding="10,3,10,3" HorizontalAlignment="Left" Margin="0,2,0,0"
                Style="{StaticResource WidgetActionButton}" Click="PickToggle_Click"/>

        <StackPanel x:Name="PickPanel" Visibility="Collapsed" Spacing="0" Margin="0,2,0,0">
            <CheckBox Content="CPU 占用" FontSize="12" IsChecked="{x:Bind ViewModel.PickCpu, Mode=TwoWay}"
                      Checked="Pick_Changed" Unchecked="Pick_Changed"/>
            <CheckBox Content="内存占用" FontSize="12" IsChecked="{x:Bind ViewModel.PickMemory, Mode=TwoWay}"
                      Checked="Pick_Changed" Unchecked="Pick_Changed"/>
            <CheckBox Content="网速" FontSize="12" IsChecked="{x:Bind ViewModel.PickNetwork, Mode=TwoWay}"
                      Checked="Pick_Changed" Unchecked="Pick_Changed"/>
        </StackPanel>
    </StackPanel>
</UserControl>
