<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.ClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="10,8,10,10" RowDefinitions="*,Auto">
        <StackPanel x:Name="ClockBody" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                    SizeChanged="ClockBody_SizeChanged">
            <TextBlock x:Name="TimeBlock" Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="DateBlock" Text="{x:Bind ViewModel.DateText, Mode=OneWay}" FontSize="12" Opacity="0.7"
                       HorizontalAlignment="Center"/>
            <!-- 护眼那一行只在提醒开着时占位（批次 WC-3：引擎仍是应用级那一个，这里只是把它的话说出来） -->
            <TextBlock x:Name="RestBlock" Text="{x:Bind ViewModel.RestText, Mode=OneWay}" FontSize="12" Opacity="0.62"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasRestLine, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <!-- 闹钟那一行只在"有得确认"时占位（批次 RU：判据在 AlarmPolicy，这里只说"该你了"） -->
            <TextBlock x:Name="AlarmBlock" Text="{x:Bind ViewModel.AlarmText, Mode=OneWay}" FontSize="12" Opacity="0.8"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasAlarmLine, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- 闹钟那一排（批次 VO）：内容在 code-behind 建——不超过 8 条，用不着 DataTemplate，
             而行 id 直接进各自的闭包＝不再有"从 flyout 反查 id"那一环（坑表 #247 就是那颗颜色点）。
             字号刻意<b>不吃自适应</b>（只跟组件级文本缩放走）：它若也按 body 高度算，
             "行变多 → body 变高 → 字号变小 → 行变矮"就是一个自己咬自己的回环，抖动只会由他看见。 -->
        <StackPanel x:Name="AlarmList" Grid.Row="1" Margin="0,6,0,0" Spacing="1"
                    HorizontalAlignment="Center" IsTabStop="False"/>
    </Grid>
</UserControl>
