<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.ClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="10,8,10,10">
        <StackPanel x:Name="ClockBody" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4"
                    SizeChanged="ClockBody_SizeChanged">
            <TextBlock x:Name="TimeBlock" Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="DateBlock" Text="{x:Bind ViewModel.DateText, Mode=OneWay}" FontSize="12" Opacity="0.7"
                       HorizontalAlignment="Center"/>
            <!-- 护眼那一行只在提醒开着时占位（批次 WC-3：引擎仍是应用级那一个，这里只是把它的话说出来） -->
            <TextBlock x:Name="RestBlock" Text="{x:Bind ViewModel.RestText, Mode=OneWay}" FontSize="12" Opacity="0.62"
                       HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasRestLine, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
