<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.GlanceWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- 0：日期头（固定高度） -->
            <RowDefinition Height="Auto"/>
            <!-- 1：GitHub 热榜（可选，Auto = 关着时整块 0 高度，不跟「常看」抢空间） -->
            <RowDefinition Height="Auto"/>
            <!-- 2：常看条目（吃掉剩余高度，内部 ScrollViewer 才能拿到有界高度） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 日期头：大号日号 + 年月 / 星期，下面跟农历与节日倒计时 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock x:Name="DayBlock" Grid.Column="0" Text="18" FontSize="42" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="MonthBlock" Text="2026年9月" FontSize="13"/>
                    <TextBlock x:Name="WeekBlock" Text="星期五" FontSize="12" Opacity="0.7"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="LunarBlock" Text="农历八月初八" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="CountdownBlock" Text="" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
        </StackPanel>

        <!--
            GitHub 热榜块（用户裁决：在「常看」上面；默认日榜）。组件小 ⇒ 不放图标按钮，
            Star / 收进收藏 走行右键（与主窗同一菜单工厂 ItemContextMenu）。
        -->
        <StackPanel x:Name="TrendingBlock" Grid.Row="1" Spacing="6" Visibility="Collapsed">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="GitHub 热榜 · 今日" FontSize="12" Opacity="0.6"/>
                <Button Grid.Column="1" x:Name="TrendingRefreshButton" Content="刷新" FontSize="11"
                        Padding="6,2" Click="TrendingRefresh_Click"
                        ToolTipService.ToolTip="强制重抓今日榜（每个周期每天至多自动抓一次）"/>
            </Grid>
            <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TrendingHost" Spacing="4"/>
            </ScrollViewer>
            <!-- 空与失败分开说：抓失败时留一句原因，不让用户以为"今天 GitHub 没有热榜" -->
            <TextBlock x:Name="TrendingEmpty" Text="" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="TrendingStatus" Text="" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <!-- 动作回显单独一行：Star 在远端、本机列表当下不变，没有这一行的话组件上点了就是"毫无反应" -->
            <TextBlock x:Name="TrendingAction" Text="" FontSize="10" Opacity="0.8" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- 常看条目：ScrollViewer 直接挂在 Grid 行内（绝不能包进 StackPanel，否则不滚动，见踩坑 #61） -->
        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="常看" FontSize="12" Opacity="0.6"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ItemsHost" Spacing="4"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="暂无条目" FontSize="12" Opacity="0.55"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
