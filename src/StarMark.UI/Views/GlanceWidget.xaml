<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.GlanceWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:StarMark.UI.Helpers">

    <Grid Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- 0：日期头（固定高度） -->
            <RowDefinition Height="Auto"/>
            <!-- 1：GitHub 热榜（可选，Auto = 关着时整块 0 高度，不跟「常看」抢空间） -->
            <RowDefinition Height="Auto"/>
            <!-- 2：常看条目（吃掉剩余高度，内部 ScrollViewer 才能拿到有界高度） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 日期头：大号日号 + 年月 / 星期，下面跟农历与节日倒计时；右上角可切月历（发起人裁决：日历不另立组件） -->
        <StackPanel Grid.Row="0" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="DayBlock" Grid.Column="0" Text="18" FontSize="42" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <!-- ⛔ 这里不留"2026年9月／星期五"那种示例字：这两格每次 Loaded 都由 RefreshDate() 重写，
                         留着就是同一句话的第二份出处，而它⛔ 换语言（✅WI-2n／WI-53 同一颗判据）。 -->
                    <TextBlock x:Name="MonthBlock" FontSize="13"/>
                    <TextBlock x:Name="WeekBlock" FontSize="12" Opacity="0.7"/>
                </StackPanel>
                <ToggleButton Grid.Column="2" x:Name="CalendarToggle" i18n:LocText.Key="widget.gl.calendar" FontSize="11"
                              Padding="8,2,8,2" VerticalAlignment="Top" Checked="CalendarToggle_Changed"
                              Unchecked="CalendarToggle_Changed"
                              i18n:LocText.ToolTipKey="widget.gl.calendarTip"/>
            </Grid>

            <StackPanel x:Name="DateHead" Spacing="4">
                <!-- ⛔ "农历八月初八"那种示例字⛔ 留在这里：那一行由 RefreshDate() 按当前语言当场算，
                     挂静态键又会把带读数的实参冻住（坑表 #361／✅WI-53 天气那 4 句同一条口子）。 -->
                <TextBlock x:Name="LunarBlock" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock x:Name="CountdownBlock" Text="" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 月历：表头固定周日…周六，格子由代码按 MonthGrid 生成（补齐整周 ⇒ 每行的星期都对得上表头） -->
            <StackPanel x:Name="CalendarBlock" Spacing="4" Visibility="Collapsed">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                    <Button Grid.Column="0" Content="‹" FontSize="12" Padding="8,0,8,0" Click="PrevMonth_Click"
                            i18n:LocText.ToolTipKey="widget.gl.prevMonth"/>
                    <!-- 这一格与主行共用 `widget.glance.ym`（那颗年月句此前有两份主人）：面字⛔ 留示例值。 -->
                    <TextBlock Grid.Column="1" x:Name="CalendarTitle" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="›" FontSize="12" Padding="8,0,8,0" Click="NextMonth_Click"
                            i18n:LocText.ToolTipKey="widget.gl.nextMonth"/>
                    <Button Grid.Column="3" i18n:LocText.Key="widget.gl.today" FontSize="11" Padding="6,0,6,0" Click="TodayMonth_Click"
                            i18n:LocText.ToolTipKey="widget.gl.todayTip"/>
                </Grid>
                <Grid x:Name="CalendarHost"/>
                <TextBlock i18n:LocText.Key="widget.gl.dotLegend" FontSize="9" Opacity="0.5"/>
            </StackPanel>
        </StackPanel>

        <!--
            GitHub 热榜块（用户裁决：在「常看」上面；默认日榜）。组件小 ⇒ 不放图标按钮，
            Star / 收进收藏 走行右键（与主窗同一菜单工厂 ItemContextMenu）。
        -->
        <StackPanel x:Name="TrendingBlock" Grid.Row="1" Spacing="6" Visibility="Collapsed">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" i18n:LocText.Key="widget.gl.trendingTitle" FontSize="12" Opacity="0.6"/>
                <Button Grid.Column="1" x:Name="TrendingRefreshButton" i18n:LocText.Key="dialog.refresh" FontSize="11"
                        Padding="6,2" Click="TrendingRefresh_Click"
                        i18n:LocText.ToolTipKey="widget.gl.trendingRefreshTip"/>
            </Grid>
            <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TrendingHost" Spacing="4"/>
            </ScrollViewer>
            <!-- 空与失败分开说：抓失败时留一句原因，不让用户以为"今天 GitHub 没有热榜" -->
            <TextBlock x:Name="TrendingEmpty" Text="" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="TrendingStatus" Text="" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <!-- 动作回显单独一行：Star 在远端、本机列表当下不变，没有这一行的话组件上点了就是"毫无反应" -->
            <TextBlock x:Name="TrendingAction" Text="" FontSize="10" Opacity="0.8" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- 常看条目：ScrollViewer 直接挂在 Grid 行内（绝不能包进 StackPanel，否则不滚动，见踩坑 #61） -->
        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" i18n:LocText.Key="widget.gl.frequent" FontSize="12" Opacity="0.6"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ItemsHost" Spacing="4"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" i18n:LocText.Key="widget.gl.empty" FontSize="12" Opacity="0.55"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
