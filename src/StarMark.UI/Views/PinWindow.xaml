<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.Views.PinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        贴图窗：把刚截下的那块画面常驻在桌面上（Snipaste 的"贴"）。
        它刻意**不是组件**（D3 裁决）：不进 WidgetManager / WidgetRegistry，不存位置与尺寸，
        退出程序即消失——所以这里没有主题、没有材质，只有一张位图和它的边框。
        边框用半透明白：贴图常贴在深色画面上，没有描边就看不出这块画面的边界在哪。
    -->
    <Grid
        x:Name="Root"
        Background="#01000000"
        PointerPressed="Root_PointerPressed"
        PointerMoved="Root_PointerMoved"
        PointerReleased="Root_PointerReleased"
        PointerWheelChanged="Root_PointerWheelChanged"
        RightTapped="Root_RightTapped"
        KeyDown="Root_KeyDown">

        <FlyoutBase.AttachedFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="CopyItem" Text="复制这张图" Click="Copy_Click"/>
                <MenuFlyoutItem x:Name="SaveItem" Text="另存为图片" Click="Save_Click"/>
                <MenuFlyoutItem x:Name="ThroughItem" Text="鼠标穿透（所有贴图）" Click="ClickThrough_Click"/>
                <MenuFlyoutItem x:Name="CloseItem" Text="关闭这张（Esc）" Click="Close_Click"/>
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>

        <Border x:Name="Frame" BorderThickness="1" BorderBrush="#80FFFFFF">
            <Image x:Name="Shot" Stretch="Fill"/>
        </Border>

        <!--
            状态角标：只在"不是初始状态"时出现（缩放≠100% 或已穿透）。
            穿透必须留痕——否则用户接着点桌面会觉得"这张图坏了"，而它只是不收鼠标了。
        -->
        <Border
            x:Name="Badge"
            Background="#CC202020"
            CornerRadius="3"
            Padding="5,1,5,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,1,0"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock x:Name="BadgeText" FontSize="11" Foreground="#FFFFFFFF"/>
        </Border>
    </Grid>
</Window>
