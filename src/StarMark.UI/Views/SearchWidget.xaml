<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.SearchWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels"
    xmlns:local="using:StarMark.UI.Views">

    <UserControl.Resources>
        <!-- 标签选中态底色：选中用主题强调色（柔和），未选中透明。 -->
        <local:TagSelectedBrushConverter x:Key="TagSelBrush"/>
    </UserControl.Resources>

    <StackPanel Padding="12,8,12,12" Spacing="8">
        <!-- 关键词 -->
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="SearchBox" PlaceholderText="关键词，回车搜索…" FontSize="13"
                     Padding="8,6,8,6" HorizontalAlignment="Stretch" MinWidth="120"/>
            <Button Content="搜索" Padding="10,4,10,4" Click="Search_Click"/>
        </StackPanel>

        <!-- 标签筛选（多选 = AND 语义） -->
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
            <TextBlock Text="标签" FontSize="11" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center"/>
            <Button Content="清除标签" FontSize="10" Padding="6,2,6,2"
                    Background="Transparent" BorderThickness="0"
                    Click="ClearTags_Click"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="36">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagChip">
                        <Button Tag="{x:Bind Name}" Click="TagToggle_Click"
                                Padding="8,3,8,3" FontSize="11" BorderThickness="1"
                                BorderBrush="{ThemeResource WidgetDividerBrush}"
                                Background="{x:Bind Selected, Mode=OneWay, Converter={StaticResource TagSelBrush}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Count}" FontSize="9" Opacity="0.6" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Border Height="1" Margin="0,2,0,2" Background="{ThemeResource WidgetDividerBrush}"/>

        <!-- 结果 -->
        <TextBlock Text="结果" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
        <TextBlock x:Name="EmptyHint" Text="输入关键词或选择标签开始搜索"
                   FontSize="10" Opacity="0.55" TextWrapping="Wrap" Margin="2,2,2,4"/>
        <ItemsRepeater x:Name="ResultsRepeater" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultItem">
                    <Button Margin="0,1,0,1" HorizontalContentAlignment="Left"
                            Padding="6,4,6,4" Background="{ThemeResource WidgetSubtleFillBrush}"
                            BorderThickness="0" CornerRadius="4"
                            Click="ResultOpen_Click" Tag="{x:Bind Uri}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Emoji}" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="9" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
