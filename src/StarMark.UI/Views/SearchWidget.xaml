<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.SearchWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:StarMark.UI.Helpers"
    xmlns:vm="using:StarMark.UI.ViewModels"
    xmlns:local="using:StarMark.UI.Views">

    <UserControl.Resources>
        <!-- 标签选中态底色：选中用主题强调色（柔和），未选中透明。 -->
        <local:TagSelectedBrushConverter x:Key="TagSelBrush"/>
    </UserControl.Resources>

    <StackPanel Padding="12,8,12,12" Spacing="8">
        <!-- 关键词 -->
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="SearchBox" i18n:LocText.PlaceholderKey="widget.sw.searchHint" FontSize="13"
                     Style="{StaticResource WidgetInputBox}"
                     Padding="8,6,8,6" HorizontalAlignment="Stretch" MinWidth="120"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"/>
            <Button i18n:LocText.Key="widget.sw.search" Padding="10,4,10,4" Style="{StaticResource WidgetActionButton}" Click="Search_Click"/>
        </StackPanel>

        <!-- 排序（批次 P 内联轻量增强）：相关度 / 最近更新 / 名称。对照 DeskBox 弹窗可点列排序，
             这里收敛为小组件适配的一枚下拉。浏览态（空词）只认 名称/最近更新。
             ⚠ 选项走「数据项＋模板」（与 <c>TrendingPage.xaml</c> 那颗周期下拉同一颗共用模板）：
             把 <c>&lt;ComboBoxItem Content="中文"&gt;</c> 写回标记里，闭着的那一格显示的就是选中那一刻从 Content
             抄走的快照——换语言时展开的列表翻了、这一格不翻（坑表 #272／#275；批次 WI-67 片9b 收回
             <c>I18nWiringGateTests</c> 那三句在案豁免）。措辞住表里，排序键（relevance／recent／name）住在数据项里。 -->
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock i18n:LocText.Key="widget.sw.sortTitle" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
            <ComboBox x:Name="SortBox" FontSize="11" SelectedIndex="0" MinWidth="104"
                      SelectionChanged="SortBox_SelectionChanged"
                      ItemsSource="{x:Bind SortOptions, Mode=OneTime}"
                      ItemTemplate="{StaticResource LocOptionTemplate}"/>
            <TextBlock i18n:LocText.Key="widget.sw.keysHint" FontSize="9" Opacity="0.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- 标签筛选（多选 = AND 语义）。换行面板 + 垂直滚动：
             旧实现是 36px 高的横向单行滚动，标签一多整行被裁剪且滚轮不可达；
             WinUI 3 无内置 WrapLayout（WMC0001）、ItemsRepeater 不接受非虚拟化布局，
             故用自写 WrapPanel（见 SearchWidget.xaml.cs）配合 ItemsControl 换行铺开。 -->
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
            <TextBlock i18n:LocText.Key="widget.sw.tagsTitle" FontSize="11" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center"/>
            <Button i18n:LocText.Key="widget.sw.clearTags" FontSize="10" Padding="6,2,6,2"
                    Background="Transparent" BorderThickness="0"
                    Click="ClearTags_Click"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" MaxHeight="132">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagChip">
                        <Button Tag="{x:Bind Name}" Click="TagToggle_Click"
                                Padding="8,3,8,3" FontSize="11" BorderThickness="1"
                                BorderBrush="{ThemeResource WidgetDividerBrush}"
                                Background="{x:Bind Selected, Mode=OneWay, Converter={StaticResource TagSelBrush}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Count}" FontSize="9" Opacity="0.6" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Height="1" Margin="0,2,0,2" Background="{ThemeResource WidgetDividerBrush}"/>

        <!-- 结果 -->
        <TextBlock i18n:LocText.Key="widget.sw.results" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
        <!-- ⚠ 这一格的初值⛔ 写在标记里：它每次搜索结果落地都由 code-behind 现贴（UpdateEmptyHint），
             标记里留一句字面量＝同一句话的第二个主人，换语言那一刻它还会把带状态那句盖回兜底那句（坑表 #276／#295）。 -->
        <TextBlock x:Name="EmptyHint"
                   FontSize="10" Opacity="0.55" TextWrapping="Wrap" Margin="2,2,2,4"/>
        <ItemsRepeater x:Name="ResultsRepeater" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultItem">
                    <Button Margin="0,1,0,1" HorizontalContentAlignment="Left"
                            Padding="6,4,6,4" Background="{ThemeResource WidgetSubtleFillBrush}"
                            BorderThickness="0" CornerRadius="4" CanDrag="True" DragStarting="Row_DragStarting"
                            Click="ResultOpen_Click" ContextRequested="Row_ContextRequested" Tag="{x:Bind}">
                        <Grid>
                            <!-- ↑↓ 键盘选中高亮层：叠在紧凑行底色之上，未选中即透明（复用标签选中转换器语义）。 -->
                            <Border CornerRadius="3" Margin="-6,-4,-6,-4"
                                    Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource TagSelBrush}}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Emoji}" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="9" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
