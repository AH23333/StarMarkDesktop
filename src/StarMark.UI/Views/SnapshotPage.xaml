<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.SnapshotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:StarMark.UI.Views"
    xmlns:helpers="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer Background="Transparent" Padding="16,12,16,16"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" MaxWidth="760">
            <TextBlock Text="快照" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="快照记下某一时刻「所有组件的布局 + 各自的数据（快捷入口 / 待办 / 随记 / 条目格查询）」。它是不可变的历史点：应用某快照 = 回到那一刻，并会先自动留一个「应用前」回滚点。在组件窗口标题栏点右键 →「保存当前布局与数据…」即可新建。"/>

            <ItemsRepeater ItemsSource="{x:Bind RowsItems, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:SnapshotRow">
                        <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource MutedText}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="查看" Tag="{x:Bind Id}" Click="View_Click"/>
                                <Button Grid.Column="2" Content="提取布局" Tag="{x:Bind Id}" Click="Extract_Click"/>
                                <Button Grid.Column="3" Content="应用" Tag="{x:Bind Id}" Click="Apply_Click"/>
                                <Button Grid.Column="4" Content="删除" Tag="{x:Bind Id}" Click="Delete_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock Text="（还没有快照。在任意组件窗口标题栏右键 →「保存当前布局与数据…」创建第一个。）"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{x:Bind HasNoSnapshots, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
