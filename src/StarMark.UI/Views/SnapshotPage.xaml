<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.SnapshotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:StarMark.UI.Views"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:i18n="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <ScrollViewer Background="Transparent" Padding="16,12,16,16"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" MaxWidth="760">
            <TextBlock FontSize="20" FontWeight="SemiBold" i18n:LocText.Key="nav.snapshot"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       i18n:LocText.Key="snapshot.note"/>

            <ItemsRepeater ItemsSource="{x:Bind RowsItems, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:SnapshotRow">
                        <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource MutedText}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{x:Bind Id}" Click="View_Click"
                                        i18n:LocText.Key="snapshot.view"/>
                                <Button Grid.Column="2" Tag="{x:Bind Id}" Click="Extract_Click"
                                        i18n:LocText.Key="snapshot.extractLayout"/>
                                <Button Grid.Column="3" Tag="{x:Bind Id}" Click="Apply_Click"
                                        i18n:LocText.Key="settings.widgets.applyLayout"/>
                                <Button Grid.Column="4" Tag="{x:Bind Id}" Click="Delete_Click"
                                        i18n:LocText.Key="dialog.delete"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       i18n:LocText.Key="snapshot.empty"
                       Visibility="{x:Bind HasNoSnapshots, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
