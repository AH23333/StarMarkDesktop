<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- 0：城市行（固定） -->
            <RowDefinition Height="Auto"/>
            <!-- 1：当前天气（固定） -->
            <RowDefinition Height="Auto"/>
            <!-- 2：未来预报（吃掉剩余高度） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 城市行：点标题可换城市 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <!-- 不用 TextBlockButtonStyle：该资源在部分 WinUI 版本下解析不到（StaticResource 缺失会直接抛），
                 这里手动把按钮压成「看起来像标题文本」的样子，零依赖 -->
            <Button x:Name="CityButton" Grid.Column="0" Padding="0" BorderThickness="0"
                    Background="Transparent" HorizontalAlignment="Left" Click="CityButton_Click">
                <TextBlock x:Name="CityBlock" Text="选择城市" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </Button>
            <TextBlock x:Name="UpdatedBlock" Grid.Column="1" Text="" FontSize="10" Opacity="0.55"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 当前天气：大号温度 + 图标 + 描述，下面一行体感/湿度/风 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2,0,0">
            <TextBlock x:Name="TempBlock" Grid.Column="0" Text="--°" FontSize="40" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="DescBlock" Text="暂无数据" FontSize="14"/>
                <TextBlock x:Name="FeelsBlock" Text="" FontSize="11" Opacity="0.7"/>
            </StackPanel>

            <TextBlock x:Name="IconBlock" Grid.Column="2" Text="☀️" FontSize="28"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 未来三天预报 -->
        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 2：多日预报（吃掉剩余高度） -->
            <RowDefinition Height="*"/>
            <!-- 3：今日逐时（与二行共用高度，靠 Visibility 二选一） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="ForecastTitle" Text="未来三天" FontSize="12" Opacity="0.6"
                       VerticalAlignment="Center"/>

            <!-- 视图切换（未来三天 / 今日逐时）+ 单位切换（°C / °F） -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button x:Name="ViewButton" Height="22" Padding="8,0" FontSize="10"
                        Content="今日逐时" Click="ViewButton_Click"
                        ToolTipService.ToolTip="在多日概览与今日逐时之间切换"/>
                <Button x:Name="UnitButton" Height="22" Padding="8,0" FontSize="10"
                        Content="°C" Click="UnitButton_Click"
                        ToolTipService.ToolTip="温度单位（华氏模式下风速同时换成 mph）"/>
            </StackPanel>

            <!-- 多日预报 -->
            <ScrollViewer x:Name="DailyScroll" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ForecastHost" Spacing="6"/>
            </ScrollViewer>

            <!-- 今日逐时：横向滚动，一格一小时 -->
            <ScrollViewer x:Name="HourlyScroll" Grid.Row="3" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel x:Name="HourlyHost" Orientation="Horizontal" Spacing="10"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Row="2" Grid.RowSpan="2"
                       Text="点击上方城市名，选择要查看天气的城市"
                       FontSize="12" Opacity="0.55" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
