<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,10,12,12" RowSpacing="10" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <!-- 0：城市行（固定） -->
            <RowDefinition Height="Auto"/>
            <!-- 1：当前天气（固定） -->
            <RowDefinition Height="Auto"/>
            <!-- 2：附加指标网格（仅大尺寸档位显示） -->
            <RowDefinition Height="Auto"/>
            <!-- 3：未来预报（吃掉剩余高度） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 城市行：点标题可换城市 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <!-- 不用 TextBlockButtonStyle：该资源在部分 WinUI 版本下解析不到（StaticResource 缺失会直接抛），
                 这里手动把按钮压成「看起来像标题文本」的样子，零依赖 -->
            <Button x:Name="CityButton" Grid.Column="0" Padding="0" BorderThickness="0"
                    Background="Transparent" HorizontalAlignment="Left" Click="CityButton_Click">
                <TextBlock x:Name="CityBlock" Text="选择城市" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </Button>
            <TextBlock x:Name="UpdatedBlock" Grid.Column="1" Text="" FontSize="10" Opacity="0.55"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 当前天气：大号温度 + 图标 + 描述，下面一行体感/湿度/风 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2,0,0">
            <TextBlock x:Name="TempBlock" Grid.Column="0" Text="--°" FontSize="40" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="DescBlock" Text="暂无数据" FontSize="14"/>
                <TextBlock x:Name="FeelsBlock" Text="" FontSize="11" Opacity="0.7"/>
            </StackPanel>

            <TextBlock x:Name="IconBlock" Grid.Column="2" Text="☀️" FontSize="28"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 附加指标网格：降水概率 / 紫外线 / 气压 / 日出日落。
             只在「大」档位显示——桌面组件默认尺寸塞不下四行指标，硬塞会挤掉预报。 -->
        <Grid x:Name="MetricsHost" Grid.Row="2" Visibility="Collapsed"
              ColumnSpacing="8" RowSpacing="4" Opacity="0.85"/>

        <!-- 未来三天预报 -->
        <Grid Grid.Row="3" RowSpacing="6">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1：预报内容区（多日与逐时共用这一行，靠 Visibility 二选一）。
                 之前逐时写的是 Row=3，而这里只有两行——越界的行索引不会报错，
                 但会落到布局之外的位置，表现为横向列表"飘"到奇怪的地方。 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="ForecastTitle" Text="未来三天" FontSize="12" Opacity="0.6"
                       VerticalAlignment="Center"/>

            <!-- 视图切换（未来三天 / 今日逐时）+ 单位切换（°C / °F） -->
            <StackPanel x:Name="ToggleBar" Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="4">
                <Button x:Name="ViewButton" Height="22" Padding="8,0" FontSize="10"
                        Content="今日逐时" Click="ViewButton_Click"
                        ToolTipService.ToolTip="在多日概览与今日逐时之间切换"/>
                <Button x:Name="UnitButton" Height="22" Padding="8,0" FontSize="10"
                        Content="°C" Click="UnitButton_Click"
                        ToolTipService.ToolTip="温度单位（华氏模式下风速同时换成 mph）"/>
            </StackPanel>

            <!-- 多日预报 -->
            <ScrollViewer x:Name="DailyScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- 右侧留白同理：纵向滚动条也会压住每行的温度数字 -->
                <StackPanel x:Name="ForecastHost" Spacing="6" Padding="0,0,14,0"/>
            </ScrollViewer>

            <!-- 今日逐时：横向滚动，一格一小时 -->
            <ScrollViewer x:Name="HourlyScroll" Grid.Row="1" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <!-- 底部留白：WinUI 的滚动条是**覆盖**在内容之上的（不吃布局空间），
                     组件一窄横向条就压住最后一行温度。给内容垫 16px 把它让开。 -->
                <StackPanel x:Name="HourlyHost" Orientation="Horizontal" Spacing="10"
                            Padding="0,0,0,16"/>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint" Grid.Row="1"
                       Text="点击上方城市名，选择要查看天气的城市"
                       FontSize="12" Opacity="0.55" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
