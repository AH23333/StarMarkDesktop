<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.FolderTreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.EmptyHint}"
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" Margin="12,40,12,16"
                   Visibility="{x:Bind ViewModel.HasEmptyHint, Converter={StaticResource BoolToVis}}"/>

        <!-- 树节点内容在代码中构建（文件夹头 / ItemCard），惰性挂载词条 -->
        <TreeView x:Name="FolderTree" Grid.Row="1"
                  Padding="12,6,12,12"
                  Expanding="FolderTree_Expanding"/>
    </Grid>
</Page>