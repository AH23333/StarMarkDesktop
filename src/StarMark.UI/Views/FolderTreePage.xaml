<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.FolderTreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" Margin="12,40,12,16"
                   Visibility="{x:Bind ViewModel.HasEmptyHint, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <!-- 文件夹手风琴列表：层级在代码中构建（头部 + 惰性卡片区），
             不用 TreeViewItem 容器（其 Presenter 固定行高会压扁 ItemCard）。 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,6,12,12">
            <StackPanel x:Name="FolderRoot" Spacing="2"/>
        </ScrollViewer>
    </Grid>
</Page>