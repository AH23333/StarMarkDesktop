<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.Views.ClipboardSelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels"
    xmlns:i18n="using:StarMark.UI.Helpers">

    <!--
        剪贴板历史选择器（P-63，用户裁决默认键 Ctrl+Alt+V）：全局热键唤起的键呼浮层，对标 Win+V。
        复制语义零重写——列表与「再复制」全部委托 ClipboardPageViewModel（ReuseAsync 那一套，
        含图片行 SetBitmap 分流与回声登记），这里只添「键呼」的那层皮：筛选、↑↓、回车、Esc、失焦收起。
    -->
    <Grid x:Name="Root" Background="#F21E1E1E" RequestedTheme="Dark" Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" Grid.Row="0" FontSize="13"/>
        <ListView x:Name="List" Grid.Row="1" Margin="0,8,0,0" IsItemClickEnabled="True"
                  SelectionMode="Single" ItemClick="List_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemCardViewModel">
                    <StackPanel Spacing="2" Padding="0,4">
                        <TextBlock Text="{x:Bind Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Description}" FontSize="11.5" Foreground="#9FFFFFFF"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="4">
            <TextBlock x:Name="StatusLine" FontSize="11.5" Foreground="#FFD087"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" FontSize="11.5" Foreground="#9FFFFFFF"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       i18n:LocText.Key="clip.selector.noMatch"/>
            <TextBlock x:Name="SearchHint" FontSize="11" Foreground="#6FFFFFFF"
                       i18n:LocText.Key="clip.selector.search"/>
        </StackPanel>
    </Grid>
</Window>
