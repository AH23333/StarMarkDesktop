<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.MusicWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="12,10,12,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <!-- 0：曲目信息（吃掉剩余高度，歌名再长也不把按钮挤出可视区） -->
            <RowDefinition Height="*"/>
            <!-- 1：进度 -->
            <RowDefinition Height="Auto"/>
            <!-- 2：传输控制 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 曲目信息 -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="3">
            <TextBlock x:Name="TitleBlock" Text="未在播放" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <TextBlock x:Name="ArtistBlock" Text="打开任意播放器后这里会显示曲目" FontSize="12"
                       Opacity="0.7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

            <!-- 音源行：只有一个播放器时不占地方（隐藏下拉），多个时才出来 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBlock x:Name="SourceBlock" Text="" FontSize="10" Opacity="0.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="SourceButton" Grid.Column="1" Height="20" Padding="6,0"
                        FontSize="10" Visibility="Collapsed" Content="切换音源"
                        ToolTipService.ToolTip="选择要控制的播放器（默认跟随系统当前播放）">
                    <Button.Flyout>
                        <MenuFlyout x:Name="SourceFlyout" Placement="BottomEdgeAlignedRight"/>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>

        <!-- 进度：条 + 两端时间。条本身不接收指针（IsHitTestVisible=False），
             由外层 SeekHost 统一接管——它比 3px 的条高得多，手指点得中。 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="PositionBlock" Grid.Column="0" Text="0:00" FontSize="10" Opacity="0.6"
                       VerticalAlignment="Center"/>
            <Grid x:Name="SeekHost" Grid.Column="1" Height="16" Background="Transparent"
                  ToolTipService.ToolTip="点击或拖动可跳转进度"
                  PointerPressed="SeekHost_PointerPressed" PointerMoved="SeekHost_PointerMoved"
                  PointerReleased="SeekHost_PointerReleased" PointerCanceled="SeekHost_PointerReleased"
                  PointerCaptureLost="SeekHost_PointerReleased">
                <ProgressBar x:Name="Progress" Value="0" Minimum="0" Maximum="100" Height="3"
                             VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock x:Name="DurationBlock" Grid.Column="2" Text="0:00" FontSize="10" Opacity="0.6"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 传输控制：上一首 / 播放暂停 / 下一首 / 播放模式（Segoe Fluent 字形，各 Windows 版本都能渲染） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
            <Button x:Name="PrevButton" Width="36" Height="36" Padding="0" Click="PrevButton_Click"
                    ToolTipService.ToolTip="上一首">
                <FontIcon Glyph="&#xE892;" FontSize="14"/>
            </Button>
            <Button x:Name="PlayButton" Width="44" Height="44" Padding="0" Click="PlayButton_Click"
                    ToolTipService.ToolTip="播放 / 暂停">
                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18"/>
            </Button>
            <Button x:Name="NextButton" Width="36" Height="36" Padding="0" Click="NextButton_Click"
                    ToolTipService.ToolTip="下一首">
                <FontIcon Glyph="&#xE893;" FontSize="14"/>
            </Button>
            <Button x:Name="ModeButton" Width="36" Height="36" Padding="0" Click="ModeButton_Click">
                <FontIcon x:Name="ModeIcon" Glyph="&#xE8CB;" FontSize="14"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
