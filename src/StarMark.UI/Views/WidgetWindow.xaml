<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:StarMark.UI.Helpers">

    <Border x:Name="RootBorder"
            Background="{ThemeResource WidgetBackgroundBrush}"
            BorderBrush="{ThemeResource WidgetBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（拖动区；右键为组件菜单）：与内容区同一背景，仅以 1px 底边分隔，
                 实现与主界面 TopBar 同款的"标题 + 内容合并为一整块"。 -->
            <Grid x:Name="DragBar" Grid.Row="0"
                  Background="{ThemeResource WidgetBackgroundBrush}"
                  BorderBrush="{ThemeResource WidgetDividerBrush}"
                  BorderThickness="0,0,0,1"
                  CornerRadius="8,8,0,0"
                  Padding="10,0,6,0">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock x:Name="WidgetGlyph" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WidgetTitle" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- 组件控制按钮：置于缩放 grip 之上（ZIndex=200），确保关闭/隐藏/添加/置顶始终可点；
                 四边四角 grip 仍在标题栏与内容区之上（可拉伸），唯独让出右上角按钮区。 -->
            <StackPanel x:Name="ChromeButtons" Grid.Row="0"
                        Orientation="Horizontal" Spacing="1"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Canvas.ZIndex="200">
                <Button x:Name="CollapseButton" Style="{StaticResource WidgetChromeButton}"
                        i18n:LocText.ToolTipKey="widget.win.collapseTip" Click="CollapseButton_Click">
                    <FontIcon x:Name="CollapseIcon" Glyph="&#xE70E;" FontSize="12"/>
                </Button>
                <!-- 这颗按钮的提示条<b>只有 <c>ApplyTopmost</c> 一个主人</b>（按键写，不写字面量）：
                     那里按"现在钉没钉"交两句不同的话，这里挂一颗静态键会在换语言那一刻盖掉带状态的那句。 -->
                <Button x:Name="PinButton" Style="{StaticResource WidgetChromeButton}"
                        Click="PinButton_Click">
                    <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="12"/>
                </Button>
                <Button x:Name="AddButton" Style="{StaticResource WidgetChromeButton}"
                        i18n:LocText.ToolTipKey="widget.win.addTip" Click="AddButton_Click">
                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                </Button>
                <Button x:Name="HideButton" Style="{StaticResource WidgetChromeButton}"
                        i18n:LocText.ToolTipKey="widget.win.hideTip" Click="HideButton_Click">
                    <FontIcon Glyph="&#xE921;" FontSize="11"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource WidgetChromeButton}"
                        i18n:LocText.ToolTipKey="widget.win.removeTip" Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE8BB;" FontSize="11"/>
                </Button>
            </StackPanel>

            <!-- 内容区 -->
            <!-- 滚动条一律 Hidden（批次 VO，用户裁决）：<b>条藏掉，滚轮与拖动照常</b>。
                 组件是贴在桌面上"顺手看一眼"的东西，一条常驻的滑动条既占宽又读起来像"这里坏了"；
                 而真正的滚动出口（滚轮）不依赖那条视觉痕迹。刻意不用 Disabled：那会把滚动一并关掉，
                 内容一多就被裁掉，比有条更糟。 -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <!-- 用 StackPanel 作直接子元素，ScrollViewer 才能可靠按内容高度滚动
                     （Grid 子元素会被拉伸到视口高度并被裁剪，导致链接过多时被遮挡）。 -->
                <StackPanel x:Name="ContentHost" Spacing="0"/>
            </ScrollViewer>

            <!-- 缩放：四边 + 四角 8 向 grip 在代码中布置（AddResizeGrips），替代原右下角手柄 -->
        </Grid>
    </Border>
</Window>
