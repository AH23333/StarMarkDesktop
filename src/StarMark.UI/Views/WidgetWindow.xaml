<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="RootBorder"
            Background="{ThemeResource WidgetBackgroundBrush}"
            BorderBrush="{ThemeResource WidgetBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（拖动区；右键为组件菜单） -->
            <Grid x:Name="DragBar" Grid.Row="0"
                  Background="{ThemeResource WidgetChromeBrush}"
                  CornerRadius="8,8,0,0"
                  Padding="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock x:Name="WidgetGlyph" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WidgetTitle" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="ChromeButtons" Grid.Column="1" Orientation="Horizontal" Spacing="1">
                    <Button x:Name="PinButton" Style="{StaticResource WidgetChromeButton}"
                            ToolTipService.ToolTip="置顶显示" Click="PinButton_Click">
                        <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="12"/>
                    </Button>
                    <Button x:Name="AddButton" Style="{StaticResource WidgetChromeButton}"
                            ToolTipService.ToolTip="添加/管理组件" Click="AddButton_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                    </Button>
                    <Button x:Name="HideButton" Style="{StaticResource WidgetChromeButton}"
                            ToolTipService.ToolTip="隐藏（托盘/设置中可恢复）" Click="HideButton_Click">
                        <FontIcon Glyph="&#xE921;" FontSize="11"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource WidgetChromeButton}"
                            ToolTipService.ToolTip="移除组件（设置中可重新添加）" Click="CloseButton_Click">
                        <FontIcon Glyph="&#xE8BB;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 内容区 -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <!-- 用 StackPanel 作直接子元素，ScrollViewer 才能可靠按内容高度滚动
                     （Grid 子元素会被拉伸到视口高度并被裁剪，导致链接过多时被遮挡）。 -->
                <StackPanel x:Name="ContentHost" Spacing="0"/>
            </ScrollViewer>

            <!-- 右下角缩放手柄 -->
            <Border x:Name="ResizeThumb" Grid.Row="1"
                    Width="14" Height="14"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="Transparent"
                    ToolTipService.ToolTip="拖动调整大小">
                <FontIcon Glyph="&#xE75F;" FontSize="9" Opacity="0.35"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,2,2"/>
            </Border>
        </Grid>
    </Border>
</Window>
