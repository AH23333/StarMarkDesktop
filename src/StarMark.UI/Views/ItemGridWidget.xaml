<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.ItemGridWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:local="using:StarMark.UI.Views">

    <UserControl.Resources>
        <local:TagSelectedBrushConverter x:Key="TagSelBrush"/>
        <helpers:ActivityChangeToBrushConverter x:Key="ChangeToBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 配置栏：仅标签格 / 搜索结果格需要（由 code-behind 控制可见性） -->
        <StackPanel x:Name="ConfigBar" Grid.Row="0" Padding="12,8,12,4" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="ConfigHint" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="ConfigBox" PlaceholderText="输入标签名…" FontSize="13"
                         Style="{StaticResource WidgetInputBox}"
                         Padding="8,6,8,6" HorizontalAlignment="Stretch" MinWidth="140"
                         KeyDown="ConfigBox_KeyDown"/>
                <Button Content="应用" Padding="10,4,10,4" Style="{StaticResource WidgetActionButton}" Click="Apply_Click"/>
            </StackPanel>

            <!-- 搜索结果格的排序（仅搜索模式由 code-behind 置可见）：对照 DeskBox 结果面可重排，
                 并与快捷搜索的排序下拉同源（相关度 / 最近更新 / 名称）。索引→键见 ViewModel.ApplySort。 -->
            <StackPanel x:Name="SortRow" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="排序" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                <ComboBox x:Name="SortBox" FontSize="11" SelectedIndex="0" MinWidth="104"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="相关度"/>
                    <ComboBoxItem Content="最近更新"/>
                    <ComboBoxItem Content="名称"/>
                </ComboBox>
            </StackPanel>

            <!-- 搜索结果格的标签过滤（AND 语义） -->
            <StackPanel x:Name="TagCloudPanel" Visibility="Collapsed" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="标签" FontSize="11" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center"/>
                    <Button Content="清除标签" FontSize="10" Padding="6,2,6,2"
                            Background="Transparent" BorderThickness="0" Click="ClearTags_Click"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagChip">
                                <Button Tag="{x:Bind Name}" Click="TagToggle_Click"
                                        Padding="8,3,8,3" FontSize="11" BorderThickness="1"
                                        BorderBrush="{ThemeResource WidgetDividerBrush}"
                                        Background="{x:Bind Selected, Mode=OneWay, Converter={StaticResource TagSelBrush}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Count}" FontSize="9" Opacity="0.6" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <Border Height="1" Margin="0,2,0,2" Background="{ThemeResource WidgetDividerBrush}"/>
        </StackPanel>

        <!-- 结果列表：非活动格用 Items（可点开/右键），最近活动格（#51）用 Events 事件流（仅展示、三色圆点） -->
        <ScrollViewer Grid.Row="1" Padding="12,4,12,12">
            <StackPanel>
                <ItemsRepeater x:Name="ResultsRepeater" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemRowItem">
                            <Button Margin="0,2,0,2" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                    Padding="6,5,6,5" Background="{ThemeResource WidgetSubtleFillBrush}"
                                    BorderThickness="0" CornerRadius="4"
                                    Click="ResultOpen_Click" ContextRequested="Row_ContextRequested" Tag="{x:Bind}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Emoji}" FontSize="15" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" MaxWidth="240"/>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="10" Opacity="0.6"
                                                   TextWrapping="Wrap" MaxLines="1" MaxWidth="240"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 最近活动格：每行一个事件，圆点按 增(绿)/删(红)/改(黄) 着色，仅展示（无点击/右键） -->
                <ItemsRepeater x:Name="EventsRepeater" Visibility="Collapsed"
                               ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityItemViewModel">
                            <Grid ColumnDefinitions="12,Auto,*,Auto" Padding="2,3" ColumnSpacing="8">
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind Change, Converter={StaticResource ChangeToBrush}}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind KindLabel}" FontSize="10"
                                           Foreground="{x:Bind Change, Converter={StaticResource ChangeToBrush}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind AtText}" FontSize="9" Opacity="0.55"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="暂无条目"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.5" FontSize="12" Visibility="Collapsed"/>
    </Grid>
</UserControl>
