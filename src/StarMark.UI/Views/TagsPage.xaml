<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:ContainedTagColorConverter x:Key="ContainedTagColor"/>
    </Page.Resources>

    <Grid Background="Transparent" Padding="12,12,12,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标签筛选栏：当前生效的标签以 chip 展示，可单个 ✕ 移除或一键清除（对齐扩展 tag-banner） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    Visibility="{x:Bind ViewModel.HasActiveFilter, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
            <TextBlock Text="标签筛选" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActiveFilterChips, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="4"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TagFilterChip">
                        <Button Click="RemoveFilterChip_Click" Tag="{x:Bind Name}"
                                Padding="8,2" CornerRadius="10" BorderThickness="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                ToolTipService.ToolTip="移除该标签筛选">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind Name}" FontSize="11"
                                           Foreground="{x:Bind Name, Converter={StaticResource ContainedTagColor}}"/>
                                <TextBlock Text="✕" FontSize="8" Opacity="0.55" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <Button Content="清除" Click="ClearFilters_Click"
                    Style="{StaticResource SecondaryButton}" Padding="6,2"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 标签云：常显，可连续多选（对齐扩展侧栏 tag 列表）。
                     选中标签后不隐藏，仅在其下方追加「筛选结果」；顶部 chips 同步显示已选。 -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                           MaximumRowsOrColumns="4"
                                           MinColumnSpacing="6" MinRowSpacing="6"
                                           ItemsStretch="None"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TagItemViewModel">
                            <Button Click="Tag_Click" Padding="8,3" CornerRadius="12"
                                    Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource TagSelected}}"
                                    BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource TagSelected}, ConverterParameter='border'}"
                                    BorderThickness="1"
                                    Tag="{x:Bind Name}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind FormattedName}" FontSize="12"
                                               Foreground="{x:Bind Name, Converter={StaticResource ContainedTagColor}}"/>
                                    <TextBlock Text="{x:Bind Count}" FontSize="11" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 空态提示仅在浏览态（未选标签）显示：
                     否则空文本 + 40/16 边距会在筛选结果上方留出大片空白 -->
                <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,40,0,16"
                           Visibility="{x:Bind ViewModel.HasActiveFilter, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                <!-- 标签页是「选择标签区域」：选中后顶部筛选条常显已选标签，
                     筛选结果在导航栏「文件夹」查看（对齐扩展侧栏 tag 列表 + 树）。 -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>