<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="12,12,12,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标签筛选栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    Visibility="{x:Bind ViewModel.HasActiveFilter, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
            <TextBlock Text="{x:Bind ViewModel.ActiveFilterText}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            <Button Content="清除" Click="ClearFilters_Click"
                    Style="{StaticResource SecondaryButton}" Padding="6,2"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- 标签云 -->
            <StackPanel>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="None"
                                           MinColumnSpacing="6" MinRowSpacing="6"
                                           MaximumRowsOrColumns="0"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TagItemViewModel">
                            <Button Click="Tag_Click" Padding="8,3" CornerRadius="12"
                                    Background="{x:Bind IsSelected, Converter={StaticResource TagSelected}}"
                                    BorderBrush="{x:Bind IsSelected, Converter={StaticResource TagSelected}, ConverterParameter='border'}"
                                    BorderThickness="1"
                                    Tag="{x:Bind Name}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind FormattedName}" FontSize="12"
                                               Foreground="{Binding Name, Converter={StaticResource ContainedTagColor}}"/>
                                    <TextBlock Text="{x:Bind Count}" FontSize="11" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock Text="{x:Bind ViewModel.EmptyHint}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" Margin="0,40,0,16"/>

                <!-- 筛选结果 -->
                <TextBlock Text="筛选结果" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8"
                           Visibility="{x:Bind ViewModel.HasActiveFilter, Converter={StaticResource BoolToVis}}"/>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredResults}"
                               Visibility="{x:Bind ViewModel.HasActiveFilter, Converter={StaticResource BoolToVis}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="6"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                            <controls:ItemCard ViewModel="{x:Bind}"
                                               OpenRequested="Card_OpenRequested"
                                               EditNoteRequested="Card_EditNoteRequested"
                                               EditTagsRequested="Card_EditTagsRequested"
                                               HideRequested="Card_HideRequested"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>