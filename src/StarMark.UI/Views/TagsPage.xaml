<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i18n="using:StarMark.UI.Helpers"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:ContainedTagColorConverter x:Key="ContainedTagColor"/>
    </Page.Resources>

    <Grid Background="Transparent" Padding="12,12,12,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 常驻状态条（P-302 甲）：Row 0 槽位恒占、高度钉死——筛选栏出现/消失时标签云点击目标不漂移。
             有筛选：chips 可单 ✕ 移除或一键清除（对齐扩展 tag-banner）；无筛选：同一槽显空态提示。 -->
        <Grid Grid.Row="0" MinHeight="36" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasActiveFilter, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock i18n:LocText.Key="filter.tagTitle" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActiveFilterChips, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TagFilterChip">
                            <Button Click="RemoveFilterChip_Click" Tag="{x:Bind Name}"
                                    Padding="8,2" CornerRadius="10" BorderThickness="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    i18n:LocText.ToolTipKey="filter.tagRemoveTip">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" FontSize="11"
                                               Foreground="{x:Bind Name, Converter={StaticResource ContainedTagColor}}"/>
                                    <TextBlock Text="✕" FontSize="8" Opacity="0.55" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Button i18n:LocText.Key="filter.tagClear" Click="ClearFilters_Click"
                        Style="{StaticResource SecondaryButton}" Padding="6,2" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="EmptyHintText" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.HasActiveFilter, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 标签云：常显，可连续多选（对齐扩展侧栏 tag 列表）。
                     选中标签后不隐藏；顶部状态条同步显示已选，槽位恒占＝云不漂移。 -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal"
                                           MaximumRowsOrColumns="4"
                                           MinColumnSpacing="6" MinRowSpacing="6"
                                           ItemsStretch="None"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TagItemViewModel">
                            <Button Click="Tag_Click" Padding="8,3" CornerRadius="12"
                                    Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource TagSelected}}"
                                    BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource TagSelected}, ConverterParameter='border'}"
                                    BorderThickness="1"
                                    Tag="{x:Bind Name}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind FormattedName}" FontSize="12"
                                               Foreground="{x:Bind Name, Converter={StaticResource ContainedTagColor}}"/>
                                    <TextBlock Text="{x:Bind Count}" FontSize="11" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 空态提示住顶部状态条（与 chips 同一颗恒高槽・P-302 甲）：住云下方会随内容滚走且占大片留白。 -->

                <!-- 标签页是「选择标签区域」：选中后顶部状态条常显已选标签，
                     筛选结果在导航栏「文件夹」查看（对齐扩展侧栏 tag 列表 + 树）。 -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>