<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.CountdownWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels">

    <StackPanel Padding="12,8,12,12" Spacing="6">
        <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" FontSize="11" Opacity="0.6"
                   TextWrapping="Wrap"/>

        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:CountdownRow">
                    <Grid Padding="6,4,4,4" ColumnSpacing="8" Margin="0,1,0,1"
                          Background="{ThemeResource WidgetSubtleFillBrush}" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="12" Opacity="0.8"
                                       TextTrimming="CharacterEllipsis"/>
                            <!-- 到点行与倒数行只差颜色，用两枚互斥可见的文本表达，不去新造画笔转换器 -->
                            <TextBlock Text="{x:Bind Headline, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                                       Visibility="{x:Bind IsDue, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            <TextBlock Text="{x:Bind Headline, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                                       Visibility="{x:Bind IsDue, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock Text="{x:Bind Subline, Mode=OneWay}" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" FontSize="11" Padding="6,0,6,0"
                                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="删除这一条"
                                Click="RemoveRow_Click" Tag="{x:Bind}"/>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Border Height="1" Margin="0,2,0,0" Background="{ThemeResource WidgetDividerBrush}"/>

        <!-- 新建区：日期与时刻分开填（由 CountdownPolicy 校验并给可行动的原因），
             纪念日表示"每年重复"，此时时刻可留空（只看天）。 -->
        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsAdding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBox x:Name="TitleBox" PlaceholderText="名称（留空则按日期自动起名）" FontSize="12"
                     Style="{StaticResource WidgetInputBox}" Padding="8,5,8,5"
                     Text="{x:Bind ViewModel.NewTitle, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="DateBox" PlaceholderText="2026-12-31" FontSize="12" MinWidth="110"
                         Style="{StaticResource WidgetInputBox}" Padding="8,5,8,5"
                         Text="{x:Bind ViewModel.NewDate, Mode=TwoWay}"/>
                <TextBox x:Name="TimeBox" PlaceholderText="09:00" FontSize="12" MinWidth="70"
                         Style="{StaticResource WidgetInputBox}" Padding="8,5,8,5"
                         Text="{x:Bind ViewModel.NewTime, Mode=TwoWay}"/>
            </StackPanel>
            <CheckBox Content="每年重复（纪念日）" FontSize="12" IsChecked="{x:Bind ViewModel.NewYearly, Mode=TwoWay}"/>
            <TextBlock Text="{x:Bind ViewModel.AddError, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="保存" FontSize="11" Padding="10,3,10,3"
                        Style="{StaticResource WidgetActionButton}" Click="SaveNew_Click"/>
                <Button Content="取消" FontSize="11" Padding="10,3,10,3"
                        Style="{StaticResource WidgetActionButton}" Click="CancelAdd_Click"/>
            </StackPanel>
        </StackPanel>

        <Button Content="＋ 新建截止日 / 纪念日" FontSize="11" Padding="10,3,10,3" HorizontalAlignment="Left"
                Style="{StaticResource WidgetActionButton}" Click="BeginAdd_Click"/>
    </StackPanel>
</UserControl>
