<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.ClipboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="Transparent" RowDefinitions="Auto,Auto,*,Auto">

        <!-- 页头：主操作提示（点一条=复制回去）+ 两个即时开关 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="12,12,12,4">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="剪贴板历史" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="点一条 = 再复制回剪贴板（可直接去粘贴）。右键可置顶、加标签、写笔记或删除。"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" x:Name="PauseButton" IsChecked="{x:Bind ViewModel.Paused, Mode=TwoWay}"
                          Content="暂停记录" Checked="Pause_Changed" Unchecked="Pause_Changed"
                          ToolTipService.ToolTip="临时粘贴密码等私密内容时暂停；暂停期间不再记录新内容"/>
            <Button Grid.Column="2" x:Name="ClearButton" Content="清空历史…" Click="Clear_Click"/>
        </Grid>

        <!-- 未开启 / 暂停中：都在这一行照实说明，不要让列表空着让人猜 -->
        <Border Grid.Row="1" Margin="12,4,12,4" Padding="10,8" CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="2" Background="Transparent" Padding="12,4,12,8"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="6"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ItemCardViewModel">
                        <controls:ItemCard ViewModel="{x:Bind}"
                                           OpenRequested="Card_OpenRequested"
                                           PinRequested="Card_PinRequested"
                                           HideRequested="Card_HideRequested"
                                           EditNoteRequested="Card_EditNoteRequested"
                                           EditTagsRequested="Card_EditTagsRequested"
                                           CopyLinkRequested="Card_CopyRequested"
                                           TagFilterRequested="Card_TagFilterRequested"
                                           TagRemoveRequested="Card_TagRemoveRequested"
                                           TagAddRequested="Card_TagAddRequested"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                   Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,20"
                   TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                   Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
    </Grid>
</Page>
