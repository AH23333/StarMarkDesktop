<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.QuickNoteWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels">

    <StackPanel Padding="12,8,12,12" Spacing="6">
        <TextBox x:Name="NoteBox" PlaceholderText="随手记一笔，Ctrl+Enter 保存…" FontSize="12"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                 KeyDown="NoteBox_KeyDown"/>
        <Button Content="保存随记" HorizontalAlignment="Right" Padding="12,3,12,3"
                Click="SaveNote_Click"/>

        <!-- 注意：ItemsRepeater 内部必须用 x:Bind（不能用 {Binding}），否则不报错但静默失效 -->
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickNoteRow">
                    <Border Background="{ThemeResource WidgetSubtleFillBrush}"
                            CornerRadius="6" Padding="8,6,8,6" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Text}" FontSize="11" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="✕" FontSize="9" Padding="5,3,5,3"
                                    Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Top"
                                    Click="DeleteNote_Click" Tag="{x:Bind Id}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
