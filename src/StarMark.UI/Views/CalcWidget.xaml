<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.CalcWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:StarMark.UI.ViewModels">

    <Grid Padding="12,4,12,10">
        <Pivot x:Name="Tabs">
            <!-- ═══════════ 计算 ═══════════ -->
            <PivotItem Header="计算">
                <StackPanel Spacing="8">
                    <TextBox x:Name="ExprBox" PlaceholderText="2*(3+4)^2 · 支持 pi/e/%/千分位"
                             Style="{StaticResource WidgetInputBox}" FontSize="13"
                             Padding="8,6,8,6" TextChanged="ExprBox_TextChanged"
                             KeyDown="ExprBox_KeyDown"/>
                    <TextBlock Text="{x:Bind ViewModel.CalcResult, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="复制结果" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="CopyResult_Click"/>
                        <Button Content="清空" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="ClearExpr_Click"/>
                        <Button Content="清空历史" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="ClearHistory_Click"/>
                    </StackPanel>

                    <Border Height="1" Margin="0,2,0,0" Background="{ThemeResource WidgetDividerBrush}"/>
                    <TextBlock x:Name="HintBlock" Text="" FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock Text="历史（点一下填回输入框）" FontSize="11" Opacity="0.7"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="190">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalcHistoryEntry">
                                    <Button Margin="0,1,0,1" Padding="6,3,6,3" FontSize="11"
                                            HorizontalContentAlignment="Stretch"
                                            Background="{ThemeResource WidgetSubtleFillBrush}"
                                            BorderThickness="0" CornerRadius="4"
                                            Click="HistoryRow_Click" Tag="{x:Bind}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Expression}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Answer}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock x:Name="HistoryEmptyHint" Text="还没有记录：算好后按回车。"
                               FontSize="10" Opacity="0.55" Visibility="Collapsed"/>
                </StackPanel>
            </PivotItem>

            <!-- ═══════════ 换算 ═══════════ -->
            <PivotItem Header="换算">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" FontSize="12"
                              DisplayMemberPath="Label" SelectedIndex="0"
                              ItemsSource="{x:Bind ViewModel.Categories, Mode=OneTime}"
                              SelectionChanged="CategoryBox_SelectionChanged"/>
                    <TextBox x:Name="UnitValueBox" Text="1" FontSize="13"
                             Style="{StaticResource WidgetInputBox}" Padding="8,6,8,6"
                             TextChanged="UnitValueBox_TextChanged"/>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="FromBox" HorizontalAlignment="Stretch" FontSize="12"
                                  DisplayMemberPath="Label" SelectedIndex="0"
                                  ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                                  SelectionChanged="FromBox_SelectionChanged"/>
                        <Button Grid.Column="1" Content="⇄" FontSize="12" Padding="8,2,8,2"
                                Style="{StaticResource WidgetActionButton}" ToolTipService.ToolTip="交换单位"
                                Click="Swap_Click"/>
                        <ComboBox Grid.Column="2" x:Name="ToBox" HorizontalAlignment="Stretch" FontSize="12"
                                  DisplayMemberPath="Label" SelectedIndex="1"
                                  ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                                  SelectionChanged="ToBox_SelectionChanged"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.UnitResult, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="换算率为内置静态表，断网可用；不含实时汇率。"
                               FontSize="10" Opacity="0.55" TextWrapping="Wrap"/>
                </StackPanel>
            </PivotItem>

            <!-- ═══════════ 时间戳 ═══════════ -->
            <PivotItem Header="时间戳">
                <StackPanel Spacing="8">
                    <TextBlock Text="时间戳 → 日期（按位数自动识别秒/毫秒/微秒）"
                               FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                    <TextBox x:Name="StampBox" PlaceholderText="1727000000" FontSize="13"
                             Style="{StaticResource WidgetInputBox}" Padding="8,6,8,6"
                             TextChanged="StampBox_TextChanged"/>
                    <TextBlock Text="{x:Bind ViewModel.StampResult, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap"/>

                    <Border Height="1" Margin="0,2,0,2" Background="{ThemeResource WidgetDividerBrush}"/>

                    <TextBlock Text="日期 → 时间戳" FontSize="11" Opacity="0.7"/>
                    <TextBox x:Name="ClockBox" PlaceholderText="2026-09-23 20:48:12" FontSize="13"
                             Style="{StaticResource WidgetInputBox}" Padding="8,6,8,6"
                             TextChanged="ClockBox_TextChanged"/>
                    <TextBlock Text="{x:Bind ViewModel.ClockResult, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="用此刻" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="UseNow_Click"/>
                        <Button Content="复制秒值" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="CopyStamp_Click"/>
                    </StackPanel>
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
