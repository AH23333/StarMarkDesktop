<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Views.CalcWidget"
    FontSize="12"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:StarMark.UI.Helpers"
    xmlns:vm="using:StarMark.UI.ViewModels">

    <!--
        组件内字号只走这一架梯子：14 主数字 / 13 输入 / 12 正文与下拉 / 11 按钮与小标题 / 10 注释。
        根元素（UserControl）上的 FontSize 是兜底基准：漏写字号的元素继承组件正文 12，而不是 WinUI 的 14。
        页签走 WidgetTabs：WinUI 默认页签是 24px，比组件正文大 80%，真机反馈"字都偏大"就出在那儿。
    -->
    <Grid Padding="12,4,12,10">
        <Pivot x:Name="Tabs" Style="{StaticResource WidgetTabs}">
            <!-- ═══════════ 计算 ═══════════ -->
            <PivotItem i18n:LocText.Key="widget.calc.tabCompute">
                <StackPanel Spacing="8">
                    <TextBox x:Name="ExprBox" i18n:LocText.PlaceholderKey="widget.calc.exprHint"
                             Style="{StaticResource WidgetInputBox}" FontSize="13"
                             Padding="8,6,8,6" TextChanged="ExprBox_TextChanged"
                             KeyDown="ExprBox_KeyDown"/>
                    <TextBlock Text="{x:Bind ViewModel.CalcResult, Mode=OneWay}"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button i18n:LocText.Key="widget.calc.copy" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="CopyResult_Click"/>
                        <Button i18n:LocText.Key="widget.calc.clear" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="ClearExpr_Click"/>
                        <Button i18n:LocText.Key="widget.calc.clearHistory" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="ClearHistory_Click"/>
                    </StackPanel>

                    <Border Height="1" Margin="0,2,0,0" Background="{ThemeResource WidgetDividerBrush}"/>
                    <TextBlock x:Name="HintBlock" Text="" FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock i18n:LocText.Key="widget.calc.historyHint" FontSize="11" Opacity="0.7"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="190">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalcHistoryEntry">
                                    <Button Margin="0,1,0,1" Padding="6,3,6,3" FontSize="11"
                                            HorizontalContentAlignment="Stretch"
                                            Background="{ThemeResource WidgetSubtleFillBrush}"
                                            BorderThickness="0" CornerRadius="4"
                                            Click="HistoryRow_Click" Tag="{x:Bind}">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Expression}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Answer}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock x:Name="HistoryEmptyHint" i18n:LocText.Key="widget.calc.historyEmpty"
                               FontSize="10" Opacity="0.55" Visibility="Collapsed"/>
                </StackPanel>
            </PivotItem>

            <!-- ═══════════ 常用 ═══════════ -->
            <PivotItem i18n:LocText.Key="widget.calc.tabQuick">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="QuickModeBox" HorizontalAlignment="Stretch" FontSize="12"
                              ItemTemplate="{StaticResource LocOptionTemplate}" SelectedIndex="0"
                              ItemsSource="{x:Bind ViewModel.QuickModeOptions, Mode=OneTime}"
                              SelectionChanged="QuickModeBox_SelectionChanged"/>
                    <TextBlock x:Name="QuickHintBlock" Text="" FontSize="10" Opacity="0.6" TextWrapping="Wrap"/>

                    <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 四个槽按模式改标题与占位、用不到的整格收起：
                             与其做四套界面，不如让"要几个填几个"这件事由 Core 的槽表说话。 -->
                        <StackPanel x:Name="QuickCell0" Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="QuickLabel0" FontSize="11" Opacity="0.7"/>
                            <TextBox x:Name="QuickBox0" FontSize="12" Style="{StaticResource WidgetInputBox}"
                                     Padding="8,5,8,5" TextChanged="QuickBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="QuickCell1" Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="QuickLabel1" FontSize="11" Opacity="0.7"/>
                            <TextBox x:Name="QuickBox1" FontSize="12" Style="{StaticResource WidgetInputBox}"
                                     Padding="8,5,8,5" TextChanged="QuickBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="QuickCell2" Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="QuickLabel2" FontSize="11" Opacity="0.7"/>
                            <TextBox x:Name="QuickBox2" FontSize="12" Style="{StaticResource WidgetInputBox}"
                                     Padding="8,5,8,5" TextChanged="QuickBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="QuickCell3" Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="QuickLabel3" FontSize="11" Opacity="0.7"/>
                            <TextBox x:Name="QuickBox3" FontSize="12" Style="{StaticResource WidgetInputBox}"
                                     Padding="8,5,8,5" TextChanged="QuickBox_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.QuickResult, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button i18n:LocText.Key="widget.calc.copy" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="CopyQuick_Click"/>
                        <Button i18n:LocText.Key="widget.calc.clear" FontSize="11" Padding="10,4,10,4"
                                Style="{StaticResource WidgetActionButton}" Click="ClearQuick_Click"/>
                    </StackPanel>
                </StackPanel>
            </PivotItem>

            <!-- ═══════════ 换算 ═══════════ -->
            <PivotItem i18n:LocText.Key="widget.calc.tabConvert">
                <StackPanel Spacing="8">
                    <!-- 本窗四颗下拉都走「数据项＋模板」（批次 WI-55a／55b）：⛔ DisplayMemberPath="Label"——
                         那条路把表里那颗成品字直接搬到屏幕上，换语言那一刻闭着的那一格念的还是旧语言。
                         模板里的 TextBlock 自己带着那颗键，于是它和其他被注册的元素一起重贴（✅WI-2c／✅WI-43）。 -->
                    <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" FontSize="12"
                              ItemTemplate="{StaticResource LocOptionTemplate}" SelectedIndex="0"
                              ItemsSource="{x:Bind ViewModel.CategoryOptions, Mode=OneTime}"
                              SelectionChanged="CategoryBox_SelectionChanged"/>
                    <TextBox x:Name="UnitValueBox" Text="1" FontSize="13"
                             Style="{StaticResource WidgetInputBox}" Padding="8,6,8,6"
                             TextChanged="UnitValueBox_TextChanged"/>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="FromBox" HorizontalAlignment="Stretch" FontSize="12"
                                  ItemTemplate="{StaticResource LocOptionTemplate}" SelectedIndex="0"
                                  ItemsSource="{x:Bind ViewModel.UnitOptions, Mode=OneWay}"
                                  SelectionChanged="FromBox_SelectionChanged"/>
                        <Button Grid.Column="1" Content="⇄" FontSize="12" Padding="8,2,8,2"
                                Style="{StaticResource WidgetActionButton}" i18n:LocText.ToolTipKey="widget.calc.swapUnits"
                                Click="Swap_Click"/>
                        <ComboBox Grid.Column="2" x:Name="ToBox" HorizontalAlignment="Stretch" FontSize="12"
                                  ItemTemplate="{StaticResource LocOptionTemplate}" SelectedIndex="1"
                                  ItemsSource="{x:Bind ViewModel.UnitOptions, Mode=OneWay}"
                                  SelectionChanged="ToBox_SelectionChanged"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.UnitResult, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock i18n:LocText.Key="widget.calc.rateNote"
                               FontSize="10" Opacity="0.55" TextWrapping="Wrap"/>
                </StackPanel>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
