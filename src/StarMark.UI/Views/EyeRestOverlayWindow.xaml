<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StarMark.UI.Views.EyeRestOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarMark.UI.Views">

    <!--
        休息遮罩：一块盖住整屏的暗幕 + 倒数。与截图遮罩不同，这里<b>永远不接键盘</b>——
        幕布不抢焦点（抢了会把用户正在填的表单的打字吞进一扇空窗），而按键只投递给有焦点的窗，
        所以这里挂按键也不会有人送来（"强制休息"那一档的"不可跳过"因此是按构造成立的，不是靠没写代码）。
        鼠标只按档位挂：可跳档点一下就收幕，强制档一条都不挂。
        背景刻意用固定的暗色而不跟主题：幕布在浅色桌面上也要暗得让人读不下去屏幕上的字。
    -->
    <Grid x:Name="Root" Background="#C0000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock
                Text="让眼睛休息一下"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="#FFFFFFFF"
                HorizontalAlignment="Center"/>
            <TextBlock
                x:Name="Countdown"
                Text="20"
                FontSize="76"
                FontWeight="Light"
                Foreground="#FFFFFFFF"
                HorizontalAlignment="Center"/>
            <TextBlock
                x:Name="Hint"
                FontSize="13"
                Foreground="#BFFFFFFF"
                TextWrapping="Wrap"
                MaxWidth="560"
                TextAlignment="Center"
                HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
