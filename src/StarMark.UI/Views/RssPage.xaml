<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.RssPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i18n="using:StarMark.UI.Helpers"
    xmlns:helpers="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <!--
        每个订阅源＝一个可展开/收起的文件夹（样式照「文件夹」页，用户裁决）。
        条目区在代码里按手风琴构建：TreeViewItem/ItemsRepeater 的容器会把 ItemCard 压扁，
        而"展开时才建卡片"是这一页能同时挂几十个源的前提。
        这一页刻意没有搜索框、没有排序下拉（用户裁决）。
    -->
    <Grid Background="Transparent" RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="12,12,12,4">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock i18n:LocText.Key="rss.title" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock i18n:LocText.Key="rss.note"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 这颗按钮的字随"在不在抓"换键（停止抓取 / 刷新），由 code-behind 推给 LocText：
                 带读数的标签⛔不许挂静态键（挂了＝静态那句盖掉带值那句，坑表 #295），
                 而 {x:Bind} 交回拼好的句子又把语言定死在上一次算出的那一刻（#276）。 -->
            <Button Grid.Column="1" x:Name="RefreshButton"
                    VerticalAlignment="Center" Click="Refresh_Click"
                    i18n:LocText.ToolTipKey="rss.refreshTip"/>
            <Button Grid.Column="2" i18n:LocText.Key="rss.sourcesButton" VerticalAlignment="Center" Click="GoSettings_Click"
                    i18n:LocText.ToolTipKey="rss.sourcesTip"/>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="StatusTextText"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="12,4,12,4" VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer Grid.Row="2" x:Name="SourceScroll" Background="Transparent" Padding="12,6,12,12"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="SourceRoot" Spacing="2"/>
        </ScrollViewer>

        <!-- 空态与进度：都放在最后一行，不占走列表的位置（源一多，滚动位置不该被顶掉） -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="12,0,12,20" Spacing="8"
                    Visibility="{x:Bind ViewModel.HasSections, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock x:Name="EmptyHintText" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"/>
            <Button i18n:LocText.Key="rss.switchButton" HorizontalAlignment="Center" Click="GoSettings_Click"
                    Visibility="{x:Bind ViewModel.Enabled, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
        </StackPanel>

        <ProgressRing Grid.Row="3" x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" Margin="0,0,0,12"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Page>
