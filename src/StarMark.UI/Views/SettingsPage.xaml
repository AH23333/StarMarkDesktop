<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.SettingsPage"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    xmlns:local="using:StarMark.UI.Views"
    xmlns:ab="using:StarMark.Abstractions.Insights"
    xmlns:diag="using:StarMark.Core.Diagnostics"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- 设置项内部：左「标题 + 说明」，右「控件」，避免一侧大片空白 -->
        <Style x:Key="SettingRowText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 设置页分类标签不可关闭（无关闭符号） -->
        <Style TargetType="TabViewItem">
            <Setter Property="IsClosable" Value="False"/>
        </Style>

        <!-- 快捷键单行模板（按分类折叠到多级菜单中复用） -->
        <DataTemplate x:Key="HotkeyRowTemplate" x:DataType="local:HotkeyRow">
            <Grid Margin="0,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ActionName}" VerticalAlignment="Center"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <Button Grid.Row="0" Grid.Column="1"
                        Content="{x:Bind BindingText, Mode=OneWay}"
                        Tag="{x:Bind Action}"
                        Click="RecordButton_Click"
                        MinWidth="210" MinHeight="32" HorizontalAlignment="Right"
                        Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButton}"/>

                <!-- 冲突提示：不弹窗，就地标注（用户可直接忽略） -->
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,2,0,0"
                           Text="{x:Bind ConflictText}" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="320" HorizontalAlignment="Right"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="{x:Bind HasConflict, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                <!-- 组合键此刻被别的程序占用：这是"提示"不是"注册被拒绝"（绑定已保存、程序在自动重试），
                     所以用与冲突标注同一 tone 的 caution 色，而不是 critical 红。 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2,0,0"
                           Text="{x:Bind RegisterErrorText}" FontSize="11" TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="{x:Bind HasRegisterError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 背景透明：让主窗口的半透明毛玻璃背衬透出，否则不透明的设置页会盖住主窗口材质，
         导致「常规 → 外观」里切材质或拖「背景不透明度（仅纯色）」看不出即时效果。
         主窗口关闭半透明（实色）时 RootGrid 自身已铺实色，透明页同样能正常显示。 -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 + 右上角「返回」（设置改动实时生效，不再需要底部保存按钮） -->
        <Grid Grid.Row="0" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <!-- 设置改动实时生效、没有底部保存按钮，因此"没保存成功"这种反面事实必须自己露头，
                     否则用户唯一能发现的时间点是下次启动设置悄悄回退（P-53）。 -->
                <TextBlock Text="{x:Bind ViewModel.SaveErrorMessage, Mode=OneWay}"
                           FontSize="12" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="{x:Bind ViewModel.HasSaveError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="返回" Click="Back_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </Grid>

        <TabView x:Name="SettingsTabs" Grid.Row="1"
                 Margin="24,12,24,0"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent"
                 Background="Transparent">

            <!-- ============ 常规 ============ -->
            <TabViewItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <!-- 自适应分栏：宽屏两列铺满，窄屏自动单列 -->
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- 主题 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="主题" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" Text="跟随系统 / 浅色 / 深色" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" MinWidth="180" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="浅色"/>
                                        <ComboBoxItem Content="深色"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 外观：主窗口材质（macOS 风；组件材质住在「桌面工具（组件）」页） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="外观 · 主窗口材质与不透明度" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="给主窗口选毛玻璃材质（照搬 DeskBox 的 Desktop Acrylic / Mica 控制器）。桌面组件的材质与不透明度在「桌面工具（组件）」页，两者互不影响。"
                                           Style="{StaticResource SettingRowText}"/>


                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="主窗口材质"/>
                                        <TextBlock Text="桌面组件的材质在「桌面工具（组件）」页单独设置，两边互不影响；选「实色」即不透明。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <!-- 顺序即枚举值，与「组件材质」一致：0=亚克力(薄) 1=云母 2=实色 3=云母Alt 4=亚克力(厚) 5=纯色 -->
                                    <ComboBox Grid.Column="1" MinWidth="200" SelectedIndex="{x:Bind ViewModel.MainWindowBackdropIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="亚克力 · 薄（推荐，苹果风格）"/>
                                        <ComboBoxItem Content="云母 · Mica（更克制的桌面色调）"/>
                                        <ComboBoxItem Content="实色（省资源，不使用材质）"/>
                                        <ComboBoxItem Content="云母 · Alt（取更多桌面壁纸色调）"/>
                                        <ComboBoxItem Content="亚克力 · 厚（更浓的霜化，隐私更好）"/>
                                        <ComboBoxItem Content="纯色 · Solid（带强调色，可调不透明度）"/>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="主窗口背景不透明度（仅纯色材质）"/>
                                        <TextBlock Text="只影响主窗口的「纯色 · Solid」材质，与组件互不影响；其余材质用各自固定的透明度性格。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.OpacityFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.OpacityCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.OpacityStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.MainWindowOpacity, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.MainWindowOpacityPercentText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 托盘与呼出 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="托盘与呼出" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="开机自动启动 StarMark"/>
                                        <TextBlock Text="登录 Windows 后自动常驻，不必每次手动打开。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle" OnContent="开启" OffContent="关闭"
                                                  MinWidth="0" Toggled="AutostartToggle_Toggled"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="常驻系统托盘"/>
                                        <TextBlock Text="关闭时隐藏到托盘，进程常驻。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EnableTray, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="启用全局快捷键"/>
                                        <TextBlock Text="总开关；关闭时所有快捷键均不生效。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EnableGlobalHotKey, Mode=TwoWay}"
                                                  Toggled="EnableGlobalHotKey_Toggled"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="关闭窗口时最小化到托盘"/>
                                        <TextBlock Text="关闭主窗口不退出程序。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GitHub -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="GitHub Stars 同步" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Personal Access Token（可选，仅需 public_repo）" Style="{StaticResource SettingRowText}"/>
                                        <!-- 用 PasswordBox 而不是 TextBox（批次 UI，P-146）：TextBox 的内容在 UIA 树里
                                             就是可读的 Value，读屏、自动化、截图都能把 Token 带走，而且不需要权限。
                                             PasswordBox 的 Password 不可绑定（WinUI 刻意如此），所以这一格改走
                                             SettingsPage.xaml.cs 里那一对读写，与同一页的「AI API Key」同形。 -->
                                        <PasswordBox x:Name="GithubTokenBox" PlaceholderText="ghp_..."
                                                     PasswordChanged="GithubTokenBox_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="用户名（可选，用于显示）" Style="{StaticResource SettingRowText}"/>
                                        <TextBox PlaceholderText="octocat" Text="{x:Bind ViewModel.GithubUsername, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 关于与更新（批次 UE 检测，UG-3 才接上「立即更新」）：
                             自动那一发仍然只问版本、不下载；装新版只有点那一下才会发生。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="关于与更新" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="当前版本"/>
                                        <TextBlock Text="这份产物是哪一个版本；构建时间在「健康与诊断」页的「诊断」里。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.LocalVersionText, Mode=OneWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="每天自动检查一次"/>
                                        <TextBlock Text="自动那一发只问「这个仓库发布了哪一版」：不下载、不改动本机文件，也不替换正在运行的程序。关掉这个开关后，只有点「立即检查」那一下才会联网。装新版是另一件事——只有点「立即更新」才真的下载并替换（换不成会自动退回原来那一版）。"
                                                   Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.UpdateAutoCheckEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="UpdateCheckButton" Content="立即检查" Click="UpdateCheck_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                    <!-- 与「打开下载页」同时出现，但排在它前面：能自动装的时候，把人支去浏览器是多余的一步 -->
                                    <Button x:Name="UpdateApplyButton" Content="立即更新" Click="UpdateApply_Click"
                                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                                    <!-- 只有「确实有一版更新」才出现：在"还没有发布过"那一格放一颗下载按钮，等于承诺了一个不存在的产物 -->
                                    <Button x:Name="UpdateOpenPageButton" Content="打开下载页" Click="UpdateOpenPage_Click"
                                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ AI 增强（要接外部服务或本机模型才成立的功能：从「常规」拆出，用户裁决） ============ -->
            <TabViewItem Header="AI 增强">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!--
                            AI 助手（批次 A：只到"通道能不能用"，批量整理在批次 B）。
                            默认关闭且不发任何请求：这功能要把库里的标题与摘要交给一个外部进程或外部服务，
                            未明确开启前不得处于工作状态。
                            刻意做成"一格一改就地保存 + 状态常驻"：这一栏的每一项都要能立刻看出还差什么，
                            攒到按「保存」时才校验是扩展项目返工过的形状。
                        -->
                        <!-- 先讲清"要填的三样各是什么、Key 去哪拿"：以前只有字段名，第一次配的人不知道该填什么，
                             填错了又只看到"连接失败"，等于把文档藏进了试错里。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="这三样分别要填什么" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="服务商地址（Base URL）＝用哪家的接口，也可以填自建或兼容 OpenAI 协议的网关地址；API Key＝那家公司发给你的一串secret，用来认账和计费，等同密码——别贴进聊天群，也不要提交进仓库；模型名＝具体调哪个模型，决定能力与价格。三项填好按「测试连接」，程序会真的发一次请求验证，不通过就把原因写在旁边，不会静默失败。"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="DeepSeek：platform.deepseek.com 注册 → 进「API Keys」→ 新建 → 当场复制（页面刷新后就再也看不见全文）。Base URL 填 https://api.deepseek.com ，模型名填 deepseek-chat 。"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="月之暗面 Kimi：platform.moonshot.cn 注册 → 左侧「API 管理」→ 创建 API Key。Base URL 填 https://api.moonshot.cn/v1 ，模型名照官网列的填（如 kimi-k2-0905-preview）。"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="智谱 GLM：open.bigmodel.cn 注册并实名 → 「API Keys」→ 添加新的 API Key。Base URL 填 https://open.bigmodel.cn/api/paas/v4 ，模型名如 glm-4-plus 。"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="OpenAI：platform.openai.com 登录 → Settings → API keys → Create new secret key。Base URL 填 https://api.openai.com/v1 ，模型名如 gpt-4o-mini 。需要海外支付方式，公司网络常拦这个域名。"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="本地或自建（Ollama、LM Studio、vLLM 等）：Base URL 填本机地址（如 http://localhost:11434/v1 ），API Key 多数实现要求非空但内容随意，模型名填本地已拉取的那个。"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="不配 Key 也能用这个软件：AI 只负责「批量整理标签」这一件事。没配好时那条功能会明确灰着并说明原因，不会连累别的功能，也不会不打招呼就联网发数据。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="AI 助手" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="把模型通道接进来。本机装了 Ollama 就选 Ollama（不需要任何 Key）；有别的 OpenAI 兼容端点（各类代理、LM Studio 的开放服务）也可以填地址与 Key。这一批只提供通道与「测试连接」，用 AI 批量整理标签的入口在下一批接上。"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="启用 AI 助手" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="AiEnabledToggle" OnContent="开" OffContent="关" MinWidth="0"
                                                  Toggled="AiEnabled_Toggled"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0" x:Name="AiProviderBox" Header="通道" HorizontalAlignment="Stretch"
                                              SelectionChanged="AiProvider_SelectionChanged"/>
                                    <TextBox Grid.Column="1" x:Name="AiModelBox" Header="模型名"
                                             PlaceholderText="如 qwen2.5:7b（要与服务侧列表一致）"
                                             FontSize="12" TextChanged="AiField_TextChanged"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <TextBox Grid.Column="0" x:Name="AiOllamaUrlBox" Header="Ollama 地址"
                                             PlaceholderText="留空＝http://127.0.0.1:11434"
                                             FontSize="12" TextChanged="AiField_TextChanged"/>
                                    <TextBox Grid.Column="1" x:Name="AiBaseUrlBox" Header="OpenAI 兼容端点（填到 /v1）"
                                             PlaceholderText="留空＝https://api.openai.com/v1"
                                             FontSize="12" TextChanged="AiField_TextChanged"/>
                                </Grid>
                                <PasswordBox x:Name="AiKeyBox" Header="API Key（选 Ollama 时不必填）"
                                             FontSize="12" PasswordChanged="AiField_TextChanged"/>

                                <!-- 分类专用模型（§19 O6）：留空就沿用上面那个模型名，填了只影响打标这一路。 -->
                                <TextBox x:Name="AiClassifyModelBox" Header="分类模型名（留空＝沿用上面的模型）"
                                         HorizontalAlignment="Stretch" PlaceholderText="如 qwen2.5:1.5b"
                                         FontSize="12" TextChanged="AiField_TextChanged"/>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="AiProbeButton" Content="测试连接" Click="AiProbe_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                    <!-- 只有"通了但模型名不对"时才出现：把服务侧的名字递过去，不让用户抄一遍 -->
                                    <Button x:Name="AiFillModelButton" Content="改用本机有的模型" Click="AiFillModel_Click"
                                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock x:Name="AiStatusText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="还没测过。" Opacity="0.72"/>

                                <!--
                                    批量整理。"开始"只有一个入口（扩展教训：两个功能重叠的按钮引发多次返工），
                                    就放在通道配置下面——通道没接通时这里点了也只会在状态行给出原因。
                                    旁边那颗「停止」不是第二个入口，是同一段忙碌的出口：只在忙的时候现身。
                                -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <NumberBox Grid.Column="0" x:Name="AiScopeBox" Header="整理多少条还没有标签的条目"
                                               Minimum="1" Maximum="500" SmallChange="10" LargeChange="50" SpinButtonPlacementMode="Compact"
                                               Value="100" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1" x:Name="AiOrganiseButton" Content="开始整理" Click="AiOrganise_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/>
                                    <!--
                                        停止单独一颗，忙的时候才现身（把"开始"就地变成"暂停"这种一次点击两件事的
                                        按钮，用户在忙的那一刻不确定自己按下的是哪一个——扩展侧最终也收敛到这里）。
                                    -->
                                    <Button Grid.Column="2" x:Name="AiStopButton" Content="停止" Click="AiStop_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                    <Button Grid.Column="3" x:Name="AiApplyAllButton" Content="全部应用" Click="AiApplyAll_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" IsEnabled="False"/>
                                </Grid>

                                <!-- 三格只读展示（批次 R4）：数字全部从代码里的常数来，界面不写第二份。 -->
                                <TextBlock x:Name="AiBatchLimitsText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <TextBox x:Name="AiTimeoutBox" Header="单批超时（秒，留空＝走默认）" HorizontalAlignment="Stretch"
                                         FontSize="12" TextChanged="AiTimeoutBox_TextChanged"/>
                                <TextBlock x:Name="AiTimeoutNoteText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <Button x:Name="AiResumeButton" Content="继续处理上次整理好的结果" Click="AiResume_Click"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Visibility="Collapsed"/>

                                <!--
                                    token 预算与用量（§20.1/§20.2）。判额、熔断、展示三家读同一份账本
                                    （AiClassifyService.BudgetVerdictAsync 是唯一裁决口），这里只画结论。
                                    「应用预算」独立一颗：改档位是显式动作，不随其它控件的自动写盘走顺带。
                                -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <NumberBox Grid.Column="0" x:Name="AiBudgetBox" Header="月度 token 预算（到线自动暂停，手动恢复）"
                                               Minimum="10000" Maximum="100000000" SmallChange="10000" LargeChange="50000"
                                               SpinButtonPlacementMode="Compact" Value="500000" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1" x:Name="AiBudgetApplyButton" Content="应用预算" Click="AiBudget_Save_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="2" x:Name="AiBudgetUnpauseButton" Content="恢复 AI" Click="AiBudget_Unpause_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                </Grid>

                                <!-- 预警比例（批次 R4）：到线不拦，只把话说明白；留空＝出厂值。 -->
                                <TextBox x:Name="AiWarnRatioBox" Header="预警比例（%，留空＝走默认）" HorizontalAlignment="Stretch"
                                         FontSize="12" TextChanged="AiWarnRatioBox_TextChanged"/>
                                <TextBlock x:Name="AiWarnRatioNoteText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <TextBlock x:Name="AiUsageText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Text="用量还没读。" Opacity="0.72"/>

                                <!--
                                    预览以"组"为单位：三百条逐个看是没人会做的复核，
                                    而"这六条打同一组标签"一眼就能判断对不对。
                                -->
                                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AiGroupList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,3,0,3">
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="{Binding TagLine}" FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ItemLine}" FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="应用这组" Click="AiApplyGroup_Click" Tag="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="不要" Click="AiIgnoreGroup_Click" Tag="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 组件 ============ -->
            <TabViewItem Header="桌面工具（组件）">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="桌面工具（组件）" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="在桌面添加独立小组件：下方按类型折叠，标题直接写明「已添加 N 个 / 未添加」，展开后才是添加与各实例的显示 / 移除。组件可拖动、边缘吸附、置顶、缩放；标题栏 ✕ 只是移除，随时可在此或托盘菜单重新添加。"
                                           Style="{StaticResource SettingRowText}"/>
                                <StackPanel x:Name="WidgetRows" Spacing="2" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button x:Name="WidgetShowAllButton" Content="全部显示" Style="{StaticResource SecondaryButton}" Click="WidgetShowAll_Click"/>
                                    <Button x:Name="WidgetHideAllButton" Content="全部隐藏" Style="{StaticResource SecondaryButton}" Click="WidgetHideAll_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 「开机自动加载组件」（用户裁决：这笔性能取舍由他自己选，别替他决定桌面长什么样）。
                             默认开＝今天的观感。关掉的收益是实测出来的（每颗组件窗的私有成本，见 Core 的
                             WidgetStartupPolicy 与报告 §二百一十），而"先建再关"退不回来（§二百零九量过），
                             所以只能走"不建"这一侧。数字不在这里重抄一遍——下面那行说明绑的是政策那颗。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="开机自动加载组件" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="关掉后开机不再把这些小窗口摆到桌面上，省下的内存按颗算（下面那行写着每颗约多少）。已添加的组件不会丢，随时可就地点亮。"
                                               Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="加载" OffContent="不加载" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.WidgetsLoadOnStartup, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.WidgetsLoadHint, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 组件外观（从「常规 · 外观」搬来）：用户裁决——改组件的东西就该住在组件页，
                             常规页只留主窗口自己的外观。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="组件外观 · 材质与不透明度" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="为桌面组件选毛玻璃材质；这一页只管组件，主窗口的材质在「常规」页，两者互不影响。"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="组件材质"/>
                                        <TextBlock Text="亚克力最像 macOS；云母更克制；纯色带强调色且吃不透明度；实色最省资源（对齐 DeskBox 六种材质）。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <!-- 顺序即枚举值：0=亚克力(薄) 1=云母 2=实色 3=云母Alt 4=亚克力(厚) 5=纯色，追加新项不影响已保存的设置 -->
                                    <ComboBox Grid.Column="1" MinWidth="200" SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="亚克力 · 薄（推荐，苹果风格）"/>
                                        <ComboBoxItem Content="云母 · Mica（更克制的桌面色调）"/>
                                        <ComboBoxItem Content="实色（省资源，不使用材质）"/>
                                        <ComboBoxItem Content="云母 · Alt（取更多桌面壁纸色调）"/>
                                        <ComboBoxItem Content="亚克力 · 厚（更浓的霜化，隐私更好）"/>
                                        <ComboBoxItem Content="纯色 · Solid（带强调色，可调不透明度）"/>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="组件背景不透明度（仅纯色材质）"/>
                                        <TextBlock Text="只影响桌面组件的「纯色 · Solid」材质：越低越透、能看见桌面壁纸。主窗口的不透明度在「常规」页单独设置。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.OpacityFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.OpacityCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.OpacityStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.WidgetOpacity, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.OpacityPercentText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 边缘磁吸 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="边缘磁吸" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" Text="拖动 / 缩放时自动吸附对齐" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EnableWidgetSnap, Mode=TwoWay}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="磁吸强度"/>
                                        <TextBlock Text="距其它组件边线 / 屏幕边缘多近就贴上（像素）。数值越大越容易吸住，越大手感越「粘」；调小则更接近自由摆放。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.SnapStrengthFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.SnapStrengthCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.SnapStrengthStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.SnapStrength, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.SnapStrengthText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="对齐间距"/>
                                        <TextBlock Text="吸住之后组件之间保留的缝隙（像素）。0＝边边紧贴，越大排得越松。" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.SnapSpacingFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.SnapSpacingCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.SnapSpacingStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.SnapSpacing, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.SnapSpacingText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="开启后：拖动组件会与其它组件的边线、屏幕边缘自动贴合；调整边缘时会同步对齐宽 / 高，让参差不齐的组件一次拉齐。想自己随手摆放就关掉它。"
                                           Style="{StaticResource SettingRowText}"/>
                            </StackPanel>
                        </Border>

                        <!-- 性能模式 / 内存门禁 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="性能模式 / 内存门禁" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="常驻应用按预算回收内存与缓存（DeskBox 同款 MemoryReclaimer）。低内存机器选「省资源」；需要精细控制选「自定义」。"
                                           Style="{StaticResource SettingRowText}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" Text="性能模式" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" MinWidth="200" SelectedIndex="{x:Bind ViewModel.PerformanceModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="均衡（默认，体验优先）"/>
                                        <ComboBoxItem Content="省资源（低内存 / 笔记本）"/>
                                        <ComboBoxItem Content="自定义"/>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"
                                      Visibility="{x:Bind ViewModel.CustomBudgetVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="进程内存预算（MB）"/>
                                        <TextBlock Text="超过即触发回收" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <!-- 范围与步进绑判据（批次 SA，P-123 第 3 条）：这里曾写死 32–2048 / 16–1024，
                             而仓储允许到 4096 ⇒ 存档里合法且在生效的预算在这根条子上表达不出来。 -->
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.BudgetMbFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.BudgetMbCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.BudgetMbStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.CacheBudgetMb, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="56"
                                                   Text="{x:Bind ViewModel.CacheBudgetText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"
                                      Visibility="{x:Bind ViewModel.CustomBudgetVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="缓存最大条目数"/>
                                        <TextBlock Text="图片 / 头像等有界缓存上限" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.CacheCountFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.CacheCountCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.CacheCountStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.MaxCacheCount, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.MaxCacheCount, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 布局方案 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="布局方案" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="在组件窗口标题栏点右键 →「保存当前组件布局…」即可把这一屏存为纯模板：各组件的位置、大小与外观配置（不含条目内容数据）。同一时刻只会显示一套布局，切换快捷键可在「快捷键」标签页录制。"
                                           Style="{StaticResource SettingRowText}"/>
                                <ItemsRepeater ItemsSource="{x:Bind LayoutRowsItems, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:WidgetLayoutRow">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource MutedText}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="应用"
                                                        Tag="{x:Bind Id}" Click="ApplyLayout_Click"
                                                        Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                                <Button Grid.Column="2" Content="删除"
                                                        Tag="{x:Bind Id}" Click="DeleteLayout_Click"
                                                        Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Text="（暂无保存的布局）" Style="{StaticResource MutedText}"
                                           Visibility="{x:Bind HasNoLayouts, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 拓展功能（可以整个不用、也不影响主流程的浏览面：热榜与订阅源） ============ -->
            <TabViewItem Header="拓展功能">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- GitHub 热榜（默认关；关时导航栏连「热榜」项都不显示——用户裁决的可选浏览面） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="GitHub 热榜" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="开启后导航栏「剪贴板」右侧出现「热榜」。抓取只在你打开那一页时发生（每个周期每天至多一次，失败时回读上次结果并说明）；条目默认不进库——点 ⭐ 才是给 GitHub 远端加星（需 Token），点 🔖 才存进本机收藏。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.TrendingEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.TrendingStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="在「今日速览」组件里显示热榜块（默认日榜）；关掉则该块消失、原「常看」回到顶部。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="显示" OffContent="不显示" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.TrendingGlanceEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="热榜页上选的周期会记住，下次打开还是那一档。没配 Token 也能浏览热榜（读侧不依赖 Token），只是 Star 按钮会提示要配 Token。"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" Opacity="0.62" FontSize="12"/>
                                <!-- 就地入口：刚开启的人多半想立刻看一眼，不该让他自己回导航栏找那一项 -->
                                <Button Content="打开热榜页" Click="OpenTrending_Click" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.TrendingEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!--
                            网址来源（RSS / Atom）：这一栏只管"有哪些源、每个开不开、这一栏整体开不开"。
                            批次 RB 之前条目预览也住在这里，用户裁决要挪走——设置页是改配置的地方，
                            挑文章是另一件事；两件事挤在一屏就长成了"设置页里嵌了个阅读器"的怪形状。
                        -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="网址来源（RSS / Atom）" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="开启后导航栏出现「RSS」：每个订阅源是它自己的一个文件夹，点条目直接在浏览器打开文章，点「收藏到文件夹」才会进本机库（并放进这个源自己的那一层）。抓取只在你到那一页按「刷新」时发生，没有后台定时。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.RssEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.RssStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <TextBlock x:Name="RssSourceEmpty" Text="还没有添加任何来源地址。" Opacity="0.62"
                                           Style="{StaticResource SettingRowText}"/>
                                <ItemsControl x:Name="RssSourceRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2,0,2">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" OnContent="启用" OffContent="停用" MinWidth="0"
                                                              IsOn="{Binding Enabled, Mode=OneTime}" Tag="{Binding}"
                                                              Toggled="RssSource_Toggled"/>
                                                <Button Grid.Column="2" Content="删除" Click="RssDelete_Click" Tag="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="6">
                                    <TextBox Grid.Column="0" x:Name="RssUrlBox" PlaceholderText="订阅地址（https://…/feed）"
                                             FontSize="12" HorizontalAlignment="Stretch"/>
                                    <TextBox Grid.Column="1" x:Name="RssNameBox" PlaceholderText="名字（留空＝用域名）"
                                             FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" Content="添加" Click="RssAdd_Click" Style="{StaticResource SecondaryButton}"/>
                                </Grid>
                                <!-- 就地入口：刚配好源的人多半想立刻看一眼，不该让他自己回导航栏找那一项 -->
                                <Button Content="打开 RSS 页" Click="OpenRss_Click" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.RssEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- 本地磁盘搜索（从「数据」页搬来，用户裁决：可整个关掉、且要靠外部引擎才成立的能力
                             住「拓展功能」；关掉时它一个字节都不写，开着时「引擎在哪、占多大、怎么删」也在这同一张卡里说清） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="本地磁盘搜索" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="开启后可像 Everything 一样全盘秒搜本地文件，结果并入快捷搜索 / 主窗搜索。首次开启会自动准备 Everything（可能需要一次 UAC）。"
                                               Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.LocalDiskSearchEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.LocalDiskSearchStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <!-- 准备失败原先只留一句「请确认 Everything 正在运行后稍候再试」／「请用开始菜单以管理员身份运行」，
                                     等于把程序自己能做的动作写成用户作业。改为就地按钮，点的就是同一段准备代码（P-54）。 -->
                                <Button Content="{x:Bind ViewModel.LocalDiskSearchRetryLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.RetryLocalDiskPrepareCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.CanRetryLocalDiskPrepare, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!-- 自带引擎管理：占用大小 + 打开所在目录 + 删除（误删无妨，下次开启自愈式重下） -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="本地搜索引擎占用" Style="{StaticResource SettingRowText}"/>
                                        <TextBlock x:Name="EngineSizeText" Text="—" Style="{StaticResource SettingRowText}" Opacity="0.7"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开所在目录" Click="OpenEngineFolder_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="删除" Click="DeleteEngine_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="删除只清理本地搜索引擎（Everything 及其 SDK），书签 / Star / 标签数据不受影响；即使误删，下次开启本地磁盘搜索会自动重新下载。"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" Opacity="0.62" FontSize="12"/>
                                <!-- 「索引进库」那一整块（目录多行框＋每目录上限＋保存按钮＋不可用目录提示）
                                     已按用户裁决拆掉（批次 VQ）：那颗按钮只把配置落盘，真进库要等顶栏「同步」，
                                     而"引擎没跑／没配目录／目录当前不存在／IPC 返回半截"四条出口全都无声，
                                     同步完还无条件弹一句「索引同步完成」⇒ 用户读作"已进库"，实际一条没有。
                                     实时全盘搜索（快捷搜索 / 主窗搜索里的本地文件）不受影响——那是另一条链。 -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <!-- 这句话的可见性只管"有没有话要说"（含扫描失败与"都还在"两种），
                                         不跟"有没有可删的行"绑——否则失败那句会被一起藏掉。 -->
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.MissingFileRowsStatus, Mode=OneWay}"
                                               Style="{StaticResource SettingRowText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{x:Bind ViewModel.HasMissingFileRowsNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                    <!-- 库里那些"盘上已经没有"的行：今天删得掉了（批次 VQ 把删除这一族对本机文件条目放开），
                                         也说得出口了。这里给一次点清的能力，但不替用户悄悄删——见 VM 上那段理由。 -->
                                    <Button Grid.Column="1" Content="清掉这些行" VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{x:Bind ViewModel.CleanMissingFilesCommand}"
                                            Visibility="{x:Bind ViewModel.HasMissingFileRows, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Button Content="重新扫描本机文件条目" Command="{x:Bind ViewModel.RescanMissingFilesCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!--
                            截屏总开关（批次 RP）：发起人点名"需要将截屏功能总开关放入拓展功能设置页"。
                            这条只管"<b>能不能再发起一次框选</b>"：那三条入口的热键与托盘项一起收，
                            已经贴在桌面上的图不受影响（显隐／忽略鼠标照常可用）——
                            判据在 Core 的 CaptureGate（热键注册投影、托盘、ScreenshotService 三个读者共用它），
                            这一处只是它的第四个读者；具体键位由 ViewModel 从当前绑定现取，这里不写死任何一颗键。
                        -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="截屏（截图 / 贴图 / 识字）" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="关掉之后：那三条发起框选的全局热键不再向系统注册（键位交还给当前窗口），托盘里的「截图 / 贴图 / 识字」三项一并消失。已经钉在桌面上的贴图不受影响——显示／隐藏、忽略鼠标、关闭全部照常可用。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.CaptureEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.CaptureStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!--
                            屏幕画布（批次 WD-5）：发起人点名"这块设置要和画布上那颗 ⌨ 一样能随时看到，
                            并在主窗口设置的拓展功能里做同样的开关（功能一致即可，样式各自适应）"。
                            键位那一览是生成的：写死一份迟早和注册表分岔，分岔的症状是"照着说明按，没反应"。
                        -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="屏幕画布" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="讲解时直接在屏幕上画（不冻结画面）。进入后是穿透态：PPT 翻页、点下层应用都不受影响，选「画笔」或按住 Ctrl+Alt 拖动才留痕。关掉之后托盘里这一项一并消失，画布内的九条快捷键也不再占用系统组合键。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.CanvasEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.CanvasStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="截图带画布：开着时，截屏抓到的那一帧包含画布上的笔迹（所见即所得）。关掉后截图前会先把那块玻璃收起来再抓、抓完立刻放回——画布上画的东西一点不少，只是截走的图里没有它。画布工具条上的「贴图／复制／存图」不受这条影响（那三条本来就是要把笔迹留下）。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="带上" OffContent="不带" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.CanvasInScreenshots, Mode=TwoWay}"/>
                                </Grid>
                                <!--
                                    光标那块圆的半径（批次 RN，应发起人点名"屏幕画布设置需要实现光晕半径调节设置"）。
                                    一根滑杆、两块圆：幕布开着时这个半径就是亮区大小，关着时就是那团光的大小——
                                    批次 S4-⑥ 已经把两块合成一块，拆成两根滑杆等于把那次合并重新拆开。
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="光标那块圆多大"/>
                                        <TextBlock Text="画布上跟着光标的那团光，与「幕布」开着时鼠标周围那块亮区，用的是同一个半径（一根滑杆管两块圆）。单位是 DIP（与缩放无关的逻辑像素）：150% 的屏上实际像素数会是它的 1.5 倍。拖动立刻生效，不用点保存、不用重启。"
                                                   Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="40" Maximum="400" StepFrequency="10" Width="150"
                                                Value="{x:Bind ViewModel.CursorCircleRadiusDip, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="60"
                                                   Text="{x:Bind ViewModel.CursorCircleRadiusText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="快捷键一览（下面是当前真正生效的键位；要改到「快捷键」页的「屏幕画布」分组）"
                                           Style="{StaticResource SettingRowText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <!--
                                    批次 RO：这张表过去是一整块拼好的多行字符串（名字 + 全角空格 + 键位）。
                                    那样渲染出来是十个左对齐的段落——键位的起点跟着名字长度跑，十行没有一个共同的右界，
                                    卡片右侧那一大片始终空着（发起人原话："文字全部挤在一起，而右侧却有很大空间"）。
                                    现在一行两个字段、名字那列吃掉剩余宽度，键位贴右缘，才成其为一张表。
                                -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CanvasHotkeyRows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:CanvasHotkeyRow">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center"
                                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Gesture}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontFamily="Consolas" Opacity="0.9"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 快捷键 ============ -->
            <TabViewItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="460" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="全局快捷键" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="点击右侧按钮开始录制：按钮文字会清空并实时显示你按下的按键，最多 3 个键；录满 3 个键自动结束，只录了 1~2 个键时按 Esc 结束录入（一个键都没录时按 Esc 取消）。"
                                           Style="{StaticResource SettingRowText}"/>
                                <TextBlock Text="录制结束不会立即生效——必须点击「保存快捷键」后才注册生效（避免刚录完「隐藏主界面」就把窗口藏了）。Backspace / Delete 可清除该动作。"
                                           Style="{StaticResource SettingRowText}"/>
                                <TextBlock Text="同一组合可绑定多个动作——触发时会依次执行（例如一次同时呼出主界面并显示所有组件），这是允许的「冲突」，只会在动作右侧标记，你可以直接忽略。"
                                           Style="{StaticResource SettingRowText}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button Content="保存快捷键" Click="SaveHotkeys_Click"
                                            IsEnabled="{x:Bind HasUnsavedHotkeys, Mode=OneWay}"
                                            Style="{StaticResource AccentButton}"/>
                                    <Button Content="撤销更改" Click="DiscardHotkeys_Click"
                                            IsEnabled="{x:Bind HasUnsavedHotkeys, Mode=OneWay}"
                                            Style="{StaticResource SecondaryButton}"/>
                                    <Button Content="恢复默认快捷键" Click="ResetHotkeys_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                                <TextBlock Text="⚠ 有未保存的快捷键改动，点击「保存快捷键」后才会生效。"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource SettingRowText}"
                                           Visibility="{x:Bind HasUnsavedHotkeys, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!-- 注册失败原先只写一行日志，界面照旧显示"已设置"⇒ 给原因 + 就地重试 -->
                                <TextBlock Text="{x:Bind RegisterErrorSummary, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Style="{StaticResource SettingRowText}"
                                           Visibility="{x:Bind HasRegisterErrors, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="重试注册" Click="RetryHotkeyRegister_Click" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}"
                                        Visibility="{x:Bind HasRegisterErrors, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!-- 钩子装不上＝一个键都收不到；原先只写日志，界面却仍进入"正在录制"并清空按钮文字 -->
                                <TextBlock Text="{x:Bind RecordingAlert, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Style="{StaticResource SettingRowText}"
                                           Visibility="{x:Bind HasRecordingAlert, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="动作 → 快捷键" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="按分类折叠。展开某类后逐行点击右侧按钮录制；同一组合可绑定多个动作（允许的「冲突」只就地标注）。"
                                           Style="{StaticResource SettingRowText}"/>
                                <!-- 按分类（主界面 / 组件总控 / 各组件 / 布局方案）折叠成多级结构，消除扁平长列表的重复感 -->
                                <StackPanel x:Name="HotkeyGroups" Spacing="6"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 数据 ============ -->
            <TabViewItem Header="数据">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- 数据备份与恢复（危险区） -->
                        <Border Style="{StaticResource Card}"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="数据备份与恢复" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="条目本体（书签/Star/文件）可重新同步，但手写笔记、标签体系、隐藏/置顶状态、桌面组件待办与随记全部不可重建。"
                                           Style="{StaticResource SettingRowText}"/>
                                <!-- 原文案是「请定期导出备份」：把"别丢数据"托付给人的记性，且给用户加了一步。
                                     现在程序自己落盘，故这里改成陈述事实 + 说明自动清理的边界。
                                     批次 BK 起间隔变成用户可调 ⇒ 这句里不能再出现"24 小时""7 份"这类写死的数：
                                     写在卡片上就等于第二份事实，改了设置或改了保留份数之后它会变成假话，
                                     而那几个数由下面的状态行按 Core 的常量与当前档位算出来。 -->
                                <TextBlock Text="应用会自己备份：按下面设的间隔存一份到 %LOCALAPPDATA%\StarMark\backups。自动清理只动 auto- 开头的自动件，你手动导出的备份与恢复前快照都不在清理候选里。"
                                           Style="{StaticResource SettingRowText}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="自动备份" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   Text="关掉之后程序不再自动落任何份，能回滚的只剩你手动导出的那些（导入前的「恢复前快照」仍然每次都留）。关掉不会删掉已经落盘的自动件。"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" OnContent="开" OffContent="关" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.AutoBackupEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"
                                               Text="自动备份间隔"/>
                                    <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                              ToolTipService.ToolTip="两份自动件之间的最小间隔。应用开着时每 10 分钟问一次「到点没」，所以实际落盘最多比到点晚十分钟。保留份数是固定的，间隔越短能回溯的天数就越少——这笔账由下面那行按你选的档算给你看。"
                                              ItemsSource="{x:Bind ViewModel.AutoBackupIntervalOptions}"
                                              SelectedIndex="{x:Bind ViewModel.AutoBackupIntervalIndex, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.AutoBackupStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <TextBlock Text="导入会先自动生成「恢复前快照」（同上目录），任何恢复都可回滚：它就是下面列表里标着「恢复前快照」的那一行，点「用它回滚」即撤销这次导入。"
                                           Style="{StaticResource SettingRowText}"/>
                                <!-- 进程权限高于对话框宿主时选择器跨不过去（真机日志 E_FAIL 四连挂）。
                                     本程序不再为了连 Everything 抬自己的权限（P-108 改判），所以这句只在用户自己
                                     "以管理员身份运行"时出现；处置同样是自动退回应用内路径输入框，不指挥人换权限。 -->
                                <TextBlock Text="当前以管理员身份运行（由你启动时的选择决定，程序不会再自己提权）：系统文件对话框在这种会话里不可用，导出/导入会自动改用应用内的路径输入框，无需换权限或重启。"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Visibility="{x:Bind ViewModel.IsElevatedSession, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!--
                                    带不带图片本体是"这一次导出"的决定，所以开关必须长在导出按钮正上方：
                                    放在剪贴板那张卡里，用户点导出时看不到它，也就不知道自己拿到的是一份
                                    "条目齐全、图片要靠本机还留着文件才打得开"的备份。
                                    默认开（决议 §4）。这句代价按 §3-Q2 的两种事实分支，写在导出结果与恢复结果里。
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="导出时带上剪贴板图片本体" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   Text="带上就存成 .zip（清单 + 图片），只有一份文件、不会拷走一半。关掉则只带条目与文件名：恢复后这些图片条目要靠本机图片目录里还留着的文件才打得开，缺的会标成「文件缺失」。一张 4K 截图常有几百 KB，上限调到几百条时导出包会明显变大。"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" OnContent="带" OffContent="不带" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="只影响手动「导出备份」。恢复前快照与自动件始终不带图片本体——它们是回滚点，一份几十 MB 的库配几百 MB 的图会把「随时能撤一步」变成「每次恢复先填一盘磁盘」。恢复时会把包里的图片写回本机图片目录，已有同名文件不覆盖。"
                                                  IsOn="{x:Bind ViewModel.BackupClipboardImagesEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="导出备份…" Click="ExportBackup_Click" Style="{StaticResource SecondaryButton}"/>
                                    <Button Content="导入备份…" Click="ImportBackup_Click" Style="{StaticResource SecondaryButton}"/>
                                    <!-- 备份就在本机目录里，"去看一眼/自己拷走"本该一步到位，不该让用户去地址栏敲路径 -->
                                    <Button Content="打开备份目录" Click="OpenBackupFolder_Click" Style="{StaticResource SecondaryButton}"/>
                                    <ProgressRing Width="20" Height="20"
                                                  IsActive="{x:Bind ViewModel.IsBackupBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsBackupBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- 本机已有备份：看得见有哪些份，才谈得上"恢复到某一份"或"用它回滚" -->
                                <TextBlock Text="{x:Bind ViewModel.BackupsHeader, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasBackups, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:BackupRow">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind MetaText}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind NameText}" Style="{StaticResource MutedText}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <!-- 「删除」与「恢复这份」并排：清理旧件这件事以前只能开资源管理器
                                                     去目录里挑文件，而目录里几十个同类文件名长得一样——看得见列表却删不掉，
                                                     等于把"腾地方/清掉误操作那一份"留成手工活。删除必先确认。 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="{x:Bind RestoreLabel}" Tag="{x:Bind File}"
                                                            Click="RestoreBackup_Click"
                                                            Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                                    <Button Content="删除" Tag="{x:Bind File}"
                                                            Click="DeleteBackup_Click"
                                                            ToolTipService.ToolTip="只删这一份导出文件，数据库本身不动；点下去会先确认一次，并说明这一份删掉之后有什么后果。"
                                                            Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="还没有任何备份文件（自动备份按上面设的间隔落盘，也可以点上面「导出备份」立刻来一份）。"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.HasBackups, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                                <TextBlock Text="{x:Bind ViewModel.BackupStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}"/>
                            </StackPanel>
                        </Border>

                        <!-- 剪贴板历史（默认关：这是敏感度最高的本地数据） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="剪贴板历史" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="开启后自动记录本机复制过的文本与文件列表（最近 500 条），在主窗「剪贴板」页点一条即可再复制回去。密码管理器复制的内容、以及私钥 / 登录令牌 / 银行卡号形态一律不入库。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.ClipboardHistoryStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <!--
                                    图片采集：独立开关、默认关。下面这句是决议 §3-Q3 的原话，刻意不软化——
                                    文本能扫掉卡号/私钥/令牌，图片扫不了（要扫就得在采集路径上跑 OCR，那是 §7 明令不做的事）。
                                    所以"开不开"必须由用户自己点，且点之前得看见这句代价。
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="同时记录复制到的图片（屏幕截图、图片文件、以及在图上右键「复制图片」）。图片无法做敏感检查，开启即包含一切屏幕内容。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.ClipboardImageEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.ClipboardImageStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="图片最多留多少条"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   Text="超出后按最近复制的时间淘汰，置顶的那几条不会被挤掉。一张 4K 截图的 PNG 常有几百 KB，调高会明显多占磁盘。"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1" Width="128" VerticalAlignment="Center" FontSize="12"
                                               Minimum="10" Maximum="2000" SmallChange="10" LargeChange="50"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind ViewModel.ClipboardImageMaxValue, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="文本最多留多少条"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   Text="默认 500 条，就是以前写死的那个数字；正文过长的只存前 32 KB。文本与图片各自一条线，互不挤占。"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1" Width="128" VerticalAlignment="Center" FontSize="12"
                                               Minimum="10" Maximum="10000" SmallChange="50" LargeChange="100"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind ViewModel.ClipboardTextMaxValue, Mode=TwoWay}"/>
                                </Grid>

                                <!--
                                    占用统计只在进这一页时算一次（不在每次复制时算），并给一颗就地重算的按钮：
                                    数字是"要不要把上限调高"这个决定的唯一依据，看不见就等于把选择权给出去又收回来。
                                    图片目录对用户直接可见（决议 §3-Q6），所以路径也一并写出来，不藏。
                                -->
                                <TextBlock Text="{x:Bind ViewModel.ClipboardUsage, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <Button Content="重新统计占用" Command="{x:Bind ViewModel.RefreshClipboardUsageCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                                <!-- §3-Q6 的第二类（图有行无）：只数不删，但必须给得出出口。
                                     没有东西可清时它是灰的，而上面那行"另有 N 个文件不在历史里"就是灰/亮的理由；
                                     按下去先列名单再删（决议明写"不静默删用户目录"）。 -->
                                <Button Content="清理孤儿与临时件"
                                        Command="{x:Bind ViewModel.CleanClipboardAssetsCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanCleanClipboardAssets, Mode=OneWay}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="删掉「不在历史里的那些文件」与没写完的临时件。点下去会先列名单让你确认，一条历史条目都不会动。"/>
                                <TextBlock Text="{x:Bind ViewModel.ClipboardCleanupStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 健康 + 诊断（合并：两项内容都不多，放同一页两列） ============ -->
            <TabViewItem Header="健康与诊断">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="440" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- 护眼 / 休息提醒（从「常规」挪来：这一页管"身体 + 体检"，常规页只留日常项） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="护眼 · 休息提醒" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="连续工作一段时间后提醒你休息。开着才建那张定时表，关掉后不探测前台窗口、也不会显示任何东西。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="开启" OffContent="关闭" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EyeRestEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="间隔多久提醒一次"/>
                                        <TextBlock Text="到点后还要看当前前台是不是全屏应用，所以实际时刻会有一两分钟浮动。" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                              ItemsSource="{x:Bind ViewModel.EyeRestIntervalOptions}"
                                              SelectedIndex="{x:Bind ViewModel.EyeRestIntervalIndex, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="怎么提醒"/>
                                        <TextBlock Text="改完直接按下面的「试一试」就能看见这一档的效果，不用等满间隔。"
                                                   Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="250" MaxWidth="320" VerticalAlignment="Center" HorizontalAlignment="Right"
                                              ItemsSource="{x:Bind ViewModel.EyeRestNoticeOptions}"
                                              SelectedIndex="{x:Bind ViewModel.EyeRestNoticeIndex, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="前台是全屏应用时让路：放 PPT / 放映 / 全屏游戏不被打断，稍后再探一次。"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="让路" OffContent="不让路" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EyeRestDeferOnFullscreen, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Button Grid.Column="0" Content="试一试当前设置的效果"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{x:Bind ViewModel.PreviewEyeRestCommand}"/>
                                    <!-- 演完必须有回执："按了没反应"与"演过了但没看见"在用户侧长得一样 -->
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{x:Bind ViewModel.EyeRestPreviewStatus, Mode=OneWay}"
                                               Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                </Grid>
                                <!-- 两处入口要互相认账（批次 WC-3）：这里说清"时钟组件上也能开关"，
                                     否则用户在组件上改了间隔，回到这页会以为这里才是真值。 -->
                                <TextBlock Text="想少两步：桌面「时钟」组件右键就有「护眼 · 休息提醒」，开关、间隔、提醒形式与「试一试」在那儿改也一样生效（改的是同一份设置），时钟上还会多显示一行「休息 HH:mm」。"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" Opacity="0.62" FontSize="12"/>
                                <TextBlock Text="{x:Bind ViewModel.EyeRestStatus, Mode=OneWay}"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="收藏健康度" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="本地聚合，零网络。把「收藏夹腐败」变成可行动清单。" Style="{StaticResource SettingRowText}"/>

                                <!-- 评分 + 扣分明细 -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}"
                                                   FontSize="44" FontWeight="Bold" Foreground="{x:Bind ViewModel.ScoreBrush, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ScoreGrade, Mode=OneWay}" FontSize="12" HorizontalAlignment="Center" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ScoreSummary, Mode=OneWay}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.HealthReport.Factors, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="ab:HealthFactor">
                                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap">
                                                        <Run Text="• "/><Run Text="{x:Bind Label}"/><Run Text="： -"/><Run Text="{x:Bind Deduction}"/><Run Text=" 分（"/><Run Text="{x:Bind Detail}"/><Run Text="）"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- 趋势图与统计摘要并排（原来上下堆叠，右侧空一大块） -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="近 14 天新增" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.TrendBars, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="3"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:HealthTrendBar">
                                                    <StackPanel Width="26" VerticalAlignment="Bottom" Spacing="2">
                                                        <Rectangle Height="{x:Bind Height}" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                                   MinHeight="1" RadiusX="2" RadiusY="2" HorizontalAlignment="Stretch"/>
                                                        <TextBlock Text="{x:Bind DateLabel}" FontSize="9" HorizontalAlignment="Center"
                                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="语言 Top："/><Run Text="{x:Bind ViewModel.LanguageSummary, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="独立域名："/><Run Text="{x:Bind ViewModel.HealthReport.DistinctDomains, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="疑似重复 Top："/><Run Text="{x:Bind ViewModel.DuplicateSummary, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="标签 Top："/><Run Text="{x:Bind ViewModel.TagSummary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsHealthLoading, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsHealthLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{x:Bind ViewModel.HealthError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12"
                                           Visibility="{x:Bind ViewModel.HasHealthError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="诊断" Style="{StaticResource SettingTitle}"/>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DiagnosticEntries, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="diag:DiagnosticEntry">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedText}"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Text="{x:Bind ViewModel.DiagnosticsError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12"
                                           Visibility="{x:Bind ViewModel.HasDiagnosticsError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

    </Grid>
</Page>
