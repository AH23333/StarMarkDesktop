<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.SettingsPage"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:controls="using:StarMark.UI.Controls"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    xmlns:local="using:StarMark.UI.Views"
    xmlns:ab="using:StarMark.Abstractions.Insights"
    xmlns:i18n="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- 设置项内部：左「标题 + 说明」，右「控件」，避免一侧大片空白 -->
        <Style x:Key="SettingRowText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 设置页分类标签不可关闭（无关闭符号） -->
        <Style TargetType="TabViewItem">
            <Setter Property="IsClosable" Value="False"/>
        </Style>

        <!-- 快捷键单行模板（按分类折叠到多级菜单中复用） -->
        <DataTemplate x:Key="HotkeyRowTemplate" x:DataType="local:HotkeyRow">
            <Grid Margin="0,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 四颗槽一律 Mode=OneWay：值由行模型现算（「键＋实参」＋当下语言），换语言那一刻由
                     SettingsPage 那一拍重念（P-175 缺口②）。⛔ 回到 OneTime——那等于把句子钉在建行那一刻的语言。 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ActionName, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                <Button Grid.Row="0" Grid.Column="1"
                        Content="{x:Bind BindingText, Mode=OneWay}"
                        Tag="{x:Bind Action}"
                        Click="RecordButton_Click"
                        MinWidth="210" MinHeight="32" HorizontalAlignment="Right"
                        Margin="12,0,0,0"
                        Style="{StaticResource SecondaryButton}"/>

                <!-- 冲突提示：不弹窗，就地标注（用户可直接忽略） -->
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,2,0,0"
                           Text="{x:Bind ConflictText, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="320" HorizontalAlignment="Right"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="{x:Bind HasConflict, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                <!-- 组合键此刻被别的程序占用：这是"提示"不是"注册被拒绝"（绑定已保存、程序在自动重试），
                     所以用与冲突标注同一 tone 的 caution 色，而不是 critical 红。 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,2,0,0"
                           Text="{x:Bind RegisterErrorText, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="{x:Bind HasRegisterError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 背景透明：让主窗口的半透明毛玻璃背衬透出，否则不透明的设置页会盖住主窗口材质，
         导致「常规 → 外观」里切材质或拖「背景不透明度（仅纯色）」看不出即时效果。
         主窗口关闭半透明（实色）时 RootGrid 自身已铺实色，透明页同样能正常显示。 -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 + 右上角「返回」（设置改动实时生效，不再需要底部保存按钮） -->
        <Grid Grid.Row="0" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock i18n:LocText.Key="settings.pageTitle"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <!-- 设置改动实时生效、没有底部保存按钮，因此"没保存成功"这种反面事实必须自己露头，
                     否则用户唯一能发现的时间点是下次启动设置悄悄回退（P-53）。 -->
                <TextBlock x:Name="SaveErrorMessageText"
                           FontSize="12" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="{x:Bind ViewModel.HasSaveError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Button Grid.Column="1" Click="Back_Click"
                    i18n:LocText.Key="settings.back"
                    Style="{StaticResource SecondaryButton}"/>
        </Grid>

        <TabView x:Name="SettingsTabs" Grid.Row="1"
                 Margin="24,12,24,0"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent"
                 Background="Transparent">

            <!-- ============ 常规 ============ -->
            <TabViewItem x:Name="TabGeneral" Tag="general" i18n:LocText.Key="settings.tab.general">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <!-- 自适应分栏：宽屏两列铺满，窄屏自动单列 -->
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- 主题：这一张卡只有一格设置，抬头⛔ 另占一行——那样名字丢在空行上、下拉孤悬在右
                             （批次 WI-67 片13，用户指"不在同一行"，屏幕上量到标题 659x19+95+313 与下拉 188x40+570+346）。 -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" i18n:LocText.Key="settings.general.themeTitle"
                                           Style="{StaticResource SettingTitle}" Margin="0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="ThemeSelect" MinWidth="180"
                                          SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                          ItemsSource="{x:Bind ThemeOptions, Mode=OneTime}"
                                          ItemTemplate="{StaticResource LocOptionTemplate}"/>
                            </Grid>
                        </Border>

                        <!-- 界面语言（批次 WI-1）。
                             选项**不在这里列**：语言名单只有一个出处（AppLanguages.Pickable），
                             由 SettingsPage.I18n.cs 现场生成——在这里多写一行 ComboBoxItem，
                             就等于让"能不能选日文"这件事同时住在两个地方。
                             摆位与「主题」同一判据：名字与下拉一行（片13，屏幕上量到 659x19+790+313 与 188x40+1265+346 各在各行）。 -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" i18n:LocText.Key="settings.languageTitle"
                                           Style="{StaticResource SettingTitle}" Margin="0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="LanguageSelect" MinWidth="180"
                                          SelectionChanged="LanguageSelect_SelectionChanged"
                                          ItemsSource="{x:Bind LanguageOptions, Mode=OneTime}"
                                          ItemTemplate="{StaticResource LocOptionTemplate}"/>
                            </Grid>
                        </Border>

                        <!-- 外观：主窗口材质（macOS 风；组件材质住在「桌面工具（组件）」页） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock i18n:LocText.Key="settings.general.appearanceTitle" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.general.appearanceNote"
                                           Style="{StaticResource SettingRowText}"/>


                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.mainBackdrop"/>
                                    </StackPanel>
                                    <!-- 顺序即枚举值，与「组件材质」一致：0=亚克力(薄) 1=云母 2=实色 3=云母Alt 4=亚克力(厚) 5=纯色；
                                         清单住在 SettingsPage.Options.cs 的 MaterialOptions（两颗下拉共用一份措辞，坑表 #290） -->
                                    <ComboBox Grid.Column="1" x:Name="MainBackdropSelect" MinWidth="200"
                                              SelectedIndex="{x:Bind ViewModel.MainWindowBackdropIndex, Mode=TwoWay}"
                                              ItemsSource="{x:Bind MaterialOptions, Mode=OneTime}"
                                              ItemTemplate="{StaticResource LocOptionTemplate}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.mainOpacity"/>
                                        <TextBlock i18n:LocText.Key="settings.shared.opacityScope" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.OpacityFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.OpacityCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.OpacityStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.MainWindowOpacity, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.MainWindowOpacityPercentText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 托盘与呼出 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock i18n:LocText.Key="settings.general.trayTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.autostart"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle"
                                                  i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off"
                                                  MinWidth="0" Toggled="AutostartToggle_Toggled"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.trayResident"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off"
                                                  MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EnableTray, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.globalHotkeys"/>
                                        <TextBlock i18n:LocText.Key="settings.general.globalHotkeysNote" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off"
                                                  MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EnableGlobalHotKey, Mode=TwoWay}"
                                                  Toggled="EnableGlobalHotKey_Toggled"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.minimizeToTray"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off"
                                                  MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GitHub -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock i18n:LocText.Key="settings.general.githubTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock i18n:LocText.Key="settings.general.githubToken" Style="{StaticResource SettingRowText}"/>
                                        <!-- 用 PasswordBox 而不是 TextBox（批次 UI，P-146）：TextBox 的内容在 UIA 树里
                                             就是可读的 Value，读屏、自动化、截图都能把 Token 带走，而且不需要权限。
                                             PasswordBox 的 Password 不可绑定（WinUI 刻意如此），所以这一格改走
                                             SettingsPage.xaml.cs 里那一对读写，与同一页的「AI API Key」同形。 -->
                                        <PasswordBox x:Name="GithubTokenBox" PlaceholderText="ghp_..."
                                                     PasswordChanged="GithubTokenBox_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock i18n:LocText.Key="settings.general.githubUser" Style="{StaticResource SettingRowText}"/>
                                        <TextBox PlaceholderText="octocat" Text="{x:Bind ViewModel.GithubUsername, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 关于与更新（批次 UE 检测，UG-3 才接上「立即更新」）：
                             自动那一发仍然只问版本、不下载；装新版只有点那一下才会发生。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock i18n:LocText.Key="settings.general.aboutTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.currentVersion"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.LocalVersionText, Mode=OneWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.general.autoCheck"/>
                                        <TextBlock i18n:LocText.Key="settings.general.autoCheckNote"
                                                   Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off"
                                                  MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.UpdateAutoCheckEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <!-- ⛔ 把这句绑成成品串：话的一半住在 UpdatePolicy.Describe*，绑字符串＝换语言没人重贴（批次 WI-65 片1，由宿主那一拍走 LocText.SetMessage） -->
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="UpdateCheckButton" i18n:LocText.Key="settings.general.checkNow"
                                            Click="UpdateCheck_Click" Style="{StaticResource SecondaryButton}"/>
                                    <!-- 与「打开下载页」同时出现，但排在它前面：能自动装的时候，把人支去浏览器是多余的一步 -->
                                    <Button x:Name="UpdateApplyButton" i18n:LocText.Key="settings.general.updateNow"
                                            Click="UpdateApply_Click"
                                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                                    <!-- 只有「确实有一版更新」才出现：在"还没有发布过"那一格放一颗下载按钮，等于承诺了一个不存在的产物 -->
                                    <Button x:Name="UpdateOpenPageButton" i18n:LocText.Key="settings.general.openDownloads"
                                            Click="UpdateOpenPage_Click"
                                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                                </StackPanel>
                                <!-- 这一版的更新说明（批次 VX）：正文由对方写、只在真的问过一次的这一场里给看，
                                     不落设置档（所以重开程序这一格是收着的，再点一次「立即检查」就回来）。
                                     排在按钮之后：别让刚点过的那一排跟着长高往下跳。 -->
                                <Expander x:Name="UpdateNotesExpander" i18n:LocText.Key="settings.general.releaseNotes"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Stretch">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind ViewModel.ReleaseNotesText, Mode=OneWay}"
                                                   Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 使用说明（批次 VC-3） ============
                 这一栏刻意不写任何文字：正文只在 Core 的 PageGuides 一处（顶栏「？」与首启引导说的是同一批话），
                 这里只放宿主。写第二份的下场就是"三处说法不一样，用户不知道哪句作数"。 -->
            <TabViewItem x:Name="TabGuide" Tag="guide" i18n:LocText.Key="settings.tab.guide">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ReplayGuideButton" i18n:LocText.Key="settings.guide.replay"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ReplayGuideButton_Click"/>
                            <TextBlock i18n:LocText.Key="settings.guide.replayNote"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="GuideTabPanel" Spacing="6"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ AI 增强（要接外部服务或本机模型才成立的功能：从「常规」拆出，用户裁决） ============ -->
            <TabViewItem x:Name="TabAi" Tag="ai" i18n:LocText.Key="settings.tab.ai">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!--
                            AI 助手（批次 A：只到"通道能不能用"，批量整理在批次 B）。
                            默认关闭且不发任何请求：这功能要把库里的标题与摘要交给一个外部进程或外部服务，
                            未明确开启前不得处于工作状态。
                            刻意做成"一格一改就地保存 + 状态常驻"：这一栏的每一项都要能立刻看出还差什么，
                            攒到按「保存」时才校验是扩展项目返工过的形状。
                        -->
                        <!-- 先讲清"要填的三样各是什么、Key 去哪拿"：以前只有字段名，第一次配的人不知道该填什么，
                             填错了又只看到"连接失败"，等于把文档藏进了试错里。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           i18n:LocText.Key="settings.ai.noKeyNote"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.ai.title" Style="{StaticResource SettingTitle}"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" i18n:LocText.Key="settings.ai.enable" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="AiEnabledToggle" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  Toggled="AiEnabled_Toggled"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <ComboBox Grid.Column="0" x:Name="AiProviderBox" i18n:LocText.Key="settings.ai.channel" HorizontalAlignment="Stretch"
                                              SelectionChanged="AiProvider_SelectionChanged"/>
                                    <TextBox Grid.Column="1" x:Name="AiModelBox" i18n:LocText.Key="settings.ai.model"
                                             i18n:LocText.PlaceholderKey="settings.ai.modelPlaceholder"
                                             FontSize="12" TextChanged="AiField_TextChanged"/>
                                </Grid>

                                <!-- 这里从前挂过一句"每一项分别要填什么"的<b>标题</b>：它的正文早已搬进
                                     PageGuides（设置页「使用说明」与顶栏「？」），留下标题没有落脚的格子，
                                     又没有 Grid.Column ⇒ 它掉进第 0 列，在屏幕上把「Ollama 地址」那一格整格盖住
                                     （批次 WI-67 片13，用户指的那处重叠＝量到两句同为 790+464 起点）。 -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <TextBox Grid.Column="0" x:Name="AiOllamaUrlBox" i18n:LocText.Key="settings.ai.ollamaUrl"
                                             i18n:LocText.PlaceholderKey="settings.ai.ollamaUrlPlaceholder"
                                             FontSize="12" TextChanged="AiField_TextChanged"/>
                                    <TextBox Grid.Column="1" x:Name="AiBaseUrlBox" i18n:LocText.Key="settings.ai.endpoint"
                                             i18n:LocText.PlaceholderKey="settings.ai.endpointPlaceholder"
                                             FontSize="12" TextChanged="AiField_TextChanged"/>
                                </Grid>
                                <PasswordBox x:Name="AiKeyBox" i18n:LocText.Key="settings.ai.apiKey"
                                             FontSize="12" PasswordChanged="AiField_TextChanged"/>

                                <!-- 分类专用模型（§19 O6）：留空就沿用上面那个模型名，填了只影响打标这一路。 -->
                                <TextBox x:Name="AiClassifyModelBox" i18n:LocText.Key="settings.ai.classifyModel"
                                         HorizontalAlignment="Stretch" i18n:LocText.PlaceholderKey="settings.ai.classifyModelPlaceholder"
                                         FontSize="12" TextChanged="AiField_TextChanged"/>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="AiProbeButton" i18n:LocText.Key="settings.ai.testConnection" Click="AiProbe_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                    <!-- 只有"通了但模型名不对"时才出现：把服务侧的名字递过去，不让用户抄一遍 -->
                                    <Button x:Name="AiFillModelButton" Click="AiFillModel_Click"
                                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- 这两行的字面<b>只有 code-behind 一个主人</b>：它们是随操作变的读数
                                     （测试/整理/写回各有好几句，批次 WI-2i 起就由代码写），
                                     标记上挂初始句的静态键＝换语言那一刻把当时的读数盖回初始句（#295）。 -->
                                <TextBlock x:Name="AiStatusText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <!--
                                    批量整理。"开始"只有一个入口（扩展教训：两个功能重叠的按钮引发多次返工），
                                    就放在通道配置下面——通道没接通时这里点了也只会在状态行给出原因。
                                    旁边那颗「停止」不是第二个入口，是同一段忙碌的出口：只在忙的时候现身。
                                -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <NumberBox Grid.Column="0" x:Name="AiScopeBox" i18n:LocText.Key="settings.ai.scope"
                                               Minimum="1" Maximum="500" SmallChange="10" LargeChange="50" SpinButtonPlacementMode="Compact"
                                               Value="100" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1" x:Name="AiOrganiseButton" i18n:LocText.Key="settings.ai.start" Click="AiOrganise_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/>
                                    <!--
                                        停止单独一颗，忙的时候才现身（把"开始"就地变成"暂停"这种一次点击两件事的
                                        按钮，用户在忙的那一刻不确定自己按下的是哪一个——扩展侧最终也收敛到这里）。
                                    -->
                                    <Button Grid.Column="2" x:Name="AiStopButton" i18n:LocText.Key="settings.ai.stop" Click="AiStop_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                    <Button Grid.Column="3" x:Name="AiApplyAllButton" i18n:LocText.Key="settings.ai.applyAll" Click="AiApplyAll_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" IsEnabled="False"/>
                                </Grid>

                                <!-- 三格只读展示（批次 R4）：数字全部从代码里的常数来，界面不写第二份。 -->
                                <TextBlock x:Name="AiBatchLimitsText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <TextBox x:Name="AiTimeoutBox" i18n:LocText.Key="settings.ai.timeout" HorizontalAlignment="Stretch"
                                         FontSize="12" TextChanged="AiTimeoutBox_TextChanged"/>
                                <TextBlock x:Name="AiTimeoutNoteText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <Button x:Name="AiResumeButton" Click="AiResume_Click"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Visibility="Collapsed"/>

                                <!--
                                    token 预算与用量（§20.1/§20.2）。判额、熔断、展示三家读同一份账本
                                    （AiClassifyService.BudgetVerdictAsync 是唯一裁决口），这里只画结论。
                                    「应用预算」独立一颗：改档位是显式动作，不随其它控件的自动写盘走顺带。
                                -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <NumberBox Grid.Column="0" x:Name="AiBudgetBox" i18n:LocText.Key="settings.ai.budget"
                                               Minimum="10000" Maximum="100000000" SmallChange="10000" LargeChange="50000"
                                               SpinButtonPlacementMode="Compact" Value="500000" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="1" x:Name="AiBudgetApplyButton" i18n:LocText.Key="settings.ai.applyBudget" Click="AiBudget_Save_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="2" x:Name="AiBudgetUnpauseButton" i18n:LocText.Key="settings.ai.unpause" Click="AiBudget_Unpause_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                </Grid>

                                <!-- 预警比例（批次 R4）：到线不拦，只把话说明白；留空＝出厂值。 -->
                                <TextBox x:Name="AiWarnRatioBox" i18n:LocText.Key="settings.ai.warnRatio" HorizontalAlignment="Stretch"
                                         FontSize="12" TextChanged="AiWarnRatioBox_TextChanged"/>
                                <TextBlock x:Name="AiWarnRatioNoteText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <TextBlock x:Name="AiUsageText" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Opacity="0.72"/>

                                <!--
                                    预览以"组"为单位：三百条逐个看是没人会做的复核，
                                    而"这六条打同一组标签"一眼就能判断对不对。
                                -->
                                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AiGroupList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,3,0,3">
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="{Binding TagLine}" FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ItemLine}" FontSize="11" Opacity="0.62" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" i18n:LocText.Key="settings.ai.applyGroup" Click="AiApplyGroup_Click" Tag="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" i18n:LocText.Key="settings.ai.rejectGroup" Click="AiIgnoreGroup_Click" Tag="{Binding}"
                                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 组件 ============ -->
            <TabViewItem x:Name="TabWidgets" Tag="widgets" i18n:LocText.Key="settings.tab.widgets">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.widgets.title" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.widgets.note"
                                           Style="{StaticResource SettingRowText}"/>
                                <StackPanel x:Name="WidgetRows" Spacing="2" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button x:Name="WidgetShowAllButton" i18n:LocText.Key="settings.widgets.showAll" Style="{StaticResource SecondaryButton}" Click="WidgetShowAll_Click"/>
                                    <Button x:Name="WidgetHideAllButton" i18n:LocText.Key="settings.widgets.hideAll" Style="{StaticResource SecondaryButton}" Click="WidgetHideAll_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 「开机自动加载组件」（用户裁决：这笔性能取舍由他自己选，别替他决定桌面长什么样）。
                             默认开＝今天的观感。关掉的收益是实测出来的（每颗组件窗的私有成本，见 Core 的
                             WidgetStartupPolicy 与报告 §二百一十），而"先建再关"退不回来（§二百零九量过），
                             所以只能走"不建"这一侧。数字不在这里重抄一遍——下面那行由 code-behind 走
                             LocText.SetMessage 贴 Core 交出的那颗「键＋实参」（✅WI-67 片8＝✅P-201）。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.widgets.startupTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" i18n:LocText.Key="settings.widgets.startupNote"
                                               Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="settings.widgets.loadOn" i18n:LocText.OffContentKey="settings.widgets.loadOff" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.WidgetsLoadOnStartup, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="WidgetsTradeoffHint"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 组件外观（从「常规 · 外观」搬来）：用户裁决——改组件的东西就该住在组件页，
                             常规页只留主窗口自己的外观。 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock i18n:LocText.Key="settings.widgets.appearanceTitle" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.widgets.appearanceNote"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.widgets.materialLabel"/>
                                    </StackPanel>
                                    <!-- 顺序即枚举值：0=亚克力(薄) 1=云母 2=实色 3=云母Alt 4=亚克力(厚) 5=纯色，追加新项不影响已保存的设置；
                                         措辞与「主窗口材质」同一份清单（⛔ 不许在这里再列六行同义键，坑表 #290） -->
                                    <ComboBox Grid.Column="1" x:Name="WidgetBackdropSelect" MinWidth="200"
                                              SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}"
                                              ItemsSource="{x:Bind MaterialOptions, Mode=OneTime}"
                                              ItemTemplate="{StaticResource LocOptionTemplate}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.widgets.opacityLabel"/>
                                        <TextBlock i18n:LocText.Key="settings.shared.opacityScope" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.OpacityFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.OpacityCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.OpacityStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.WidgetOpacity, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.OpacityPercentText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 边缘磁吸 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.widgets.snapTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" i18n:LocText.Key="settings.widgets.snapRowLabel" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EnableWidgetSnap, Mode=TwoWay}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.widgets.snapStrengthLabel"/>
                                        <TextBlock i18n:LocText.Key="settings.widgets.snapStrengthNote" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.SnapStrengthFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.SnapStrengthCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.SnapStrengthStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.SnapStrength, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.SnapStrengthText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.widgets.snapSpacingLabel"/>
                                        <TextBlock i18n:LocText.Key="settings.widgets.snapSpacingNote" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.SnapSpacingFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.SnapSpacingCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.SnapSpacingStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.SnapSpacing, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.SnapSpacingText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 性能模式 / 内存门禁 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.widgets.perfTitle" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.widgets.perfNote"
                                           Style="{StaticResource SettingRowText}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" i18n:LocText.Key="settings.widgets.perfLabel" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="PerformanceSelect" MinWidth="200"
                                              SelectedIndex="{x:Bind ViewModel.PerformanceModeIndex, Mode=TwoWay}"
                                              ItemsSource="{x:Bind PerformanceOptions, Mode=OneTime}"
                                              ItemTemplate="{StaticResource LocOptionTemplate}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"
                                      Visibility="{x:Bind ViewModel.CustomBudgetVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.widgets.budgetLabel"/>
                                        <TextBlock i18n:LocText.Key="settings.widgets.budgetNote" Style="{StaticResource SettingRowText}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <!-- 范围与步进绑判据（批次 SA，P-123 第 3 条）：这里曾写死 32–2048 / 16–1024，
                             而仓储允许到 4096 ⇒ 存档里合法且在生效的预算在这根条子上表达不出来。 -->
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.BudgetMbFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.BudgetMbCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.BudgetMbStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.CacheBudgetMb, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="56"
                                                   Text="{x:Bind ViewModel.CacheBudgetText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"
                                      Visibility="{x:Bind ViewModel.CustomBudgetVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.widgets.cacheLabel"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="{x:Bind ViewModel.CacheCountFloor, Mode=OneTime}"
                                                Maximum="{x:Bind ViewModel.CacheCountCeiling, Mode=OneTime}"
                                                StepFrequency="{x:Bind ViewModel.CacheCountStep, Mode=OneTime}" Width="150"
                                                Value="{x:Bind ViewModel.MaxCacheCount, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="46"
                                                   Text="{x:Bind ViewModel.MaxCacheCount, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 布局方案 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.widgets.layoutTitle" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.widgets.layoutNote"
                                           Style="{StaticResource SettingRowText}"/>
                                <ItemsRepeater ItemsSource="{x:Bind LayoutRowsItems, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:WidgetLayoutRow">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource MutedText}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" i18n:LocText.Key="settings.widgets.applyLayout"
                                                        Tag="{x:Bind Id}" Click="ApplyLayout_Click"
                                                        Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                                <Button Grid.Column="2" i18n:LocText.Key="dialog.delete"
                                                        Tag="{x:Bind Id}" Click="DeleteLayout_Click"
                                                        Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock i18n:LocText.Key="settings.widgets.noLayouts" Style="{StaticResource MutedText}"
                                           Visibility="{x:Bind HasNoLayouts, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 拓展功能（可以整个不用、也不影响主流程的浏览面：热榜与订阅源） ============ -->
            <TabViewItem x:Name="TabExtend" Tag="extend" i18n:LocText.Key="settings.tab.extend">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- GitHub 热榜（默认关；关时导航栏连「热榜」项都不显示——用户裁决的可选浏览面） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.extend.trendingTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.extend.trendingNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.TrendingEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="TrendingStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.extend.glanceNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="settings.extend.glanceOn" i18n:LocText.OffContentKey="settings.extend.glanceOff" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.TrendingGlanceEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <!-- 就地入口：刚开启的人多半想立刻看一眼，不该让他自己回导航栏找那一项 -->
                                <Button i18n:LocText.Key="settings.extend.openTrending" Click="OpenTrending_Click" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.TrendingEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!--
                            网址来源（RSS / Atom）：这一栏只管"有哪些源、每个开不开、这一栏整体开不开"。
                            批次 RB 之前条目预览也住在这里，用户裁决要挪走——设置页是改配置的地方，
                            挑文章是另一件事；两件事挤在一屏就长成了"设置页里嵌了个阅读器"的怪形状。
                        -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.extend.rssTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.extend.rssNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.RssEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="RssSwitchStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <TextBlock x:Name="RssSourceEmpty" i18n:LocText.Key="settings.extend.rssEmpty" Opacity="0.62"
                                           Style="{StaticResource SettingRowText}"/>
                                <ItemsControl x:Name="RssSourceRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2,0,2">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.62" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="settings.extend.rssOn" i18n:LocText.OffContentKey="settings.extend.rssOff" MinWidth="0"
                                                              IsOn="{Binding Enabled, Mode=OneTime}" Tag="{Binding}"
                                                              Toggled="RssSource_Toggled"/>
                                                <Button Grid.Column="2" i18n:LocText.Key="dialog.delete" Click="RssDelete_Click" Tag="{Binding}"
                                                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="6">
                                    <TextBox Grid.Column="0" x:Name="RssUrlBox" i18n:LocText.PlaceholderKey="settings.extend.rssUrlPlaceholder"
                                             FontSize="12" HorizontalAlignment="Stretch"/>
                                    <TextBox Grid.Column="1" x:Name="RssNameBox" i18n:LocText.PlaceholderKey="settings.extend.rssNamePlaceholder"
                                             FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Column="2" i18n:LocText.Key="settings.extend.add" Click="RssAdd_Click" Style="{StaticResource SecondaryButton}"/>
                                </Grid>
                                <!-- 就地入口：刚配好源的人多半想立刻看一眼，不该让他自己回导航栏找那一项 -->
                                <Button i18n:LocText.Key="settings.extend.openRss" Click="OpenRss_Click" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.RssEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- 本地磁盘搜索（从「数据」页搬来，用户裁决：可整个关掉、且要靠外部引擎才成立的能力
                             住「拓展功能」；关掉时它一个字节都不写，开着时「引擎在哪、占多大、怎么删」也在这同一张卡里说清） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.extend.diskSearchTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" i18n:LocText.Key="settings.extend.diskSearchNote"
                                               Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.LocalDiskSearchEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="LocalDiskSearchStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <!-- 准备失败原先只留一句「请确认 Everything 正在运行后稍候再试」／「请用开始菜单以管理员身份运行」，
                                     等于把程序自己能做的动作写成用户作业。改为就地按钮，点的就是同一段准备代码（P-54）。 -->
                                <Button i18n:LocText.Key="settings.extend.retryPrepare"
                                        Command="{x:Bind ViewModel.RetryLocalDiskPrepareCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.CanRetryLocalDiskPrepare, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!-- 自带引擎管理：占用大小 + 打开所在目录 + 删除（误删无妨，下次开启自愈式重下） -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock i18n:LocText.Key="settings.extend.engineUsage" Style="{StaticResource SettingRowText}"/>
                                        <TextBlock x:Name="EngineSizeText" Text="—" Style="{StaticResource SettingRowText}" Opacity="0.7"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" i18n:LocText.Key="settings.extend.openEngineFolder" Click="OpenEngineFolder_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" i18n:LocText.Key="dialog.delete" Click="DeleteEngine_Click"
                                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock i18n:LocText.Key="settings.extend.engineDeleteNote"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" Opacity="0.62" FontSize="12"/>
                                <!-- 「索引进库」那一整块（目录多行框＋每目录上限＋保存按钮＋不可用目录提示）
                                     已按用户裁决拆掉（批次 VQ）：那颗按钮只把配置落盘，真进库要等顶栏「同步」，
                                     而"引擎没跑／没配目录／目录当前不存在／IPC 返回半截"四条出口全都无声，
                                     同步完还无条件弹一句「索引同步完成」⇒ 用户读作"已进库"，实际一条没有。
                                     实时全盘搜索（快捷搜索 / 主窗搜索里的本地文件）不受影响——那是另一条链。 -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <!-- 这句话的可见性只管"有没有话要说"（含扫描失败与"都还在"两种），
                                         不跟"有没有可删的行"绑——否则失败那句会被一起藏掉。 -->
                                    <TextBlock Grid.Column="0" x:Name="MissingFileRowsStatusText"
                                               Style="{StaticResource SettingRowText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{x:Bind ViewModel.HasMissingFileRowsNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                    <!-- 库里那些"盘上已经没有"的行：今天删得掉了（批次 VQ 把删除这一族对本机文件条目放开），
                                         也说得出口了。这里给一次点清的能力，但不替用户悄悄删——见 VM 上那段理由。 -->
                                    <Button Grid.Column="1" i18n:LocText.Key="settings.extend.cleanMissing" VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{x:Bind ViewModel.CleanMissingFilesCommand}"
                                            Visibility="{x:Bind ViewModel.HasMissingFileRows, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Button i18n:LocText.Key="settings.extend.rescan" Command="{x:Bind ViewModel.RescanMissingFilesCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!--
                            截屏总开关（批次 RP）：发起人点名"需要将截屏功能总开关放入拓展功能设置页"。
                            这条只管"<b>能不能再发起一次框选</b>"：那三条入口的热键与托盘项一起收，
                            已经贴在桌面上的图不受影响（显隐／忽略鼠标照常可用）——
                            判据在 Core 的 CaptureGate（热键注册投影、托盘、ScreenshotService 三个读者共用它），
                            这一处只是它的第四个读者；具体键位由 ViewModel 从当前绑定现取，这里不写死任何一颗键。
                        -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.extend.captureTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.extend.captureNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.CaptureEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="CaptureStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!--
                            屏幕画布（批次 WD-5）：发起人点名"这块设置要和画布上那颗 ⌨ 一样能随时看到，
                            并在主窗口设置的拓展功能里做同样的开关（功能一致即可，样式各自适应）"。
                            键位那一览是生成的：写死一份迟早和注册表分岔，分岔的症状是"照着说明按，没反应"。
                        -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.extend.canvasTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.extend.canvasNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.CanvasEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="CanvasStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.extend.canvasInShotNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="settings.extend.canvasInShotOn" i18n:LocText.OffContentKey="settings.extend.canvasInShotOff" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.CanvasInScreenshots, Mode=TwoWay}"/>
                                </Grid>
                                <!--
                                    光标那块圆的半径（批次 RN，应发起人点名"屏幕画布设置需要实现光晕半径调节设置"）。
                                    一根滑杆、两块圆：幕布开着时这个半径就是亮区大小，关着时就是那团光的大小——
                                    批次 S4-⑥ 已经把两块合成一块，拆成两根滑杆等于把那次合并重新拆开。
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.extend.glowTitle"/>
                                        <TextBlock i18n:LocText.Key="settings.extend.glowNote"
                                                   Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" MinWidth="220">
                                        <Slider Grid.Column="0" Minimum="40" Maximum="400" StepFrequency="10" Width="150"
                                                Value="{x:Bind ViewModel.CursorCircleRadiusDip, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Width="60"
                                                   Text="{x:Bind ViewModel.CursorCircleRadiusText, Mode=OneWay}"
                                                   Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Grid>
                                <TextBlock i18n:LocText.Key="settings.extend.hotkeyListTitle"
                                           Style="{StaticResource SettingRowText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <!--
                                    批次 RO：这张表过去是一整块拼好的多行字符串（名字 + 全角空格 + 键位）。
                                    那样渲染出来是十个左对齐的段落——键位的起点跟着名字长度跑，十行没有一个共同的右界，
                                    卡片右侧那一大片始终空着（发起人原话："文字全部挤在一起，而右侧却有很大空间"）。
                                    现在一行两个字段、名字那列吃掉剩余宽度，键位贴右缘，才成其为一张表。
                                -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CanvasHotkeyRows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:CanvasHotkeyRow">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" VerticalAlignment="Center"
                                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Gesture}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontFamily="Consolas" Opacity="0.9"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 快捷键 ============ -->
            <TabViewItem x:Name="TabHotkeys" Tag="hotkeys" i18n:LocText.Key="settings.tab.hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="460" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock i18n:LocText.Key="settings.hotkeys.title" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.hotkeys.recordNote"
                                           Style="{StaticResource SettingRowText}"/>
                                <TextBlock i18n:LocText.Key="settings.hotkeys.saveNote"
                                           Style="{StaticResource SettingRowText}"/>
                                <TextBlock i18n:LocText.Key="settings.hotkeys.conflictNote"
                                           Style="{StaticResource SettingRowText}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button i18n:LocText.Key="settings.hotkeys.save" Click="SaveHotkeys_Click"
                                            IsEnabled="{x:Bind HasUnsavedHotkeys, Mode=OneWay}"
                                            Style="{StaticResource AccentButton}"/>
                                    <Button i18n:LocText.Key="settings.hotkeys.discard" Click="DiscardHotkeys_Click"
                                            IsEnabled="{x:Bind HasUnsavedHotkeys, Mode=OneWay}"
                                            Style="{StaticResource SecondaryButton}"/>
                                    <Button i18n:LocText.Key="settings.hotkeys.reset" Click="ResetHotkeys_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                                <TextBlock i18n:LocText.Key="settings.hotkeys.unsaved"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource SettingRowText}"
                                           Visibility="{x:Bind HasUnsavedHotkeys, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!-- 注册失败原先只写一行日志，界面照旧显示"已设置"⇒ 给原因 + 就地重试 -->
                                <TextBlock Text="{x:Bind RegisterErrorSummary, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Style="{StaticResource SettingRowText}"
                                           Visibility="{x:Bind HasRegisterErrors, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <Button i18n:LocText.Key="settings.hotkeys.retry" Click="RetryHotkeyRegister_Click" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}"
                                        Visibility="{x:Bind HasRegisterErrors, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!-- 钩子装不上＝一个键都收不到；原先只写日志，界面却仍进入"正在录制"并清空按钮文字 -->
                                <TextBlock Text="{x:Bind RecordingAlert, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Style="{StaticResource SettingRowText}"
                                           Visibility="{x:Bind HasRecordingAlert, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <TextBlock i18n:LocText.Key="settings.hotkeys.mapTitle" Style="{StaticResource SettingTitle}"/>
                                <!-- 按分类（主界面 / 组件总控 / 各组件 / 布局方案）折叠成多级结构，消除扁平长列表的重复感 -->
                                <StackPanel x:Name="HotkeyGroups" Spacing="6"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 数据 ============ -->
            <TabViewItem x:Name="TabData" Tag="data" i18n:LocText.Key="settings.tab.data">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="420" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- 数据备份与恢复（危险区） -->
                        <Border Style="{StaticResource Card}"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.data.backupTitle" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.data.backupNote"
                                           Style="{StaticResource SettingRowText}"/>
                                <!-- 原文案是「请定期导出备份」：把"别丢数据"托付给人的记性，且给用户加了一步。
                                     现在程序自己落盘，故这里改成陈述事实 + 说明自动清理的边界。
                                     批次 BK 起间隔变成用户可调 ⇒ 这句里不能再出现"24 小时""7 份"这类写死的数：
                                     写在卡片上就等于第二份事实，改了设置或改了保留份数之后它会变成假话，
                                     而那几个数由下面的状态行按 Core 的常量与当前档位算出来。 -->
                                <TextBlock i18n:LocText.Key="settings.data.autoBackupNote"
                                           Style="{StaticResource SettingRowText}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock TextWrapping="Wrap" i18n:LocText.Key="settings.data.autoBackup"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   i18n:LocText.Key="settings.data.autoBackupOffNote"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  IsOn="{x:Bind ViewModel.AutoBackupEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center"
                                               i18n:LocText.Key="settings.data.autoBackupInterval"/>
                                    <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                              i18n:LocText.ToolTipKey="settings.data.autoBackupIntervalTip"
                                              ItemsSource="{x:Bind ViewModel.AutoBackupIntervalOptions, Mode=OneTime}"
                                              ItemTemplate="{StaticResource LocOptionTemplate}"
                                              SelectedIndex="{x:Bind ViewModel.AutoBackupIntervalIndex, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="AutoBackupStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                <TextBlock i18n:LocText.Key="settings.data.restoreSnapshotNote"
                                           Style="{StaticResource SettingRowText}"/>
                                <!-- 进程权限高于对话框宿主时选择器跨不过去（真机日志 E_FAIL 四连挂）。
                                     本程序不再为了连 Everything 抬自己的权限（P-108 改判），所以这句只在用户自己
                                     "以管理员身份运行"时出现；处置同样是自动退回应用内路径输入框，不指挥人换权限。 -->
                                <TextBlock i18n:LocText.Key="settings.data.elevatedNote"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Visibility="{x:Bind ViewModel.IsElevatedSession, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <!--
                                    带不带图片本体是"这一次导出"的决定，所以开关必须长在导出按钮正上方：
                                    放在剪贴板那张卡里，用户点导出时看不到它，也就不知道自己拿到的是一份
                                    "条目齐全、图片要靠本机还留着文件才打得开"的备份。
                                    默认开（决议 §4）。这句代价按 §3-Q2 的两种事实分支，写在导出结果与恢复结果里。
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock TextWrapping="Wrap" i18n:LocText.Key="settings.data.includeImages"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   i18n:LocText.Key="settings.data.includeImagesNote"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  i18n:LocText.OnContentKey="settings.data.includeImagesOn"
                                                  i18n:LocText.OffContentKey="settings.data.includeImagesOff"
                                                  i18n:LocText.ToolTipKey="settings.data.includeImagesTip"
                                                  IsOn="{x:Bind ViewModel.BackupClipboardImagesEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button i18n:LocText.Key="settings.data.export" Click="ExportBackup_Click" Style="{StaticResource SecondaryButton}"/>
                                    <Button i18n:LocText.Key="settings.data.import" Click="ImportBackup_Click" Style="{StaticResource SecondaryButton}"/>
                                    <!-- 备份就在本机目录里，"去看一眼/自己拷走"本该一步到位，不该让用户去地址栏敲路径 -->
                                    <Button i18n:LocText.Key="settings.data.openFolder" Click="OpenBackupFolder_Click" Style="{StaticResource SecondaryButton}"/>
                                    <ProgressRing Width="20" Height="20"
                                                  IsActive="{x:Bind ViewModel.IsBackupBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsBackupBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- 本机已有备份：看得见有哪些份，才谈得上"恢复到某一份"或"用它回滚" -->
                                <TextBlock x:Name="BackupsHeaderText"
                                           Style="{StaticResource SettingRowText}" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasBackups, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:BackupRow">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind NameText}" Style="{StaticResource MutedText}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <!-- 「删除」与「恢复这份」并排：清理旧件这件事以前只能开资源管理器
                                                     去目录里挑文件，而目录里几十个同类文件名长得一样——看得见列表却删不掉，
                                                     等于把"腾地方/清掉误操作那一份"留成手工活。删除必先确认。 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="{x:Bind RestoreLabel, Mode=OneWay}" Tag="{x:Bind File}"
                                                            Click="RestoreBackup_Click"
                                                            Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                                    <Button Tag="{x:Bind File}"
                                                            Click="DeleteBackup_Click"
                                                            i18n:LocText.Key="dialog.delete"
                                                            i18n:LocText.ToolTipKey="settings.data.deleteTip"
                                                            Style="{StaticResource SecondaryButton}" Padding="10,2,10,2"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock i18n:LocText.Key="settings.data.noBackups"
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.HasBackups, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                                <TextBlock x:Name="BackupStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 剪贴板历史（默认关：这是敏感度最高的本地数据） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.data.clipboardTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.data.clipboardNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.ClipboardHistoryEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="ClipboardHistoryStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <!--
                                    图片采集：独立开关、默认关。下面这句是决议 §3-Q3 的原话，刻意不软化——
                                    文本能扫掉卡号/私钥/令牌，图片扫不了（要扫就得在采集路径上跑 OCR，那是 §7 明令不做的事）。
                                    所以"开不开"必须由用户自己点，且点之前得看见这句代价。
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.data.clipboardImageNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.ClipboardImageEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock x:Name="ClipboardImageStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.data.imageMax"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   i18n:LocText.Key="settings.data.imageMaxNote"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1" Width="128" VerticalAlignment="Center" FontSize="12"
                                               Minimum="10" Maximum="2000" SmallChange="10" LargeChange="50"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind ViewModel.ClipboardImageMaxValue, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.data.textMax"/>
                                        <TextBlock Style="{StaticResource SettingRowText}" TextWrapping="Wrap"
                                                   i18n:LocText.Key="settings.data.textMaxNote"/>
                                    </StackPanel>
                                    <NumberBox Grid.Column="1" Width="128" VerticalAlignment="Center" FontSize="12"
                                               Minimum="10" Maximum="10000" SmallChange="50" LargeChange="100"
                                               SpinButtonPlacementMode="Compact"
                                               Value="{x:Bind ViewModel.ClipboardTextMaxValue, Mode=TwoWay}"/>
                                </Grid>

                                <!--
                                    占用统计只在进这一页时算一次（不在每次复制时算），并给一颗就地重算的按钮：
                                    数字是"要不要把上限调高"这个决定的唯一依据，看不见就等于把选择权给出去又收回来。
                                    图片目录对用户直接可见（决议 §3-Q6），所以路径也一并写出来，不藏。
                                -->
                                <TextBlock x:Name="ClipboardUsageText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                <Button i18n:LocText.Key="settings.data.recount" Command="{x:Bind ViewModel.RefreshClipboardUsageCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                                <!-- §3-Q6 的第二类（图有行无）：只数不删，但必须给得出出口。
                                     没有东西可清时它是灰的，而上面那行"另有 N 个文件不在历史里"就是灰/亮的理由；
                                     按下去先列名单再删（决议明写"不静默删用户目录"）。 -->
                                <Button Command="{x:Bind ViewModel.CleanClipboardAssetsCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanCleanClipboardAssets, Mode=OneWay}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        i18n:LocText.Key="settings.data.cleanOrphans"
                                        i18n:LocText.ToolTipKey="settings.data.cleanOrphansTip"/>
                                <TextBlock x:Name="ClipboardCleanupStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- ============ 健康 + 诊断（合并：两项内容都不多，放同一页两列） ============ -->
            <TabViewItem x:Name="TabHealth" Tag="health" i18n:LocText.Key="settings.tab.health">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,12">
                    <controls:ColumnFlowPanel MinColumnWidth="440" MaxColumns="2" ColumnSpacing="14" RowSpacing="12">

                        <!-- 护眼 / 休息提醒（从「常规」挪来：这一页管"身体 + 体检"，常规页只留日常项） -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.health.eyeRestTitle" Style="{StaticResource SettingTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.health.eyeRestNote"/>
                                    <ToggleSwitch Grid.Column="1" i18n:LocText.OnContentKey="toggle.on" i18n:LocText.OffContentKey="toggle.off" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.EyeRestEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.health.eyeRestInterval"/>
                                        <TextBlock i18n:LocText.Key="settings.health.eyeRestIntervalNote" Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                                              ItemsSource="{x:Bind ViewModel.EyeRestIntervalOptions, Mode=OneTime}"
                                              ItemTemplate="{StaticResource LocOptionTemplate}"
                                              SelectedIndex="{x:Bind ViewModel.EyeRestIntervalIndex, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock i18n:LocText.Key="settings.health.eyeRestNotice"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="250" MaxWidth="320" VerticalAlignment="Center" HorizontalAlignment="Right"
                                              ItemsSource="{x:Bind ViewModel.EyeRestNoticeOptions, Mode=OneTime}"
                                              ItemTemplate="{StaticResource LocOptionTemplate}"
                                              SelectedIndex="{x:Bind ViewModel.EyeRestNoticeIndex, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Style="{StaticResource SettingRowText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               i18n:LocText.Key="settings.health.deferFullscreen"/>
                                    <ToggleSwitch Grid.Column="1" MinWidth="0"
                                                  i18n:LocText.OnContentKey="settings.health.deferOn"
                                                  i18n:LocText.OffContentKey="settings.health.deferOff"
                                                  IsOn="{x:Bind ViewModel.EyeRestDeferOnFullscreen, Mode=TwoWay}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Button Grid.Column="0" i18n:LocText.Key="settings.health.eyeRestPreview"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{x:Bind ViewModel.PreviewEyeRestCommand}"/>
                                    <!-- 演完必须有回执："按了没反应"与"演过了但没看见"在用户侧长得一样 -->
                                    <!-- 这一行是 VM 算出来的话：交回的是「键＋读数」，由 code-behind 过一次
                                         LocText.SetMessage 那颗门（⛔ 不再 Text="{x:Bind …}"——绑成品串就等于
                                         把语言钉在 VM 算出它的那一刻，换语言没人回来重算＝坑表 #276 那一族） -->
                                    <TextBlock Grid.Column="1" x:Name="EyeRestPreviewText" VerticalAlignment="Center"
                                               Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                                </Grid>
                                <!-- 两处入口要互相认账（批次 WC-3）：这里说清"时钟组件上也能开关"，
                                     否则用户在组件上改了间隔，回到这页会以为这里才是真值。 -->
                                <TextBlock i18n:LocText.Key="settings.health.eyeRestClockHint"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap" Opacity="0.62" FontSize="12"/>
                                <TextBlock x:Name="EyeRestStatusText"
                                           Style="{StaticResource SettingRowText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock i18n:LocText.Key="settings.health.scoreTitle" Style="{StaticResource SettingTitle}"/>
                                <TextBlock i18n:LocText.Key="settings.health.scoreNote" Style="{StaticResource SettingRowText}"/>

                                <!-- 评分 + 扣分明细 -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}"
                                                   FontSize="44" FontWeight="Bold" Foreground="{x:Bind ViewModel.ScoreBrush, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ScoreGradeText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Center" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.ScoreSummary, Mode=OneWay}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                        <!-- 扣分行整句由 VM 在重算时按键组装（WI-33：外壳/因子/明细全在表里）；
                                             旧七段 Run 排法把一句话劈成标记串，正是组合句一族登记的形状。 -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.DeductionLines, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <!-- 趋势图与统计摘要并排（原来上下堆叠，右侧空一大块） -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock i18n:LocText.Key="settings.health.trend" Style="{StaticResource MutedText}" FontSize="12"/>
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.TrendBars, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="3"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:HealthTrendBar">
                                                    <StackPanel Width="26" VerticalAlignment="Bottom" Spacing="2">
                                                        <Rectangle Height="{x:Bind Height}" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                                   MinHeight="1" RadiusX="2" RadiusY="2" HorizontalAlignment="Stretch"/>
                                                        <TextBlock Text="{x:Bind DateLabel}" FontSize="9" HorizontalAlignment="Center"
                                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="{x:Bind ViewModel.LanguageLine, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="{x:Bind ViewModel.DomainsLine, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="{x:Bind ViewModel.DuplicateLine, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SettingRowText}">
                                            <Run Text="{x:Bind ViewModel.TagLine, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsHealthLoading, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsHealthLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{x:Bind ViewModel.HealthError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12"
                                           Visibility="{x:Bind ViewModel.HasHealthError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock i18n:LocText.Key="settings.health.diagnosticsTitle" Style="{StaticResource SettingTitle}"/>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DiagnosticEntries, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <!-- 绑的是 UI 侧那一格（已按贴上去那一刻的语言取过词），⛔ 直接绑 Core 那颗存键的记录：
                                             屏幕上这一列要的是一串字，取词的时机由 ViewModel.PaintDiagnostics 一处守着（批次 WI-57）。 -->
                                        <DataTemplate x:DataType="viewModels:DiagnosticRow">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedText}"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Text="{x:Bind ViewModel.DiagnosticsError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12"
                                           Visibility="{x:Bind ViewModel.HasDiagnosticsError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </controls:ColumnFlowPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

    </Grid>
</Page>
