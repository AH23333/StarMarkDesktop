<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StarMark.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:StarMark.UI.Helpers"
    xmlns:viewModels="using:StarMark.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Page.Resources>

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Padding="24,20,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="8">

            <TextBlock Text="设置" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,12"/>

            <!-- 主题 -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="主题" Style="{StaticResource SettingTitle}"/>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="200">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="浅色"/>
                        <ComboBoxItem Content="深色"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 托盘与热键 -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock Text="托盘与呼出" Style="{StaticResource SettingTitle}"/>
                    <ToggleSwitch Header="常驻系统托盘" OnContent="开启" OffContent="关闭"
                                  IsOn="{x:Bind ViewModel.EnableTray, Mode=TwoWay}"/>
                    <ToggleSwitch Header="全局热键呼出（Ctrl+Alt+Space）" OnContent="开启" OffContent="关闭"
                                  IsOn="{x:Bind ViewModel.EnableGlobalHotKey, Mode=TwoWay}"/>
                    <ToggleSwitch Header="关闭窗口时最小化到托盘" OnContent="开启 (常驻)" OffContent="关闭 (直接退出)"
                                  IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- GitHub -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="GitHub Stars 同步" Style="{StaticResource SettingTitle}"/>
                    <TextBlock Text="Personal Access Token（可选，仅需 public_repo 只读范围）" Style="{StaticResource MutedText}"/>
                    <TextBox PlaceholderText="ghp_..." Text="{x:Bind ViewModel.GithubToken, Mode=TwoWay}"/>
                    <TextBlock Text="用户名（可选，用于显示）" Style="{StaticResource MutedText}"/>
                    <TextBox PlaceholderText="octocat" Text="{x:Bind ViewModel.GithubUsername, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button Content="保存设置" Style="{StaticResource SecondaryButton}"
                        Click="Save_Click"/>
                <Button Content="返回" Click="Back_Click" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.SaveErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       FontSize="12" Visibility="{x:Bind ViewModel.HasSaveError, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="提示：托盘/热键与 GitHub 配置在下次启动后生效；主题立即生效。" Style="{StaticResource MutedText}"/>
        </StackPanel>
    </ScrollViewer>
</Page>