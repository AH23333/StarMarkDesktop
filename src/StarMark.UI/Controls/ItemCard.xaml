<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Controls.ItemCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <Border.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="False"/>
            </TransitionCollection>
        </Border.Transitions>
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="{x:Bind ViewModel.OpenMenuText, Mode=OneWay}" Click="Menu_Open"/>
                <MenuFlyoutItem Text="打开所在位置" Click="Menu_OpenLocation"
                                Visibility="{x:Bind ViewModel.HasOpenLocation, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Text="{x:Bind ViewModel.CopyMenuText, Mode=OneWay}" Click="Menu_CopyLink"/>
                <!-- 「复制图片」交位图数据（粘出来是一张图），上面那颗交的是一串文字：两件事都要能一眼选出来。
                     判据与组件行右键同源（ItemCardPolicy.CanCopyAsImage）。 -->
                <MenuFlyoutItem Text="复制图片" Click="Menu_CopyImage"
                                Visibility="{x:Bind ViewModel.CanCopyAsImage, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <!-- 「贴到桌面」（ClipIMG-P3）：同一颗判据、不经剪贴板的那条出口。与组件行右键同源。
                     缺文件的那些行灰着、并把原因写在标题上（灰项自己在标题上说原因，全程序口径）：
                     这一张的像素已经拿不到了，点下去只会得到一个错误框。 -->
                <MenuFlyoutItem Text="{x:Bind ViewModel.PinImageMenuText, Mode=OneWay}"
                                Click="Menu_PinToDesktop"
                                IsEnabled="{x:Bind ViewModel.CanPinAsImage, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CanCopyAsImage, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <!-- RSS 候选不给预览（用户裁决：点条目直接跳文章，正文解析暂不做）；判据与操作栏那颗按钮同一个属性 -->
                <MenuFlyoutItem Text="预览" Click="Preview_Click"
                                Visibility="{x:Bind ViewModel.ShowsPreview, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <!-- 热榜候选专属：⭐Star 与 🔖收进收藏（两者落点不同——远端 vs 本机书签，tooltip 已写明）。
                     库管理类动作对这类行一律不出现（ItemCardPolicy 判定）：它们会经"按需登记"把外部候选写进 items。 -->
                <MenuFlyoutItem Text="{x:Bind ViewModel.StarLabel, Mode=OneWay}" Click="Menu_Star_Click"
                                Visibility="{x:Bind ViewModel.IsTrendingRepo, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <!-- 收藏这一位两类候选共用（热榜＝本机书签，RSS＝收藏进"RSS订阅 / 源名"），文案与 tooltip 按种类分流 -->
                <MenuFlyoutItem Text="{x:Bind ViewModel.CollectLabel, Mode=OneWay}" Click="Menu_Collect_Click"
                                Visibility="{x:Bind ViewModel.ShowsCollect, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Text="删除" Click="Delete_Click"
                                Visibility="{x:Bind ViewModel.IsLauncherMode, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Text="{x:Bind ViewModel.DeleteMenuText, Mode=OneWay}" Click="DeleteClipboard_Click"
                                Visibility="{x:Bind ViewModel.CanDeletePermanently, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Click="Pin_Click"
                                Text="{x:Bind ViewModel.PinMenuText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Text="发送到桌面 · 快捷启动" Click="SendToWidget_Click"
                                Visibility="{x:Bind ViewModel.CanSendToWidget, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Text="编辑笔记" Click="EditNote_Click"
                                Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Text="编辑标签" Click="EditTags_Click"
                                Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <MenuFlyoutItem Click="Hide_Click"
                                Text="{x:Bind ViewModel.HideMenuText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </MenuFlyout>
        </Border.ContextFlyout>
        <Grid>
        <StackPanel>
            <!-- 标题行 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{x:Bind ViewModel.SourceIcon, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="📌" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                           ToolTipService.ToolTip="已置顶"
                           Visibility="{x:Bind ViewModel.IsPinned, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <!-- 标题走 Inlines 以支持搜索命中高亮（Segments 为空时退化为单段普通文本） -->
                <TextBlock Margin="7,0,0,0"
                           FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Tapped="Title_Tapped"
                           local:HighlightHelper.Segments="{x:Bind ViewModel.TitleSegments, Mode=OneWay}"
                           ToolTipService.ToolTip="{x:Bind ViewModel.Uri, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ViewModel.SizeText, Mode=OneWay}" Margin="8,0,0,0"
                           FontSize="11" Style="{StaticResource MutedText}"
                           ToolTipService.ToolTip="文件大小"
                           Visibility="{x:Bind ViewModel.HasSizeText, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{x:Bind ViewModel.RelativeTime, Mode=OneWay}" Margin="8,0,0,0"
                           FontSize="11" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <!--
                剪贴板图片行的小图（ClipIMG-2a）。放在标题之下、副标题之上：尺寸/来源那行才是这条历史
                的主信息，图是它的证据。ImageSource 在卡片 VM 构造时建好一次（优先 160px 缩略图，
                缩略图缺了才回退主图并按 160 解码）——绑定的代价不该出现在滚动路径上。
            -->
            <Border Margin="0,2,0,0" CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.HasClipboardThumb, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Image Source="{x:Bind ViewModel.ClipboardThumb, Mode=OneWay}"
                       Width="160" Height="120" Stretch="Uniform"/>
            </Border>
            <!-- 图不在了必须说这一格：空着不解释，看起来像程序坏了，而不是"文件被删了但条目还在"。
                句子从 ViewModel 来（全程序那半句事实只有一个出处，见 ClipboardPolicy.MissingFileClause）。 -->
            <Border Margin="0,2,0,0" Padding="8,6" CornerRadius="4" HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.ClipboardImageMissing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Bind ViewModel.ClipboardImageMissingText, Mode=OneWay}"
                           FontSize="11" Style="{StaticResource MutedText}"/>
            </Border>

            <!-- 副标题 -->
            <TextBlock FontSize="11"
                       Style="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis"
                       local:HighlightHelper.Segments="{x:Bind ViewModel.SubtitleSegments, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 描述 -->
            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap" MaxHeight="40"
                       Margin="0,2,0,0"
                       Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 标签行：点击标签查看该标签条目 ＋ ✕ 快速移除 ＋ 快速添加 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="4"
                        Visibility="{x:Bind SuppressTags, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <!-- ItemsRepeater 不设置 DataContext，{Binding} 会解析到卡片 VM
                                         导致 Tag 永远不是 string、点击筛选/移除全部失效；必须用 x:Bind -->
                                    <Button Click="Tag_Chip_Click"
                                            Tag="{x:Bind}"
                                            Padding="6,1" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="查看该标签的全部条目">
                                        <TextBlock Text="{x:Bind}" FontSize="11"
                                                   Foreground="{x:Bind Converter={StaticResource ContainedTagColor}}"/>
                                    </Button>
                                    <Button Click="Tag_Remove_Click"
                                            Tag="{x:Bind}"
                                            Padding="3,1" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="移除标签">
                                        <TextBlock Text="✕" FontSize="8" Opacity="0.5"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Button Click="Tag_Add_Click" Padding="4,1" CornerRadius="10"
                        ToolTipService.ToolTip="添加标签"
                        Background="Transparent"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="＋ 标签" FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </StackPanel>

            <!-- Stars 数 -->
            <TextBlock Text="{x:Bind ViewModel.StarsText, Mode=OneWay}" FontSize="11"
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasStars, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 笔记行 -->
            <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" FontSize="11"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 操作栏：预览 / 笔记 / 标签 / 置顶 / 复制 / 隐藏 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0" Spacing="4">
                <Button Content="🔎" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="预览（QuickLook）" Click="Preview_Click"
                        Visibility="{x:Bind ViewModel.ShowsPreview, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <Button Content="📝" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="编辑笔记" Click="EditNote_Click"
                        Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <Button Content="🏷" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="编辑标签" Click="EditTags_Click"
                        Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <Button Content="📌" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="置顶（浏览视图排最前）" Click="Pin_Click"
                        Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <Button Content="⧉" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CopyMenuText, Mode=OneWay}" Click="Menu_CopyLink"/>
                <!-- 热榜行的两个图标动作（其余条目不出现）：文字/图标随状态翻转，"已 Star"再点即取消 -->
                <Button Content="{x:Bind ViewModel.StarGlyph, Mode=OneWay}" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StarTip, Mode=OneWay}" Click="Star_Click"
                        Visibility="{x:Bind ViewModel.IsTrendingRepo, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <Button Content="🔖" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CollectTip, Mode=OneWay}" Click="Collect_Click"
                        Visibility="{x:Bind ViewModel.ShowsCollect, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                <Button Content="👁" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="隐藏" Click="Hide_Click"
                        Visibility="{x:Bind ViewModel.ShowsLibraryActions, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>

        <!-- 键盘导航选中指示条（↑↓ 选择时显示在卡片左缘） -->
        <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                CornerRadius="2,0,0,2"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.IsKeyboardSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>