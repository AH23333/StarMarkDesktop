<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Controls.ItemCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <Border.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="False"/>
            </TransitionCollection>
        </Border.Transitions>
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="打开" Click="Menu_Open"/>
                <MenuFlyoutItem Text="预览" Click="Preview_Click"/>
                <MenuFlyoutItem Text="编辑笔记" Click="EditNote_Click"/>
                <MenuFlyoutItem Text="编辑标签" Click="EditTags_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Click="Hide_Click"
                                Text="{x:Bind ViewModel.HideMenuText, Mode=OneWay}"/>
            </MenuFlyout>
        </Border.ContextFlyout>
        <StackPanel>
            <!-- 标题行 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{x:Bind ViewModel.SourceIcon, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Margin="7,0,0,0"
                           FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Tapped="Title_Tapped"
                           ToolTipService.ToolTip="{Binding Uri}"/>
                <TextBlock Text="{x:Bind ViewModel.RelativeTime, Mode=OneWay}" Margin="8,0,0,0"
                           FontSize="11" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- 副标题 -->
            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="11"
                       Style="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 描述 -->
            <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap" MaxHeight="40"
                       Margin="0,2,0,0"
                       Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 标签行：点击芯片快速移除 ＋ 快速添加 -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="4">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Click="Tag_Chip_Click"
                                    Tag="{Binding}"
                                    Padding="6,1" CornerRadius="10"
                                    Background="{StaticResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding}" FontSize="11"
                                               Foreground="{Binding Converter={StaticResource ContainedTagColor}}"/>
                                    <TextBlock Text="✕" FontSize="8" Opacity="0.5"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Button Click="Tag_Add_Click" Padding="4,1" CornerRadius="10"
                        ToolTipService.ToolTip="添加标签"
                        Background="Transparent"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="＋ 标签" FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </StackPanel>

            <!-- Stars 数 -->
            <TextBlock Text="{x:Bind ViewModel.StarsText, Mode=OneWay}" FontSize="11"
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasStars, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 笔记行 -->
            <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" FontSize="11"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

            <!-- 操作栏：预览 / 笔记 / 标签 / 隐藏 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0" Spacing="4">
                <Button Content="🔎" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="预览（QuickLook）" Click="Preview_Click"/>
                <Button Content="📝" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="编辑笔记" Click="EditNote_Click"/>
                <Button Content="🏷" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="编辑标签" Click="EditTags_Click"/>
                <Button Content="👁" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="隐藏" Click="Hide_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>