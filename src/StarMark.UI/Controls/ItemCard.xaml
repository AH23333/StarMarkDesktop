<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Controls.ItemCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:StarMark.UI.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <!-- 标题行：来源 badge + 标题 + 右键菜单 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{x:Bind ViewModel.SourceIcon}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind ViewModel.Title}" Margin="7,0,0,0"
                           FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Tapped="Title_Tapped"
                           ToolTipService.ToolTip="{Binding Uri}"/>
                <TextBlock Text="{x:Bind ViewModel.RelativeTime}" Margin="8,0,0,0"
                           FontSize="11" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- 副标题 -->
            <TextBlock Text="{x:Bind ViewModel.Subtitle}" FontSize="11"
                       Style="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind ViewModel.HasSubtitle, Converter={StaticResource BoolToVis}}"/>

            <!-- 描述 -->
            <TextBlock Text="{x:Bind ViewModel.Description}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap" MaxHeight="40"
                       Margin="0,2,0,0"
                       Visibility="{x:Bind ViewModel.HasDescription, Converter={StaticResource BoolToVis}}"/>

            <!-- 标签行（可点击筛选/跳转） -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags}" Margin="0,4,0,0">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Content="{Binding}" Background="Transparent" BorderThickness="0"
                                Padding="6,1" Margin="0,0,4,0" FontSize="11"
                                Foreground="{Binding Converter={StaticResource ContainedTagColor}}"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Stars 数 -->
            <TextBlock Text="{x:Bind ViewModel.StarsText}" FontSize="11"
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasStars, Converter={StaticResource BoolToVis}}"/>

            <!-- 笔记行 -->
            <TextBlock Text="{x:Bind ViewModel.Notes}" FontSize="11"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasNotes, Converter={StaticResource BoolToVis}}"/>

            <!-- 操作栏：编辑标签 / 编辑笔记 / 隐藏 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0" Spacing="4">
                <Button Content="📝" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="编辑笔记" Click="EditNote_Click"/>
                <Button Content="🏷" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="编辑标签" Click="EditTags_Click"/>
                <Button Content="👁" Padding="4,2" Style="{StaticResource MiniIconButton}"
                        ToolTipService.ToolTip="隐藏" Click="Hide_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>