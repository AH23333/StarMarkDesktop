<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="StarMark.UI.Controls.PreviewHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="420" MaxWidth="560" MinHeight="260" MaxHeight="520">

    <Grid>
        <!-- 文本 / 代码预览 -->
        <ScrollViewer x:Name="TextScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="TextPreview" FontSize="13"
                       FontFamily="Consolas"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap" Padding="4"/>
        </ScrollViewer>

        <!-- 图片 / PDF 预览 -->
        <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="ImagePreview" Stretch="Uniform"/>
        </ScrollViewer>

        <!-- 链接 / 不可预览 -->
        <StackPanel x:Name="FallbackPanel" Visibility="Collapsed" VerticalAlignment="Top" Spacing="10">
            <TextBlock x:Name="FallbackTitle" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="FallbackDetail" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <Button x:Name="OpenButton" Click="Open_Click" Content="在浏览器中打开"/>
        </StackPanel>

        <!-- 加载状态 -->
        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>